// 项目内限流器（ipRateLimiter）的单元测试。
//
// 这些测试全部用注入的假时钟推进时间，不 sleep：令牌回补和记录回收都是
// 时间驱动的，用真实时间测要么很慢，要么在 CI 上偶发失败。
//
// 要守住的不变量：
//  1. 基本放行/拒绝，单 IP 之间互不连坐；
//  2. 令牌按时间回补，且回补的取整方式与被替换的公共库实现一致（不能变松）；
//  3. 全局桶是独立的第二道闸，且**可以不启用**（后台限流只按 IP）；
//  4. 闲置且已回满的记录会被回收 —— 这是这次改动的目的；
//  5. **没回满的记录绝不回收** —— 回收它等于给正在被限流的 IP 清零欠账；
//  6. 记录数触顶时按既定策略降级，不崩、不无限增长，且清扫开销有上限；
//  7. 超限留痕，但日志本身是节流的；
//  8. 并发访问不 race（配合 go test -race）。
package middleware

import (
	"bytes"
	"fmt"
	"log"
	"os"
	"strings"
	"sync"
	"testing"
	"time"
)

// fakeClock 可手动推进的时钟。
type fakeClock struct {
	mu sync.Mutex
	t  time.Time
}

func newFakeClock() *fakeClock {
	return &fakeClock{t: time.Date(2025, 1, 1, 0, 0, 0, 0, time.UTC)}
}

func (c *fakeClock) Now() time.Time {
	c.mu.Lock()
	defer c.mu.Unlock()
	return c.t
}

func (c *fakeClock) Advance(d time.Duration) {
	c.mu.Lock()
	defer c.mu.Unlock()
	c.t = c.t.Add(d)
}

// captureLog 把标准 log 的输出接到一个 buffer 上，测试结束后还原。
//
// log 的输出目标是**全局状态**，所以用到它的测试不能 t.Parallel()：
// 并行跑会互相抢 output，断言结果随机。
func captureLog(t *testing.T) *bytes.Buffer {
	t.Helper()
	buf := &bytes.Buffer{}
	flags := log.Flags()
	log.SetOutput(buf)
	log.SetFlags(0) // 去掉时间前缀，断言只看内容
	t.Cleanup(func() {
		log.SetOutput(os.Stderr)
		log.SetFlags(flags)
	})
	return buf
}

// newTestLimiter 造一个挂着假时钟的限流器（名字固定为 test）。
func newTestLimiter(ipCapacity, globalCapacity int, fillInterval time.Duration) (*ipRateLimiter, *fakeClock) {
	return newNamedTestLimiter("test", ipCapacity, globalCapacity, fillInterval)
}

// newNamedTestLimiter 同上，但可以指定限流器名字（日志断言要用）。
// globalCapacity <= 0 时不建全局桶（后台限流就是这种形态），所以那一段要判空。
func newNamedTestLimiter(name string, ipCapacity, globalCapacity int, fillInterval time.Duration) (*ipRateLimiter, *fakeClock) {
	clock := newFakeClock()
	l := newIPRateLimiter(name, ipCapacity, globalCapacity, fillInterval)
	l.now = clock.Now
	l.lastSweep = clock.Now()
	// 全局桶和 per-IP 桶的时间基准也要挪到假时钟上，
	// 否则真实时间与假时间的差值会被当成「已经过了很久」。
	if l.global != nil {
		l.global.lastFill = clock.Now()
		l.global.lastSeen = clock.Now()
	}
	return l, clock
}

func TestIPRateLimiter_AllowsUpToCapacityThenDenies(t *testing.T) {
	const capacity = 3
	l, _ := newTestLimiter(capacity, 1000, time.Minute)

	for i := 0; i < capacity; i++ {
		if res := l.Allow("203.0.113.10"); !res.Allowed {
			t.Fatalf("第 %d 次请求应放行，实际被拒（原因 %s）", i+1, res.Reason)
		}
	}
	res := l.Allow("203.0.113.10")
	if res.Allowed {
		t.Fatal("超出单 IP 容量后应被拒")
	}
	if res.Reason != reasonIP {
		t.Errorf("拒绝原因应为 %q，实际 %q", reasonIP, res.Reason)
	}
}

func TestIPRateLimiter_SeparateIPsDoNotShareBudget(t *testing.T) {
	l, _ := newTestLimiter(1, 1000, time.Minute)

	if !l.Allow("203.0.113.10").Allowed {
		t.Fatal("第一个 IP 的首次请求应放行")
	}
	if l.Allow("203.0.113.10").Allowed {
		t.Fatal("第一个 IP 超额后应被拒")
	}
	if !l.Allow("203.0.113.11").Allowed {
		t.Error("另一个 IP 不该被连坐")
	}
}

// TestIPRateLimiter_RefillsOverTime 令牌按时间回补，且保留原实现的取整语义：
// 不足一个填充间隔的零头不补，也不攒着。放松这个取整就是放松限流。
func TestIPRateLimiter_RefillsOverTime(t *testing.T) {
	const fill = 10 * time.Second
	l, clock := newTestLimiter(2, 1000, fill)

	l.Allow("203.0.113.10")
	l.Allow("203.0.113.10")
	if l.Allow("203.0.113.10").Allowed {
		t.Fatal("配额用尽后应被拒")
	}

	// 不足一个填充间隔：不回令牌
	clock.Advance(fill - time.Second)
	if l.Allow("203.0.113.10").Allowed {
		t.Fatal("不足一个填充间隔就回了令牌，限流被放松了")
	}

	// 跨过一个完整间隔：回一个令牌（从上次真正回补的时间点算起）
	clock.Advance(fill)
	if !l.Allow("203.0.113.10").Allowed {
		t.Fatal("过了一个填充间隔应回一个令牌")
	}
	if l.Allow("203.0.113.10").Allowed {
		t.Fatal("一个间隔只该回一个令牌")
	}

	// 回补不会超过容量
	clock.Advance(100 * fill)
	for i := 0; i < 2; i++ {
		if !l.Allow("203.0.113.10").Allowed {
			t.Fatalf("长时间空闲后应恢复到满容量，第 %d 次就被拒了", i+1)
		}
	}
	if l.Allow("203.0.113.10").Allowed {
		t.Error("回补溢出了容量上限")
	}
}

// TestIPRateLimiter_GlobalBucketLimitsAcrossIPs 全局桶是独立的第二道闸：
// 每个 IP 都没超自己的配额，总量仍然会被卡住。
func TestIPRateLimiter_GlobalBucketLimitsAcrossIPs(t *testing.T) {
	const globalCapacity = 5
	l, _ := newTestLimiter(100, globalCapacity, time.Minute)

	for i := 0; i < globalCapacity; i++ {
		ip := fmt.Sprintf("203.0.113.%d", i)
		if res := l.Allow(ip); !res.Allowed {
			t.Fatalf("第 %d 个 IP 的首次请求应放行（原因 %s）", i+1, res.Reason)
		}
	}
	res := l.Allow("203.0.113.200")
	if res.Allowed {
		t.Fatal("全局桶耗尽后应被拒，即使这个 IP 自己的配额还够")
	}
	if res.Reason != reasonGlobal {
		t.Errorf("拒绝原因应为 %q，实际 %q", reasonGlobal, res.Reason)
	}
}

// TestIPRateLimiter_GlobalRejectionStillSpendsIPToken 固定住一条继承来的语义：
// 全局桶不足时，单 IP 的令牌已经被扣掉了。
//
// 这不是本次改动引入的行为，是被替换实现（tlimit.CompositeRateLimiter）就有的；
// 这里用测试把它钉住，是为了让它成为一个**有意识的选择**而不是无人察觉的副作用 ——
// 将来谁想改成「两层都够才扣」，会先看到这条测试和它的理由。
// 方向上这偏严（全局过载时单 IP 配额消耗更快），所以保留是安全的。
func TestIPRateLimiter_GlobalRejectionStillSpendsIPToken(t *testing.T) {
	// 全局只有 1 个令牌，单 IP 有 5 个
	l, _ := newTestLimiter(5, 1, time.Hour)

	if !l.Allow("203.0.113.10").Allowed {
		t.Fatal("首次请求应放行")
	}
	// 全局已空：后面两次都会被全局拦下，但单 IP 的令牌照样在扣
	for i := 0; i < 2; i++ {
		if res := l.Allow("203.0.113.10"); res.Allowed || res.Reason != reasonGlobal {
			t.Fatalf("第 %d 次应被全局桶拒绝，实际 %+v", i+2, res)
		}
	}

	l.mu.Lock()
	tokens := l.buckets["203.0.113.10"].tokens
	l.mu.Unlock()
	// 5 - 3 = 2：三次请求都扣了单 IP 令牌，哪怕后两次被全局拦下
	if tokens != 2 {
		t.Errorf("单 IP 桶应剩 2 个令牌（继承原实现：全局拒绝时 IP 令牌照扣），实际 %d", tokens)
	}
}

// TestIPRateLimiter_EvictsIdleFullBuckets 这次改动的目的：闲置且已回满的记录会被丢掉，
// map 不再只增不减。
func TestIPRateLimiter_EvictsIdleFullBuckets(t *testing.T) {
	l, clock := newTestLimiter(2, 100000, time.Second)

	for i := 0; i < 50; i++ {
		l.Allow(fmt.Sprintf("203.0.113.%d", i))
	}
	if got := l.trackedIPs(); got != 50 {
		t.Fatalf("应保留 50 条记录，实际 %d", got)
	}

	// 推进到「桶已回满」且「闲置超过 TTL」之后，下一次请求触发清扫
	clock.Advance(rateLimitIdleTTL + rateLimitSweepInterval)
	l.Allow("198.51.100.1")

	// 旧的 50 条应被回收，只剩刚访问的这条
	if got := l.trackedIPs(); got != 1 {
		t.Errorf("闲置且回满的记录应被回收，期望剩 1 条，实际 %d 条", got)
	}
}

// TestIPRateLimiter_KeepsBucketsThatAreStillDepleted 最关键的一条：
// 没回满的记录绝不能被回收。
//
// 回收一个正在被限流的 IP 的记录，等于把它的欠账清零 —— 攻击者只要停够一个
// 清扫周期就能重置配额，口令爆破的速率上限随之失效。
func TestIPRateLimiter_KeepsBucketsThatAreStillDepleted(t *testing.T) {
	// 填充间隔很长：桶耗尽后在测试时间尺度内回不满
	l, clock := newTestLimiter(2, 100000, 24*time.Hour)

	const attacker = "203.0.113.66"
	l.Allow(attacker)
	l.Allow(attacker)
	if l.Allow(attacker).Allowed {
		t.Fatal("配额应已耗尽")
	}

	// 闲置足够久，足以触发清扫，但桶远没回满
	clock.Advance(rateLimitIdleTTL + rateLimitSweepInterval)
	// 另一个 IP 的请求触发清扫
	l.Allow("198.51.100.1")

	l.mu.Lock()
	_, stillTracked := l.buckets[attacker]
	l.mu.Unlock()
	if !stillTracked {
		t.Fatal("没回满的记录被回收了：被限流的 IP 只要停一会儿就能重置配额")
	}
	if l.Allow(attacker).Allowed {
		t.Error("被限流的 IP 在清扫之后拿回了配额，限流被绕过")
	}
}

// TestIPRateLimiter_SweepIsThrottled 清扫是 O(记录数) 的全表扫描，不能每个请求都做。
// 这里让记录「够格被回收」但让上次清扫时间很近，验证清扫确实被间隔挡住了。
func TestIPRateLimiter_SweepIsThrottled(t *testing.T) {
	l, clock := newTestLimiter(2, 100000, time.Second)

	for i := 0; i < 20; i++ {
		l.Allow(fmt.Sprintf("203.0.113.%d", i))
	}

	// 时间推过 TTL：这 20 条记录已经「够格」被回收（闲置且会回满）
	clock.Advance(rateLimitIdleTTL)
	// 但假设刚刚才清扫过
	l.mu.Lock()
	l.lastSweep = clock.Now()
	l.mu.Unlock()

	before := l.trackedIPs()
	clock.Advance(rateLimitSweepInterval - time.Second)
	l.Allow("198.51.100.1")
	if got := l.trackedIPs(); got != before+1 {
		t.Errorf("距上次清扫不足 %v 时不该清扫，期望 %d 条，实际 %d 条", rateLimitSweepInterval, before+1, got)
	}

	// 再越过清扫间隔，这批记录就该被回收了
	clock.Advance(2 * time.Second)
	l.Allow("198.51.100.2")
	if got := l.trackedIPs(); got != 2 {
		t.Errorf("越过清扫间隔后应回收旧记录，期望剩 2 条（两个新来源），实际 %d 条", got)
	}
}

// TestIPRateLimiter_RespectsMaxEntries 记录数触顶时的行为：
// 不再新增记录（内存有界），新来源降级为只受全局桶约束，不崩也不拒服务。
func TestIPRateLimiter_RespectsMaxEntries(t *testing.T) {
	captureLog(t) // 触顶会打降级告警日志，别刷到测试输出里
	l, _ := newTestLimiter(1, 100000, time.Hour)
	l.maxEntries = 10 // 调小上限，避免测试里真的灌 10 万条

	for i := 0; i < l.maxEntries; i++ {
		if !l.Allow(fmt.Sprintf("203.0.113.%d", i)).Allowed {
			t.Fatalf("第 %d 个 IP 的首次请求应放行", i+1)
		}
	}
	if got := l.trackedIPs(); got != l.maxEntries {
		t.Fatalf("记录数应为上限 %d，实际 %d", l.maxEntries, got)
	}

	// 再来 100 个新 IP：记录数不得增长
	for i := 0; i < 100; i++ {
		l.Allow(fmt.Sprintf("198.51.100.%d", i))
	}
	if got := l.trackedIPs(); got > l.maxEntries {
		t.Errorf("记录数突破了上限：期望 <= %d，实际 %d", l.maxEntries, got)
	}

	// 已在表内的 IP 仍然正常受单 IP 配额约束（容量 1，已用过一次）
	if l.Allow("203.0.113.0").Allowed {
		t.Error("表内已有的 IP 应继续受单 IP 配额约束")
	}

	// 新来源降级为只受全局桶约束：全局桶还有令牌，所以放行
	if !l.Allow("198.51.100.200").Allowed {
		t.Error("触顶后的新来源应降级为只走全局桶（全局还有令牌时放行），而不是直接拒服务")
	}
}

// TestIPRateLimiter_OverflowStillBoundedByGlobalBucket 触顶降级之后，
// 总吞吐仍然被全局桶卡住 —— 这是降级策略能成立的前提。
func TestIPRateLimiter_OverflowStillBoundedByGlobalBucket(t *testing.T) {
	captureLog(t)
	const globalCapacity = 3
	l, _ := newTestLimiter(1, globalCapacity, time.Hour)
	l.maxEntries = 1

	// 先把唯一的记录位占掉，并消耗 1 个全局令牌
	if !l.Allow("203.0.113.1").Allowed {
		t.Fatal("首个 IP 应放行")
	}

	allowed := 0
	for i := 0; i < 50; i++ {
		if l.Allow(fmt.Sprintf("198.51.100.%d", i)).Allowed {
			allowed++
		}
	}
	// 全局桶一共 3 个令牌，已用掉 1 个，剩下最多再放 2 个
	if allowed != globalCapacity-1 {
		t.Errorf("触顶降级后仍应被全局桶卡住：期望再放行 %d 次，实际 %d 次", globalCapacity-1, allowed)
	}
}

// TestIPRateLimiter_NoGlobalBucketWhenCapacityNotPositive globalCapacity <= 0
// 表示不建全局桶。后台接口限流靠的就是这个形态，所以它必须是显式契约，
// 不能靠「传了个大数当作无限」糊过去。
func TestIPRateLimiter_NoGlobalBucketWhenCapacityNotPositive(t *testing.T) {
	for _, capacity := range []int{0, -1} {
		l, _ := newTestLimiter(10, capacity, time.Second)
		if l.global != nil {
			t.Errorf("globalCapacity=%d 时不应建全局桶", capacity)
		}
	}
}

// TestIPRateLimiter_NoGlobalLayerLetsManyIPsThrough 没有全局桶时，
// 大量不同 IP 都应放行：全站总额度被刻意去掉了，谁都不该被别人的流量连坐。
//
// 反过来说，如果哪天有人给后台限流器补上一个全局桶，这条测试会立刻失败 ——
// 那是一次策略变更（一个人能刷光全站额度），必须是有意识的决定。
func TestIPRateLimiter_NoGlobalLayerLetsManyIPsThrough(t *testing.T) {
	// 单 IP 容量只有 1，但没有全局桶
	l, _ := newTestLimiter(1, 0, time.Hour)

	const sources = 500
	for i := 0; i < sources; i++ {
		ip := fmt.Sprintf("198.51.%d.%d", i/256, i%256)
		if res := l.Allow(ip); !res.Allowed {
			t.Fatalf("第 %d 个来源应放行（没有全站总额度），实际被拒，原因 %q", i+1, res.Reason)
		}
	}
	// 每个 IP 自己的配额仍然生效
	if l.Allow("198.51.0.0").Allowed {
		t.Error("去掉全局桶不等于去掉单 IP 限流：同一个 IP 的第二次请求应被拒")
	}
}

// TestIPRateLimiter_NoGlobalLayerOverflowFailsOpen 没有全局桶时记录数触顶的行为：
// **放行**（fail open）并打节流日志，而不是拒绝新来源。
//
// 这是刻意选的那一侧，理由见 trackLocked 的注释：触顶即拒绝会把「10 万条记录
// 上限」这道内存保护变成攻击者的武器 —— 用足够多的来源 IP 把表撑满，之后
// 所有新来源（包括真实管理员）全部 429，整个后台对所有人锁死。
// 后台限流本来就没有全站总额度，就是因为「一人自伤全站」比「被刷」更糟；
// 触顶行为必须和这个取舍保持一致。
func TestIPRateLimiter_NoGlobalLayerOverflowFailsOpen(t *testing.T) {
	captureLog(t)
	l, _ := newTestLimiter(1, 0, time.Hour)
	l.maxEntries = 10 // 调小上限，避免测试里真的灌 10 万条

	for i := 0; i < l.maxEntries; i++ {
		if !l.Allow(fmt.Sprintf("203.0.113.%d", i)).Allowed {
			t.Fatalf("第 %d 个 IP 的首次请求应放行", i+1)
		}
	}
	if got := l.trackedIPs(); got != l.maxEntries {
		t.Fatalf("记录数应为上限 %d，实际 %d", l.maxEntries, got)
	}

	// 触顶之后的新来源：放行，且不再新增记录（内存仍然有界）
	for i := 0; i < 100; i++ {
		if !l.Allow(fmt.Sprintf("198.51.100.%d", i)).Allowed {
			t.Fatalf("触顶后第 %d 个新来源被拒了：内存保护不该变成拒绝服务", i+1)
		}
	}
	if got := l.trackedIPs(); got > l.maxEntries {
		t.Errorf("记录数突破了上限：期望 <= %d，实际 %d", l.maxEntries, got)
	}

	// 表内已有的 IP 仍然正常受单 IP 配额约束（容量 1，已用过一次）
	if l.Allow("203.0.113.0").Allowed {
		t.Error("表内已有的 IP 应继续受单 IP 配额约束")
	}
}

// TestIPRateLimiter_ForcedSweepIsThrottledUnderOverflow 触顶时的强制清扫必须有上限。
//
// 表满之后每个新 IP 都会试着抢一个记录位，而清扫是**锁内 O(记录数)** 的全表扫描。
// 不节流的话，「把表撑满」就能换来「每个请求都在锁内扫 10 万条」——
// 限流器自己成了瓶颈，正好是攻击者想要的结果。
func TestIPRateLimiter_ForcedSweepIsThrottledUnderOverflow(t *testing.T) {
	captureLog(t)
	l, clock := newTestLimiter(1, 0, time.Hour)
	l.maxEntries = 10 // 调小上限，避免测试里真的灌 10 万条

	// 先把表填满（这一段时间不推进，不会触发常规清扫）
	for i := 0; i < l.maxEntries; i++ {
		l.Allow(fmt.Sprintf("203.0.113.%d", i))
	}
	if got := l.sweepsDone(); got != 0 {
		t.Fatalf("填表阶段不该发生清扫，实际 %d 次", got)
	}

	// 触顶状态下连续 2000 个新来源，时间不动：强制清扫最多 1 次
	for i := 0; i < 2000; i++ {
		l.Allow(fmt.Sprintf("198.51.%d.%d", i/256, i%256))
	}
	if got := l.sweepsDone(); got > 1 {
		t.Errorf("同一个节流窗口内最多清扫 1 次，实际 %d 次（2000 个新来源 → 2000 次全表扫描？）", got)
	}

	// 时间推进时清扫可以再发生，但次数要跟着时间走、而不是跟着请求数走：
	// 一共推进 20 秒，节流窗口是 1 秒，所以上限约 20 次，而请求数是 2000。
	before := l.sweepsDone()
	for i := 0; i < 2000; i++ {
		clock.Advance(10 * time.Millisecond)
		l.Allow(fmt.Sprintf("198.51.%d.%d", 100+i/256, i%256))
	}
	if got := l.sweepsDone() - before; got > 21 {
		t.Errorf("清扫次数应受时间节流（20 秒 / 1 秒窗口 ≈ 20 次），实际 %d 次", got)
	}

	// 节流不能把「记录数有界」这条弄丢
	if got := l.trackedIPs(); got > l.maxEntries {
		t.Errorf("记录数突破了上限：期望 <= %d，实际 %d", l.maxEntries, got)
	}
}

// TestIPRateLimiter_RejectionLogIsThrottled 超限要留痕，但每个限流器每个窗口只留一条。
//
// 两个方向都要守：一条都不打 = 限流把人挡住了和接口坏了在运维那边长得一样；
// 每请求一条 = 一次被刷会把日志写成第二起故障（磁盘写满、有用日志被冲掉）。
func TestIPRateLimiter_RejectionLogIsThrottled(t *testing.T) {
	buf := captureLog(t)
	l, clock := newNamedTestLimiter("login", 1, 0, time.Hour)

	if !l.Allow("203.0.113.10").Allowed {
		t.Fatal("首次请求应放行")
	}
	// 连续 100 次被拒
	for i := 0; i < 100; i++ {
		if l.Allow("203.0.113.10").Allowed {
			t.Fatalf("第 %d 次请求应被拒（容量只有 1）", i+2)
		}
		l.noteRejection("203.0.113.10")
	}

	lines := logLines(buf)
	if len(lines) != 1 {
		t.Fatalf("同一窗口内 100 次拒绝应只打 1 条日志，实际 %d 条：\n%s", len(lines), buf.String())
	}
	// 内容要够用来定位：哪个桶、拒了多少次、最近一次来自谁
	for _, want := range []string{"login", "203.0.113.10"} {
		if !strings.Contains(lines[0], want) {
			t.Errorf("日志应包含 %q，实际: %s", want, lines[0])
		}
	}
	if !strings.Contains(lines[0], "1 次") {
		t.Errorf("第一条日志是窗口内的第一次拒绝，次数应为 1，实际: %s", lines[0])
	}

	// 跨过节流窗口：下一条汇总日志带上这一窗口攒下的次数
	clock.Advance(rateLimitRejectLogInterval)
	l.noteRejection("203.0.113.11")
	lines = logLines(buf)
	if len(lines) != 2 {
		t.Fatalf("跨过节流窗口后应再打 1 条，实际共 %d 条：\n%s", len(lines), buf.String())
	}
	if !strings.Contains(lines[1], "100 次") {
		t.Errorf("第二条日志应汇总窗口内的 100 次拒绝（99 次被节流掉的 + 这次），实际: %s", lines[1])
	}
	if !strings.Contains(lines[1], "203.0.113.11") {
		t.Errorf("日志应带最近一次被拒的来源 IP，实际: %s", lines[1])
	}
}

// TestIPRateLimiter_RetryAfterSecondsRoundsUp Retry-After 只能用整秒，
// 必须向上取整且至少 1 秒：向下取整会让守规矩的客户端在令牌还没回补时就重试，
// 白吃一个 429；0 等于「立刻重试」，对限流毫无意义。
func TestIPRateLimiter_RetryAfterSecondsRoundsUp(t *testing.T) {
	cases := []struct {
		fill time.Duration
		want int
	}{
		{100 * time.Millisecond, 1}, // 后台限流默认（per_second=10）
		{time.Second, 1},
		{1500 * time.Millisecond, 2},
		{2 * time.Second, 2},   // front_error
		{6 * time.Second, 6},   // login
		{30 * time.Second, 30}, // verify_code
		{60 * time.Second, 60}, // send_code
	}
	for _, tc := range cases {
		l, _ := newTestLimiter(1, 0, tc.fill)
		if got := l.retryAfterSeconds(); got != tc.want {
			t.Errorf("填充间隔 %v 的 Retry-After 应为 %d 秒，实际 %d", tc.fill, tc.want, got)
		}
	}
}

// logLines 把捕获到的日志切成非空行。
func logLines(buf *bytes.Buffer) []string {
	var lines []string
	for _, line := range strings.Split(buf.String(), "\n") {
		if strings.TrimSpace(line) != "" {
			lines = append(lines, line)
		}
	}
	return lines
}

// TestIPRateLimiter_ConcurrentAccess 并发安全。
// 单独跑意义有限，主要价值是在 go test -race 下暴露数据竞争。
func TestIPRateLimiter_ConcurrentAccess(t *testing.T) {
	captureLog(t) // 拒绝路径会打节流日志，别让它刷到测试输出里
	l, _ := newTestLimiter(100, 1000000, time.Millisecond)

	const (
		goroutines = 32
		perG       = 200
	)
	var wg sync.WaitGroup
	wg.Add(goroutines)
	for g := 0; g < goroutines; g++ {
		go func(g int) {
			defer wg.Done()
			for i := 0; i < perG; i++ {
				// 一半打同一个 IP（争同一个桶），一半打各自的 IP（争 map）
				ip := fmt.Sprintf("198.51.100.%d", g)
				if i%2 == 0 {
					ip = "203.0.113.1"
				}
				// 拒绝路径上的计数与节流日志也要进并发覆盖（它改的是限流器里的共享状态）
				if !l.Allow(ip).Allowed {
					l.noteRejection(ip)
				}
			}
		}(g)
	}
	wg.Wait()

	if got := l.trackedIPs(); got == 0 {
		t.Error("并发访问后记录表不该是空的")
	}
}

// TestIPRateLimiter_ConcurrentAllowAndSweep 清扫与放行并发时也不能 race。
func TestIPRateLimiter_ConcurrentAllowAndSweep(t *testing.T) {
	l, clock := newTestLimiter(5, 1000000, time.Millisecond)

	var wg sync.WaitGroup
	wg.Add(2)
	go func() {
		defer wg.Done()
		for i := 0; i < 500; i++ {
			l.Allow(fmt.Sprintf("203.0.113.%d", i%64))
		}
	}()
	go func() {
		defer wg.Done()
		for i := 0; i < 500; i++ {
			// 不断推进时钟，让放行路径里的摊还清扫反复触发
			clock.Advance(rateLimitSweepInterval)
		}
	}()
	wg.Wait()
}
