package middleware

import (
	"context"
	"encoding/json"
	"errors"
	"net/http"
	"net/http/httptest"
	"testing"
	"time"

	"{{ .Module }}/app/helper/store"
)

// fakeSessionStore 可控的会话存储，用来覆盖「有效 / 已吊销 / 存储故障」三种分支。
//
// 它按真实实现的语义建模：会话登记时带上当前认证版本，校验时与
// 用户的当前版本比对 —— 版本自增（改密/禁用事务提交）即等于批量吊销。
type fakeSessionStore struct {
	live        map[string]fakeSession // jti -> 会话
	versions    map[uint64]int64       // uid -> 当前认证版本
	unavailable bool
	registers   []fakeRegisterCall // 登记调用记录（断言刷新沿用的版本）
	revokes     []string           // 吊销调用记录
}

type fakeSession struct {
	uid     uint64
	version int64
}

type fakeRegisterCall struct {
	uid     uint64
	jti     string
	version int64
}

func newFakeSessionStore() *fakeSessionStore {
	return &fakeSessionStore{live: map[string]fakeSession{}, versions: map[uint64]int64{}}
}

// currentVersion 用户当前认证版本，没记录过的按 1（底座默认值）处理。
func (f *fakeSessionStore) currentVersion(uid uint64) int64 {
	if v, ok := f.versions[uid]; ok {
		return v
	}
	return 1
}

// bumpVersion 模拟「改密/禁用」事务提交：认证版本 +1。
func (f *fakeSessionStore) bumpVersion(uid uint64) int64 {
	f.versions[uid] = f.currentVersion(uid) + 1
	return f.versions[uid]
}

// login 以当前版本登记一个会话（等价于一次成功登录）。
func (f *fakeSessionStore) login(t *testing.T, uid uint64, jti string) {
	t.Helper()
	if err := f.RegisterSession(uid, jti, time.Hour, f.currentVersion(uid)); err != nil {
		t.Fatalf("登记会话 %s 失败: %v", jti, err)
	}
}

func (f *fakeSessionStore) RegisterSession(userID uint64, jti string, _ time.Duration, authVersion int64) error {
	if f.unavailable {
		return store.ErrSessionStoreUnavailable
	}
	if authVersion <= 0 {
		return store.ErrSessionStoreUnavailable
	}
	f.registers = append(f.registers, fakeRegisterCall{uid: userID, jti: jti, version: authVersion})
	f.live[jti] = fakeSession{uid: userID, version: authVersion}
	return nil
}

func (f *fakeSessionStore) ValidateSession(userID uint64, jti string) (int64, error) {
	if f.unavailable {
		return 0, store.ErrSessionStoreUnavailable
	}
	s, ok := f.live[jti]
	if !ok || s.uid != userID {
		return 0, store.ErrSessionRevoked
	}
	if s.version != f.currentVersion(userID) {
		return 0, store.ErrSessionRevoked
	}
	return s.version, nil
}

func (f *fakeSessionStore) RevokeSession(jti string) error {
	if f.unavailable {
		return store.ErrSessionStoreUnavailable
	}
	f.revokes = append(f.revokes, jti)
	delete(f.live, jti)
	return nil
}

// withFakeSessionStore 安装假存储并在用例结束后还原，避免用例间互相影响。
func withFakeSessionStore(t *testing.T) *fakeSessionStore {
	t.Helper()
	prev := AuthSessionStore()
	fake := newFakeSessionStore()
	SetAuthSessionStore(fake)
	t.Cleanup(func() { SetAuthSessionStore(prev) })
	return fake
}

// runSessionValidator 把带 claims 的请求过一遍中间件，返回响应体里的业务 code。
// 注意：httpx.SendResponse 对 401/503 这类码会以 HTTP 200 + body.code 返回，
// 所以这里断言的是 body 里的 code，而不是 HTTP 状态码。
func runSessionValidator(t *testing.T, claims *JWTClaims) (code int, reachedNext bool) {
	t.Helper()

	reached := false
	handler := SessionValidatorMiddleware()(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
		reached = true
		w.WriteHeader(http.StatusOK)
		_, _ = w.Write([]byte(`{"code":200}`))
	}))

	req := httptest.NewRequest(http.MethodGet, "/admin/user/current-info", nil)
	if claims != nil {
		req = req.WithContext(context.WithValue(req.Context(), JWTTokenClaimsKey, *claims))
	}
	rec := httptest.NewRecorder()
	handler.ServeHTTP(rec, req)

	var body struct {
		Code int `json:"code"`
	}
	if err := json.Unmarshal(rec.Body.Bytes(), &body); err != nil {
		t.Fatalf("响应体不是 JSON: %v (%s)", err, rec.Body.String())
	}
	return body.Code, reached
}

// TestSessionValidator_AllowsLiveSession 白名单内的会话应放行到下游。
func TestSessionValidator_AllowsLiveSession(t *testing.T) {
	fake := withFakeSessionStore(t)
	fake.login(t, 7, "jti-live")

	code, reached := runSessionValidator(t, &JWTClaims{UID: "7", Username: "tester", JTI: "jti-live"})
	if !reached {
		t.Fatal("有效会话应放行到下游处理器")
	}
	if code != http.StatusOK {
		t.Fatalf("有效会话期望 code 200，实际 %d", code)
	}
}

// TestSessionValidator_DeniesRevoked 登出 / 改密后吊销的会话必须被拒绝，且不进入下游。
func TestSessionValidator_DeniesRevoked(t *testing.T) {
	fake := withFakeSessionStore(t)
	fake.login(t, 7, "jti-a")

	// 模拟登出
	if err := fake.RevokeSession("jti-a"); err != nil {
		t.Fatalf("吊销失败: %v", err)
	}

	code, reached := runSessionValidator(t, &JWTClaims{UID: "7", Username: "tester", JTI: "jti-a"})
	if reached {
		t.Fatal("已吊销的会话不能进入下游处理器")
	}
	if code != http.StatusUnauthorized {
		t.Fatalf("已吊销会话期望 code 401，实际 %d", code)
	}
}

// TestSessionValidator_RevokeDoesNotHarmNewLogin 吊销旧会话后，新登录的会话仍然可用。
func TestSessionValidator_RevokeDoesNotHarmNewLogin(t *testing.T) {
	fake := withFakeSessionStore(t)
	fake.login(t, 7, "jti-old")
	_ = fake.RevokeSession("jti-old")
	// 同一时刻重新登录
	fake.login(t, 7, "jti-new")

	if code, reached := runSessionValidator(t, &JWTClaims{UID: "7", JTI: "jti-new"}); !reached || code != http.StatusOK {
		t.Fatalf("新登录会话应放行，实际 code=%d reached=%v", code, reached)
	}
	if code, reached := runSessionValidator(t, &JWTClaims{UID: "7", JTI: "jti-old"}); reached || code != http.StatusUnauthorized {
		t.Fatalf("旧会话仍应被拒绝，实际 code=%d reached=%v", code, reached)
	}
}

// TestSessionValidator_StoreUnavailableFailsClosed Redis 故障时拒绝请求而不是放行。
func TestSessionValidator_StoreUnavailableFailsClosed(t *testing.T) {
	fake := withFakeSessionStore(t)
	fake.login(t, 7, "jti-a")
	fake.unavailable = true

	code, reached := runSessionValidator(t, &JWTClaims{UID: "7", JTI: "jti-a"})
	if reached {
		t.Fatal("认证存储不可用时绝不能放行")
	}
	if code != http.StatusServiceUnavailable {
		t.Fatalf("存储不可用期望 code 503，实际 %d", code)
	}

	// 恢复后同一个会话应重新可用
	fake.unavailable = false
	if code, reached := runSessionValidator(t, &JWTClaims{UID: "7", JTI: "jti-a"}); !reached || code != http.StatusOK {
		t.Fatalf("存储恢复后应重新放行，实际 code=%d reached=%v", code, reached)
	}
}

// TestSessionValidator_MissingClaimsOrJTI 缺少 claims / jti / 用户 ID 非法都必须拒绝，
// 这正是旧实现放行的空洞。
func TestSessionValidator_MissingClaimsOrJTI(t *testing.T) {
	withFakeSessionStore(t)

	cases := []struct {
		name   string
		claims *JWTClaims
	}{
		{"没有 claims", nil},
		{"没有 jti", &JWTClaims{UID: "7", Username: "tester"}},
		{"用户 ID 非法", &JWTClaims{UID: "not-a-number", JTI: "jti-a"}},
	}
	for _, tc := range cases {
		tc := tc
		t.Run(tc.name, func(t *testing.T) {
			code, reached := runSessionValidator(t, tc.claims)
			if reached {
				t.Fatal("不应放行到下游处理器")
			}
			if code != http.StatusUnauthorized {
				t.Fatalf("期望 code 401，实际 %d", code)
			}
		})
	}
}

// TestSessionValidator_PasswordChangeRevokesThenReloginWorks 改密事务提交（认证版本自增）
// 后，该用户此前所有会话立刻被拒；紧随其后的新登录仍然可用，其他用户不受影响。
func TestSessionValidator_PasswordChangeRevokesThenReloginWorks(t *testing.T) {
	fake := withFakeSessionStore(t)
	fake.login(t, 7, "jti-a")
	fake.login(t, 7, "jti-b")
	fake.login(t, 8, "jti-other")

	fake.bumpVersion(7) // 改密 + 版本自增同事务提交

	for _, jti := range []string{"jti-a", "jti-b"} {
		if code, reached := runSessionValidator(t, &JWTClaims{UID: "7", JTI: jti}); reached || code != http.StatusUnauthorized {
			t.Fatalf("改密后会话 %s 应被拒绝，实际 code=%d reached=%v", jti, code, reached)
		}
	}
	if code, reached := runSessionValidator(t, &JWTClaims{UID: "8", JTI: "jti-other"}); !reached || code != http.StatusOK {
		t.Fatalf("其他用户不应被误伤，实际 code=%d reached=%v", code, reached)
	}

	fake.login(t, 7, "jti-new") // 改密后立刻重新登录
	if code, reached := runSessionValidator(t, &JWTClaims{UID: "7", JTI: "jti-new"}); !reached || code != http.StatusOK {
		t.Fatalf("改密后新登录应可用，实际 code=%d reached=%v", code, reached)
	}
}

// TestSessionValidator_CrossUserJTI 拿别人的 jti 配自己的 uid 过不去。
func TestSessionValidator_CrossUserJTI(t *testing.T) {
	fake := withFakeSessionStore(t)
	fake.login(t, 7, "jti-a")

	code, reached := runSessionValidator(t, &JWTClaims{UID: "9", JTI: "jti-a"})
	if reached || code != http.StatusUnauthorized {
		t.Fatalf("jti 与用户不匹配应被拒绝，实际 code=%d reached=%v", code, reached)
	}
}

// TestSessionStore_DefaultIsRedisBacked 默认实现必须是会 fail closed 的 Redis 实现，
// 不能被换成「永远返回 nil」的空实现。
func TestSessionStore_DefaultIsRedisBacked(t *testing.T) {
	prev := AuthSessionStore()
	t.Cleanup(func() { SetAuthSessionStore(prev) })

	if _, ok := prev.(*store.AuthRedisStore); !ok {
		t.Fatalf("默认会话存储应为 *store.AuthRedisStore，实际 %T", prev)
	}
	// 测试进程里没有 Redis，默认实现必须报存储不可用
	if _, err := prev.ValidateSession(7, "jti-a"); !errors.Is(err, store.ErrSessionStoreUnavailable) {
		t.Fatalf("默认实现在无 Redis 时应返回存储不可用，实际: %v", err)
	}

	// SetAuthSessionStore(nil) 不能把实现清空
	SetAuthSessionStore(nil)
	if AuthSessionStore() == nil {
		t.Fatal("SetAuthSessionStore(nil) 不应清空会话存储")
	}
}
