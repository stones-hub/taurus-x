package middleware

import (
	"net/http"

	"github.com/stones-hub/taurus-pro-common/pkg/util/tnet"
	"github.com/stones-hub/taurus-pro-http/pkg/httpx"

	"{{ .Module }}/internal/taurus"
)

// HostMiddleware 主机 IP 白名单校验中间件。
//
// 判定只用 ClientIP：直连对端不在 http.trusted_proxies 里时，
// 转发头（X-Real-IP / X-Forwarded-For）一律不采信，
// 否则客户端自己伪造一个白名单 IP 就能绕过这道校验。
func HostMiddleware(next http.Handler) http.Handler {
	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		if !isAllowedHost(ClientIP(r)) {
			httpx.SendResponse(w, http.StatusForbidden, "访问被拒绝: 未授权主机.", nil)
			return
		}
		next.ServeHTTP(w, r)
	})
}

// isAllowedHost 判断来源 IP 是否在允许列表中
func isAllowedHost(ip string) bool {
	if ip == "" {
		return false
	}
	return tnet.IsIPAllowed(ip, taurus.Container.Config.GetStringSlice("http.host_white_list"))
}
