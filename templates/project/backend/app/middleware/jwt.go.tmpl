package middleware

import (
	"context"
	"errors"
	"fmt"
	"log"
	"net/http"
	"strconv"
	"time"

	"github.com/stones-hub/taurus-pro-common/pkg/util/tcrypt"
	"github.com/stones-hub/taurus-pro-http/pkg/httpx"

	"{{ .Module }}/app/helper/store"
	"{{ .Module }}/internal/taurus"
)

type contextKey string

const (
	// JWTTokenKey 承载 JWT 令牌的 Cookie 名（HttpOnly）。令牌只走这个 Cookie：
	// 不在响应体、响应头里下发，也不从 Authorization / 自定义请求头读取。
	JWTTokenKey = "jwt_token"
	// JWTTokenClaimsKey context 中存放 JWT claims 的键
	JWTTokenClaimsKey contextKey = "jwt_claims"
)

// JWTInvalidMessage 令牌校验不通过时回给客户端的固定提示（不带 JWT 库的错误原文）。
const JWTInvalidMessage = "登录凭证无效，请重新登录"

// ErrJWTMissingExpiry 令牌没有 exp。本项目签发的令牌总带 exp，缺失 exp 的令牌
// 一律按无效处理，避免出现无法过期的会话凭证。
var ErrJWTMissingExpiry = errors.New("JWT令牌缺少过期时间")

// ErrJWTWriteFailed 令牌已签发并登记，但写入响应失败；此时会话已被尽力吊销。
var ErrJWTWriteFailed = errors.New("JWT令牌写入失败")

// JWTClaims JWT 声明
type JWTClaims struct {
	UID      string `json:"uid"`
	Username string `json:"username"`
	// JTI 本次 Token 的唯一标识，会话白名单与精确吊销都靠它
	JTI string `json:"jti"`
}

// JWTMiddleware JWT 鉴权中间件
func JWTMiddleware() func(next http.Handler) http.Handler {
	return func(next http.Handler) http.Handler {
		return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			if !taurus.Container.Config.GetBool("http.jwt.enabled") {
				next.ServeHTTP(w, r)
				return
			}

			token := GetJWTToken(r)
			if token == "" {
				httpx.SendResponse(w, http.StatusUnauthorized, "缺少JWT令牌", nil)
				return
			}

			claims, _, err := ValidateJWTToken(token)
			if err != nil {
				// 具体原因（过期、签名不对、缺 exp……）是 JWT 库的内部文本，只进服务端日志，
				// 客户端只拿到固定提示。路径与原因都用 %q 输出：URL.Path 是解码后的值，
				// 请求里带 %0a 就能在日志里伪造一行；路径再截断，避免超长 URL 刷日志。
				// 只记路径和原因，不记令牌本身。
				log.Printf("JWT 校验失败 path=%q reason=%q\n", truncate(r.URL.Path, 256), err.Error())
				httpx.SendResponse(w, http.StatusUnauthorized, JWTInvalidMessage, nil)
				return
			}

			jwtClaims := JWTClaims{UID: claims.UID, Username: claims.Username, JTI: claims.JTI}
			ctx := context.WithValue(r.Context(), JWTTokenClaimsKey, jwtClaims)
			next.ServeHTTP(w, r.WithContext(ctx))
		})
	}
}

// GetJWTToken 从请求中提取 JWT 令牌：只认 HttpOnly Cookie。
//
// 本项目的浏览器端认证约定是 Cookie-only（HttpOnly Cookie + CSRF 双提交）：
// 不接受 Authorization: Bearer 与 jwt_token 请求头。HttpOnly 降低的是前端 JS 直接
// 读取令牌的风险，并不能阻止 XSS 借用户浏览器发起请求；不收 Bearer 是项目明确的
// 取舍（只保留一种令牌通道），需要给非浏览器客户端开放 Bearer 时应另行设计。
// 认证、登出、刷新都走这一个函数，保证「认证用的」和「吊销/轮换的」是同一个令牌。
func GetJWTToken(r *http.Request) string {
	if c, err := r.Cookie(JWTTokenKey); err == nil {
		return c.Value
	}
	return ""
}

// signJWT 只负责签名并回读 jti，不碰会话白名单。
// 单独拆出来是为了让「签发」与「登记」的顺序/版本来源可以被独立推理与测试。
func signJWT(uid, username string) (token, jti string, ttl time.Duration, err error) {
	expireHours := taurus.Container.Config.GetInt("http.jwt.expire_hours")
	if expireHours <= 0 {
		expireHours = 24
	}
	ttl = time.Duration(expireHours) * time.Hour
	secret := taurus.Container.Config.GetString("http.jwt.secret")

	token, err = tcrypt.GenerateTokenWithExpiration(
		uid,
		username,
		taurus.Container.Config.GetString("http.jwt.issuer"),
		secret,
		ttl,
	)
	if err != nil {
		return "", "", 0, err
	}

	// jti 由签发库生成，回读一次拿到它
	claims, err := parseJWT(token, secret)
	if err != nil {
		return "", "", 0, err
	}
	return token, claims.ID, ttl, nil
}

// GenerateJWTToken 生成 JWT 令牌，并以 authVersion 把它登记进会话白名单。
// 登记失败时不返回 Token：宁可登录失败，也不要发出一个「无法被吊销」的 Token。
//
// authVersion 必须来自「校验凭证与账号状态的那一次数据库读取」（同一个一致性快照），
// 不能在这里重新读一遍：
//   - 若改密在该快照之前提交，旧密码根本过不了校验；
//   - 若改密在该快照之后提交，当前版本已经变了，本次登记的版本立即失配，会话无效。
//
// 两种情况都不存在「旧凭证换到可用会话」的窗口。反过来，如果在登记时现读版本，
// 旧凭证的并发登录就会登记到新版本上，这正是不能只把自增提前到 SQL 之前的原因。
//
// 会话登记受 store.SessionOperationTimeout 约束（在 ctx 上派生，ctx 期限更早时以 ctx 为准）。
func GenerateJWTToken(ctx context.Context, uid, username string, authVersion int64) (string, error) {
	token, _, err := registerJWT(ctx, uid, username, authVersion)
	return token, err
}

// registerJWT 是 GenerateJWTToken 的实现，额外返回 jti，供写入失败时吊销。
func registerJWT(ctx context.Context, uid, username string, authVersion int64) (token, jti string, err error) {
	userID, err := strconv.ParseUint(uid, 10, 64)
	if err != nil {
		return "", "", fmt.Errorf("签发 Token 失败: 用户 ID 非法")
	}
	ctx, cancel := context.WithTimeout(ctx, store.SessionOperationTimeout)
	defer cancel()
	token, jti, ttl, err := signJWT(uid, username)
	if err != nil {
		return "", "", err
	}
	if err := AuthSessionStore().RegisterSession(ctx, userID, jti, ttl, authVersion); err != nil {
		return "", "", fmt.Errorf("签发 Token 失败: %w", err)
	}
	return token, jti, nil
}

// IssueLoginJWT 登录专用：签发并登记会话（同 GenerateJWTToken），再把令牌写入
// HttpOnly Cookie，返回过期时间。令牌本身不返回给调用方，避免被写进响应体。
//
// 写入失败时返回 ErrJWTWriteFailed，并尽力吊销刚登记的会话（吊销失败只记日志）：
// 客户端拿不到令牌，这个会话不应在白名单里留到过期。
//
// 登记与尽力吊销共用同一个 store.SessionOperationTimeout 预算，吊销不另开 Background：
// 预算已经用完时吊销会直接失败（只记日志），会话键留到 TTL 到期，但令牌没有交给任何人。
// 预算到期或请求已取消时不写 Cookie。
func IssueLoginJWT(ctx context.Context, w http.ResponseWriter, uid, username string, authVersion int64) (time.Time, error) {
	ctx, cancel := context.WithTimeout(ctx, store.SessionOperationTimeout)
	defer cancel()
	token, jti, err := registerJWT(ctx, uid, username, authVersion)
	if err != nil {
		return time.Time{}, err
	}
	expiresAt, err := JWTExpiresAt(token)
	if err != nil {
		revokeUndeliveredSession(ctx, jti)
		return time.Time{}, fmt.Errorf("%w: %v", ErrJWTWriteFailed, err)
	}
	if err := ctx.Err(); err != nil {
		revokeUndeliveredSession(ctx, jti)
		return time.Time{}, fmt.Errorf("签发 Token 失败: %w", sessionDeadlineError(err))
	}
	setJWTCookie(w, token, expiresAt)
	return expiresAt, nil
}

// revokeUndeliveredSession 尽力吊销一个已登记、但令牌没交给客户端的会话；失败只记日志。
func revokeUndeliveredSession(ctx context.Context, jti string) {
	if err := AuthSessionStore().RevokeSession(ctx, jti); err != nil {
		log.Printf("登录令牌未交付后吊销会话失败: %v\n", err)
	}
}

// sessionDeadlineError 会话预算到期或请求已取消：按会话存储不可用处理（调用方回 503），
// 同时保留 ctx 的错误。
func sessionDeadlineError(ctxErr error) error {
	return fmt.Errorf("%w: %w", store.ErrSessionStoreUnavailable, ctxErr)
}

// ValidateJWTToken 验证 JWT 令牌签名与有效期（不含会话白名单校验，
// 白名单由 SessionValidatorMiddleware 负责）
func ValidateJWTToken(token string) (*JWTClaims, *tcrypt.Claims, error) {
	c, err := parseJWT(token, taurus.Container.Config.GetString("http.jwt.secret"))
	if err != nil {
		return nil, nil, err
	}
	return &JWTClaims{UID: c.Uid, Username: c.Username, JTI: c.ID}, c, nil
}

// parseJWT 校验签名与时间点，并要求令牌带 exp（缺失返回 ErrJWTMissingExpiry）。
func parseJWT(token, secret string) (*tcrypt.Claims, error) {
	c, err := tcrypt.ParseTokenWithSecret(token, secret)
	if err != nil {
		return nil, err
	}
	if c.ExpiresAt == nil {
		return nil, ErrJWTMissingExpiry
	}
	return c, nil
}

// RefreshJWTToken 刷新 JWT 令牌：校验旧 Token 仍在白名单内，签发新 Token 后吊销旧的，
// 把新令牌写入 HttpOnly Cookie 后返回过期时间（新令牌本身不返回）。
//
// 顺序是先轮换会话、再写 Cookie。写 Cookie 失败时旧会话已被消费、新令牌也没交给客户端，
// 用户只能重新登录。这是有意的失败即关闭：反过来先写 Cookie 再轮换，轮换失败时客户端
// 会拿到一个不在白名单里的令牌，或者旧令牌在轮换失败后仍可用，都比强制重新登录更糟。
//
// 会话存储故障、会话预算（store.SessionOperationTimeout）到期或请求已取消时不写 Cookie，
// 按存储不可用返回；预算在轮换写入期间或之后才到期时，Redis 端可能已经提交轮换，旧令牌同样不再可用。
//
// 预算在入口建立一次：解析、校验 + 签名 + 轮换（rotateSession 内再派生不会延长它）、
// 读取过期时间到写 Cookie 前的检查共用同一个期限。
func RefreshJWTToken(ctx context.Context, w http.ResponseWriter, token string) (time.Time, error) {
	ctx, cancel := context.WithTimeout(ctx, store.SessionOperationTimeout)
	defer cancel()
	claims, err := parseJWT(token, taurus.Container.Config.GetString("http.jwt.secret"))
	if err != nil {
		return time.Time{}, err
	}
	userID, err := strconv.ParseUint(claims.Uid, 10, 64)
	if err != nil {
		return time.Time{}, errors.New("用户 ID 非法")
	}
	newToken, err := rotateSession(ctx, AuthSessionStore(), userID, claims.ID, func() (string, string, time.Duration, error) {
		return signJWT(claims.Uid, claims.Username)
	})
	if err != nil {
		return time.Time{}, err
	}
	expiresAt, err := JWTExpiresAt(newToken)
	if err != nil {
		return time.Time{}, fmt.Errorf("写入 JWT Cookie 失败: %w", err)
	}
	if err := ctx.Err(); err != nil {
		return time.Time{}, fmt.Errorf("轮换会话失败: %w", sessionDeadlineError(err))
	}
	setJWTCookie(w, newToken, expiresAt)
	return expiresAt, nil
}

// rotateSession 把旧会话轮换成新会话，是刷新 Token 的全部安全逻辑。
//
// 关键一点：新会话沿用**旧会话校验时拿到的那个认证版本**，绝不重新读当前版本。
// 否则会留下这样的窗口 —— 旧 Token 校验通过，紧接着管理员改密/禁用提交，
// 刷新却按新版本登记，于是刚被吊销的会话借刷新续了命。沿用旧版本后，
// 这种并发下新 Token 的版本已经落后，下一次校验必然被拒。
//
// Redis 在一个原子操作中核对并消费旧会话、登记新会话；旧会话最多成功轮换一次。
//
// 校验、签名、轮换共用一个 store.SessionOperationTimeout 预算，各步骤不重新计时；
// 预算到期后不再轮换，也不返回新令牌。
func rotateSession(ctx context.Context, s SessionStore, userID uint64, oldJTI string,
	sign func() (token, jti string, ttl time.Duration, err error)) (string, error) {
	ctx, cancel := context.WithTimeout(ctx, store.SessionOperationTimeout)
	defer cancel()
	authVersion, err := s.ValidateSession(ctx, userID, oldJTI)
	if err != nil {
		return "", err
	}
	newToken, newJTI, ttl, err := sign()
	if err != nil {
		return "", err
	}
	if err := s.RotateSession(ctx, userID, oldJTI, newJTI, ttl, authVersion); err != nil {
		return "", fmt.Errorf("轮换会话失败: %w", err)
	}
	if err := ctx.Err(); err != nil {
		return "", fmt.Errorf("轮换会话失败: %w", sessionDeadlineError(err))
	}
	return newToken, nil
}

// JWTExpiresAt 校验令牌并返回其过期时间（exp）；令牌无效或缺少 exp 时返回错误。
func JWTExpiresAt(token string) (time.Time, error) {
	_, claims, err := ValidateJWTToken(token)
	if err != nil {
		return time.Time{}, err
	}
	return claims.ExpiresAt.Time, nil
}

// SetJWTToken 设置 JWT 令牌到 HttpOnly Cookie，Cookie 过期时间与令牌 exp 一致。
// 读不出 exp 时不写任何头并返回错误，由调用方决定响应，不能静默当成成功。
func SetJWTToken(w http.ResponseWriter, token string) error {
	expiresAt, err := JWTExpiresAt(token)
	if err != nil {
		return fmt.Errorf("写入 JWT Cookie 失败: %w", err)
	}
	setJWTCookie(w, token, expiresAt)
	return nil
}

// setJWTCookie 把已校验过的令牌写入 HttpOnly Cookie，expiresAt 必须取自该令牌的 exp。
// 除 Set-Cookie 外不写任何响应头：自定义响应头里的令牌前端 JS 能读到，绕过了 HttpOnly。
func setJWTCookie(w http.ResponseWriter, token string, expiresAt time.Time) {
	http.SetCookie(w, &http.Cookie{
		Name:     JWTTokenKey,
		Value:    token,
		Expires:  expiresAt,
		Path:     "/",
		HttpOnly: true,
		Secure:   taurus.Container.Config.GetBool("http.jwt.secure"),
		SameSite: http.SameSiteLaxMode,
	})
}

// GetJWTClaims 从请求上下文获取 JWT 声明
func GetJWTClaims(r *http.Request) *JWTClaims {
	if claims, ok := r.Context().Value(JWTTokenClaimsKey).(JWTClaims); ok {
		return &claims
	}
	return nil
}

// GetUserID 从请求上下文获取用户 ID
func GetUserID(r *http.Request) string {
	if claims := GetJWTClaims(r); claims != nil {
		return claims.UID
	}
	return ""
}

// GetUsername 从请求上下文获取用户名
func GetUsername(r *http.Request) string {
	if claims := GetJWTClaims(r); claims != nil {
		return claims.Username
	}
	return ""
}

// CurrentUserIDFromJWT 从请求上下文提取用户 ID（uint64）
func CurrentUserIDFromJWT(r *http.Request) (uint64, bool) {
	uidStr := GetUserID(r)
	if uidStr == "" {
		return 0, false
	}
	uid, err := strconv.ParseUint(uidStr, 10, 64)
	if err != nil {
		return 0, false
	}
	return uid, true
}

// ClearJWTToken 清除 JWT 令牌
func ClearJWTToken(w http.ResponseWriter) {
	http.SetCookie(w, &http.Cookie{
		Name:     JWTTokenKey,
		Value:    "",
		MaxAge:   -1,
		Expires:  time.Now().Add(-1 * time.Hour),
		Path:     "/",
		HttpOnly: true,
		Secure:   taurus.Container.Config.GetBool("http.jwt.secure"),
		SameSite: http.SameSiteLaxMode,
	})
}
