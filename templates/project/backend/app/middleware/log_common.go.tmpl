package middleware

import (
	"bytes"
	"encoding/json"
	"io"
	"net/http"
	"strconv"
	"strings"
)

// maxBodyLogSize 日志记录请求/响应体的最大字节数（超出截断）
const maxBodyLogSize = 81920

// businessCodePrefixBytes 判断操作成败时最多解析响应体的前多少字节。
const businessCodePrefixBytes = 4096

// statusRecorder 包装 http.ResponseWriter 捕获响应状态码 + 响应体（最多 maxBodyLogSize 字节，
// 超出部分只透传给客户端、不缓存，大响应不会被整份留在内存里）。
// 供访问日志/操作日志中间件共用。
type statusRecorder struct {
	http.ResponseWriter
	status int
	buf    bytes.Buffer
}

func (r *statusRecorder) WriteHeader(code int) {
	r.status = code
	r.ResponseWriter.WriteHeader(code)
}

func (r *statusRecorder) Write(b []byte) (int, error) {
	if r.status == 0 {
		r.status = http.StatusOK
	}
	// 记录响应体（限制大小，超出截断）
	if r.buf.Len() < maxBodyLogSize {
		remaining := maxBodyLogSize - r.buf.Len()
		if len(b) > remaining {
			r.buf.Write(b[:remaining])
		} else {
			r.buf.Write(b)
		}
	}
	return r.ResponseWriter.Write(b)
}

// body 返回截断后的响应体字符串
func (r *statusRecorder) body() string {
	return r.buf.String()
}

// businessCode 从响应体前缀里取出 httpx 响应的业务 code（{"code":...,"message":...,"data":...}）。
//
// 只看前 businessCodePrefixBytes 字节，并且用流式解析，读到 code 就停：httpx 把 code
// 写在最前面，响应再大、被截断成不完整的 JSON 也照样能取到。不是 JSON 对象、
// 在前缀内找不到 code、code 不是整数时返回 false，由调用方回退到 HTTP 状态判断。
func businessCode(body []byte) (int, bool) {
	if len(body) > businessCodePrefixBytes {
		body = body[:businessCodePrefixBytes]
	}
	dec := json.NewDecoder(bytes.NewReader(body))
	dec.UseNumber()
	if tok, err := dec.Token(); err != nil || tok != json.Delim('{') {
		return 0, false
	}
	for dec.More() {
		tok, err := dec.Token()
		if err != nil {
			return 0, false
		}
		key, ok := tok.(string)
		if !ok {
			return 0, false
		}
		if key == "code" {
			var n json.Number
			if err := dec.Decode(&n); err != nil {
				return 0, false
			}
			code, err := strconv.Atoi(n.String())
			if err != nil {
				return 0, false
			}
			return code, true
		}
		var skip json.RawMessage
		if err := dec.Decode(&skip); err != nil {
			return 0, false
		}
	}
	return 0, false
}

// operationResult 判断一次写操作的成败：HTTP 状态 >= 400 一定失败（限流 429、请求体过大 413 等
// 走真实状态码）；否则看业务 code，不在 2xx 内就是失败（与前端 http.ts 的判定一致）；
// 解析不出业务 code（非 JSON 等）时按 HTTP 状态判定为成功。
func operationResult(status int, body []byte) string {
	if status >= 400 {
		return "失败"
	}
	if code, ok := businessCode(body); ok && (code < 200 || code >= 300) {
		return "失败"
	}
	return "成功"
}

// readBody 读取并恢复请求体（限制 1MB），供日志记录使用，恢复后不影响后续 handler 读取。
// multipart/form-data 请求体为二进制流（含文件上传），读取再重建会破坏 multipart 边界，
// 导致后续 ParseMultipartForm 报 unexpected EOF，故直接跳过、透传原始 body。
func readBody(r *http.Request) []byte {
	if r.Body == nil {
		return nil
	}
	if strings.HasPrefix(r.Header.Get("Content-Type"), "multipart/form-data") {
		return nil
	}
	limit := int64(1 << 20) // 1MB
	data, err := io.ReadAll(io.LimitReader(r.Body, limit))
	if err != nil {
		r.Body = http.NoBody
		return nil
	}
	r.Body = io.NopCloser(strings.NewReader(string(data)))
	return data
}

// truncate 截断字符串到 max 长度（按字节）
func truncate(s string, max int) string {
	if len(s) <= max {
		return s
	}
	return s[:max]
}

// shouldSkipLogging 判断是否跳过日志记录（日志自身接口 + 前端错误上报），
// 避免「日志记录日志」的递归嵌套导致 response_body 转义膨胀。
func shouldSkipLogging(path string) bool {
	return strings.HasPrefix(path, "/admin/log") || path == "/report-front-error"
}
