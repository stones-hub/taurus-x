// ===== 前端错误日志 =====

// FrontErrorLogListRequest 前端错误日志查询请求
type FrontErrorLogListRequest struct {
	PageQuery
	UserID uint64 `json:"user_id"` // 用户ID（0=不过滤）
	Kind   string `json:"kind"`    // 错误类型（空=不过滤）
	URL    string `json:"url"`     // 页面 URL（模糊匹配，空=不过滤）
}

// FrontErrorLogResponse 前端错误日志列表项
type FrontErrorLogResponse struct {
	LogID     uint64 `json:"log_id"`
	UserID    uint64 `json:"user_id"`
	Username  string `json:"username"`
	Kind      string `json:"kind"`
	Message   string `json:"message"`
	Source    string `json:"source"`
	Stack     string `json:"stack"`
	URL       string `json:"url"`
	UserAgent string `json:"user_agent"`
	IP        string `json:"ip"`
	CreatedAt string `json:"created_at"`
}

// FrontErrorLogListResponse 前端错误日志列表响应
type FrontErrorLogListResponse struct {
	PageNo      int                    `json:"page_no"`
	PageSize    int                    `json:"page_size"`
	ResultTotal int64                  `json:"result_total"`
	List        []*FrontErrorLogResponse `json:"list"`
}

// FrontErrorReportRequest 前端错误上报请求（公共路由）
type FrontErrorReportRequest struct {
	Message string `json:"message"` // 错误信息
	Source  string `json:"source"`  // 出错位置
	Stack   string `json:"stack"`   // 错误堆栈
	URL     string `json:"url"`     // 页面 URL
	Kind    string `json:"kind"`    // 错误类型
}
