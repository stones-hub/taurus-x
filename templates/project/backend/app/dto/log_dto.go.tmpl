package dto

// LoginLogListResponse 登录日志列表响应
type LoginLogListResponse struct {
	PageNo      int                 `json:"page_no"`
	PageSize    int                 `json:"page_size"`
	ResultTotal int64               `json:"result_total"`
	List        []*LoginLogResponse `json:"list"`
}

// LoginLogResponse 登录日志列表项
type LoginLogResponse struct {
	LogID         uint64 `json:"log_id"`
	UserID        uint64 `json:"user_id"`
	Username      string `json:"username"`
	LoginType     string `json:"login_type"`
	LoginIP       string `json:"login_ip"`
	UserAgent     string `json:"user_agent"`
	LoginStatus   int8   `json:"login_status"`
	FailureReason string `json:"failure_reason"`
	LoginTime     string `json:"login_time"`
}

// LoginLogListRequest 登录日志查询请求
type LoginLogListRequest struct {
	PageQuery
	LoginStatus int8 `json:"login_status"`
}

// ===== 访问日志 =====

// AccessLogListRequest 访问日志查询请求
type AccessLogListRequest struct {
	PageQuery
	UserID     uint64 `json:"user_id"`     // 用户ID（0=不过滤）
	Method     string `json:"method"`      // HTTP 方法（空=不过滤）
	Path       string `json:"path"`        // 请求路径（模糊匹配，空=不过滤）
	StatusCode int    `json:"status_code"` // 状态码（0=不过滤）
	IP         string `json:"ip"`          // 客户端 IP（模糊匹配，空=不过滤）
}

// AccessLogResponse 访问日志列表项
type AccessLogResponse struct {
	LogID        uint64 `json:"log_id"`
	UserID       uint64 `json:"user_id"`
	Username     string `json:"username"`
	Method       string `json:"method"`
	Path         string `json:"path"`
	StatusCode   int    `json:"status_code"`
	IP           string `json:"ip"`
	UserAgent    string `json:"user_agent"`
	DurationMs   int64  `json:"duration_ms"`
	Query        string `json:"query"`
	RequestBody  string `json:"request_body"`
	ResponseBody string `json:"response_body"`
	CreatedAt    string `json:"created_at"`
}

// AccessLogListResponse 访问日志列表响应
type AccessLogListResponse struct {
	PageNo      int                 `json:"page_no"`
	PageSize    int                 `json:"page_size"`
	ResultTotal int64               `json:"result_total"`
	List        []*AccessLogResponse `json:"list"`
}

