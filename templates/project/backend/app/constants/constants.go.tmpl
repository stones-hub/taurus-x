package constants

// ==================== 通用枚举查询（数据驱动） ====================
// 「常量值 → 名称」统一用 map 数据 + lookup 查询，不要手写 switch 骨架。
// 每个枚举的「值 → 中文名」集中在唯一一个 xxxNames map 里（单一数据源），
// GetXxxName 函数退化为一行 lookup 委托，消除 switch 的浅重复（详见 docs/项目规范.md）。
//
// 本文件只放底座自身的枚举（用户 / 登录方式 / 权限类型）。新增业务域时按域
// 另建文件（同属 package constants，import 路径不变），例如：
//
//	// order_constants.go
//	var orderStatusNames = map[int8]string{1: "待开始", 2: "执行中", 3: "已完成"}
//
//	// GetOrderStatusName 订单状态中文名
//	func GetOrderStatusName(v int8) string { return lookup(orderStatusNames, v, "未知") }

// lookup 从枚举表查名称，未命中返回 def
func lookup[T comparable](m map[T]string, key T, def string) string {
	if name, ok := m[key]; ok {
		return name
	}
	return def
}

