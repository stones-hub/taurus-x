// AuthService 账号认证与个人信息服务
type AuthService struct {
	userRepo         *repo.AdminUserRepository
	loginRepo        *repo.AdminUserLoginRepository
	verificationCode *helper.VerificationCodeManager
	store            *repo.Store
}

// AuthServiceSet wire provider set
var AuthServiceSet = wire.NewSet(NewAuthService)

// NewAuthService 创建 AuthService（内部手动装配仓储）
func NewAuthService(store *repo.Store) *AuthService {
	return &AuthService{
		userRepo:         store.User(),
		loginRepo:        store.UserLogin(),
		verificationCode: helper.NewVerificationCodeManager(),
		store:            store,
	}
}

// PasswordLogin 账号密码登录（SHA-256 加盐）。
//
// 第二个返回值是**本次凭证校验所依据的那个数据库快照里的认证版本**，调用方必须
// 原样传给 middleware.GenerateJWTToken，不能让签发侧自己再查一遍当前版本。
//
// 之所以把校验和读版本放进同一个事务（即同一个一致性快照）：
//   - 改密事务在本快照之前提交 → 本快照读到的是新凭证，旧密码过不了校验；
//   - 改密事务在本快照之后提交 → 版本已变，本次登记的旧版本立刻失配，会话无效。
//
// 两种情况都不存在「旧凭证换到一个可用会话」的窗口。若改成登记时现读版本，
// 第二种情况就会把旧凭证的登录登记到新版本上 —— 这正是「只把自增提前到
// 凭证 SQL 之前」解决不了的那个竞态。
func (s *AuthService) PasswordLogin(ctx context.Context, account, password string) (*model.AdminUser, int64, error) {
	var (
		user        *model.AdminUser
		authVersion int64
	)
	err := s.store.RunInTx(ctx, func(tx *repo.Tx) error {
		u, err := tx.User().FindByUsername(ctx, account)
		if err != nil {
			return err
		}
		if u == nil {
			return errors.New("用户名或密码错误")
		}

		login, err := tx.UserLogin().FindByUserIDAndLoginTypeAnyStatus(ctx, u.UserID, string(constants.LoginTypeUsername))
		if err != nil {
			return err
		}
		if login == nil {
			return errors.New("请用其他方式登录后设置密码")
		}

		if login.Status != constants.LoginMethodStatusEnabled || u.Status != constants.UserStatusEnabled {
			return errors.New("账号状态非法")
		}

		if !helper.VerifyPassword(password, login.LoginCredential, login.Salt) {
			return errors.New("用户名或密码错误")
		}

		// auth_version 列的默认值是 1，读到 <=0 说明数据被改坏或列缺失：
		// 这种情况下签出来的会话无法被吊销，宁可拒绝登录（fail closed）。
		if u.AuthVersion <= 0 {
			return errors.New("账号认证状态异常，请联系管理员")
		}

		user, authVersion = u, u.AuthVersion
		return nil
	})
	if err != nil {
		return nil, 0, err
	}
	return user, authVersion, nil
}

// LookupUserIDByUsername 按账号查 user_id，查不到或出错返回 0。
// 只用于登录失败日志的归属：失败日志不能因为「账号不存在」就丢掉，
// 但也不该把调用方输入的账号串原样写进日志（可能是误填的口令）。
func (s *AuthService) LookupUserIDByUsername(ctx context.Context, account string) uint64 {
	if account == "" {
		return 0
	}
	user, err := s.userRepo.FindByUsername(ctx, account)
	if err != nil || user == nil {
		return 0
	}
	return user.UserID
}

// GetUserByID 根据用户 ID 查找用户
func (s *AuthService) GetUserByID(ctx context.Context, userID uint64) (*model.AdminUser, error) {
	return s.userRepo.FindByUserID(ctx, userID)
}

// GetCurrentUserInfo 获取当前用户信息（返回 DTO）
func (s *AuthService) GetCurrentUserInfo(ctx context.Context, userID uint64) (*dto.UserInfo, error) {
	user, err := s.userRepo.FindByUserID(ctx, userID)
	if err != nil {
		return nil, err
	}
	if user == nil {
		return nil, errors.New("用户不存在")
	}
	return dto.ToUserInfo(user), nil
}

// UpdateProfile 更新当前用户个人信息（真实姓名/昵称/邮箱/性别/生日）
func (s *AuthService) UpdateProfile(ctx context.Context, userID uint64, req *dto.UpdateProfileRequest) error {
	if req == nil {
		return errors.New("请求参数不能为空")
	}

	// 生日解析：非法或为空用默认 1900-01-01
	var birthday *time.Time
	defaultBirthday := time.Date(1900, 1, 1, 0, 0, 0, 0, time.UTC)
	if req.Birthday != "" {
		if parsed, err := time.Parse("2006-01-02", req.Birthday); err == nil {
			birthday = &parsed
		} else {
			birthday = &defaultBirthday
		}
	} else {
		birthday = &defaultBirthday
	}

	// 邮箱为空则不更新（置 nil）
	var email *string
	if req.Email != "" {
		email = &req.Email
	}

	updateData := map[string]interface{}{
		"realname": req.Realname,
		"nickname": req.Nickname,
		"email":    email,
		"gender":   req.Gender,
		"birthday": birthday,
	}
	return s.userRepo.UpdateByID(ctx, userID, updateData)
}

// ChangePassword 修改密码（校验旧密码 + 更新密码 + 使该用户已签发的 Token 全部失效）。
//
// 校验旧密码、写新凭证、自增认证版本三步都在同一个事务里：
// 旧密码校验和改写之间不留窗口，更不会出现「密码已改、吊销没生效」。
//
// 事务第一件事是锁本人的用户行（lockSelfUserRow）。自助改密不做身份判定，
// 锁它不是为了鉴权，而是为了加锁顺序统一：管理员重置密码的路径是
// 「锁 admin_users 行 → 改 admin_user_logins → 自增 auth_version」，
// 自助改密若先碰凭证行再碰用户行（最后那步 BumpAuthVersion 必然会碰），
// 两条路径就是一对相反的加锁顺序，同一账号上并发时互等成死锁。
func (s *AuthService) ChangePassword(ctx context.Context, userID uint64, req *dto.ChangePasswordRequest) error {
	if req == nil || req.OldPassword == "" || req.NewPassword == "" {
		return errors.New("原密码和新密码不能为空")
	}
	if err := helper.ValidatePasswordStrength(req.NewPassword); err != nil {
		return err
	}

	return s.store.RunInTx(ctx, func(tx *repo.Tx) error {
		// 先锁本人用户行，统一全局加锁顺序（账号不存在直接拒绝）
		if err := lockSelfUserRow(ctx, tx, userID); err != nil {
			return err
		}

		// 校验旧密码（通过 username 登录方式）
		login, err := tx.UserLogin().FindByUserIDAndLoginTypeAnyStatus(ctx, userID, string(constants.LoginTypeUsername))
		if err != nil {
			return err
		}
		if login == nil {
			return errors.New("未设置密码登录方式")
		}
		if !helper.VerifyPassword(req.OldPassword, login.LoginCredential, login.Salt) {
			return errors.New("原密码错误")
		}

		// 更新密码 hash + 盐，并在同一事务内自增认证版本
		salt := helper.GenerateSalt()
		hashed := helper.HashPassword(req.NewPassword, salt)
		return applyRevocableChange(
			func() error {
				return tx.UserLogin().UpdateByID(ctx, login.LoginID, map[string]interface{}{
					"login_credential": hashed,
					"salt":             salt,
				})
			},
			func() error { return tx.User().BumpAuthVersion(ctx, userID) },
		)
	})
}

// BindMobile 绑定手机号（校验验证码 + 占用检查 + 启用/创建 sms 登录方式）
func (s *AuthService) BindMobile(ctx context.Context, userID uint64, req *dto.BindMobileRequest) error {
	if req == nil || req.Mobile == "" || req.Code == "" {
		return errors.New("手机号和验证码不能为空")
	}
	if !helper.ValidateMobile(req.Mobile) {
		return errors.New("手机号格式错误")
	}

	// 校验验证码
	if ok, err := s.verificationCode.VerifyCode(ctx, string(constants.LoginTypeMobile), req.Mobile, req.Code); err != nil || !ok {
		if err != nil {
			return err
		}
		return errors.New("验证码错误或过期")
	}

	// 占用检查
	exist, err := s.userRepo.FindByMobile(ctx, req.Mobile)
	if err != nil {
		return err
	}
	if exist != nil && exist.UserID != userID {
		return errors.New("手机号已被使用")
	}

	// 更新用户手机号
	if err := s.userRepo.UpdateByID(ctx, userID, map[string]interface{}{"mobile": req.Mobile}); err != nil {
		return err
	}

	// 启用/创建 sms 登录方式
	smsLogin, err := s.loginRepo.FindByUserIDAndLoginTypeAnyStatus(ctx, userID, string(constants.LoginTypeMobile))
	if err != nil {
		return err
	}
	if smsLogin != nil {
		return s.loginRepo.UpdateByID(ctx, smsLogin.LoginID, map[string]interface{}{
			"login_value": req.Mobile,
			"status":      1,
		})
	}
	return s.loginRepo.Create(ctx, &model.AdminUserLogin{
		UserID:     userID,
		LoginType:  string(constants.LoginTypeMobile),
		LoginValue: req.Mobile,
		Status:     1,
	})
}

// UnbindMobile 解绑手机号（校验验证码 + 置空 mobile + 删除 sms 登录方式）
func (s *AuthService) UnbindMobile(ctx context.Context, userID uint64, req *dto.UnbindMobileRequest) error {
	if req == nil || req.Mobile == "" || req.Code == "" {
		return errors.New("手机号和验证码不能为空")
	}

	// 验证码校验
	if ok, err := s.verificationCode.VerifyCode(ctx, string(constants.LoginTypeMobile), req.Mobile, req.Code); err != nil || !ok {
		if err != nil {
			return err
		}
		return errors.New("验证码错误或过期")
	}

	// 校验手机号归属
	user, err := s.userRepo.FindByUserID(ctx, userID)
	if err != nil {
		return err
	}
	if user == nil {
		return errors.New("用户不存在")
	}
	if user.Mobile == nil || *user.Mobile != req.Mobile {
		return errors.New("手机号与当前绑定手机号不匹配")
	}

	// 置空手机号
	if err := s.userRepo.UpdateByID(ctx, userID, map[string]interface{}{"mobile": nil}); err != nil {
		return err
	}

	// 删除 sms 登录方式
	smsLogin, err := s.loginRepo.FindByUserIDAndLoginTypeAnyStatus(ctx, userID, string(constants.LoginTypeMobile))
	if err != nil {
		return err
	}
	if smsLogin != nil {
		return s.loginRepo.Delete(ctx, smsLogin)
	}
	return nil
}

// SendSMSCode 发送短信验证码
func (s *AuthService) SendSMSCode(ctx context.Context, mobile string) error {
	if mobile == "" {
		return errors.New("手机号不能为空")
	}
	if !helper.ValidateMobile(mobile) {
		return errors.New("手机号格式错误")
	}
	_, err := s.verificationCode.SendSMSCode(ctx, mobile)
	return err
}

