// ===== 前端错误日志 =====

// ReportFrontError 记录前端上报的错误（存库 + 落文件）。
// 入参只依赖 dto（+ 由 controller 注入的请求上下文信息），service 内部组装 model；
// 返回 error 供调用方兜底处理，避免「错误上报链路静默失败」。
func (s *LogService) ReportFrontError(ctx context.Context, req *dto.FrontErrorReportRequest, userID uint64, ip, userAgent string) error {
	if req == nil {
		return errors.New("请求参数不能为空")
	}
	entry := &model.FrontErrorLog{
		UserID:    userID,
		Message:   req.Message,
		Source:    req.Source,
		Stack:     req.Stack,
		URL:       req.URL,
		UserAgent: userAgent,
		IP:        ip,
		Kind:      req.Kind,
	}
	if err := s.frontErrorLogRepo.Create(ctx, entry); err != nil {
		return fmt.Errorf("前端错误入库失败: %v", err)
	}
	s.frontErrorFile.Write(fmt.Sprintf("[front-error] %s kind=%s url=%s message=%s source=%s stack=%s",
		time.Now().Format("2006-01-02 15:04:05"), entry.Kind, entry.URL, entry.Message, entry.Source, entry.Stack))
	return nil
}

// GetFrontErrorLogList 分页查询前端错误日志
func (s *LogService) GetFrontErrorLogList(ctx context.Context, req dto.FrontErrorLogListRequest) (*dto.FrontErrorLogListResponse, error) {
	logs, total, err := s.frontErrorLogRepo.ListWithFilter(ctx, req.PageNo, req.PageSize, repo.FrontErrorLogListFilter{
		UserID: req.UserID,
		Kind:   req.Kind,
		URL:    req.URL,
	})
	if err != nil {
		return nil, err
	}

	usernameMap := s.batchUsernames(ctx, userIDsOfFrontError(logs))
	list := make([]*dto.FrontErrorLogResponse, 0, len(logs))
	for i := range logs {
		l := logs[i]
		list = append(list, &dto.FrontErrorLogResponse{
			LogID:     l.LogID,
			UserID:    l.UserID,
			Username:  usernameMap[l.UserID],
			Kind:      l.Kind,
			Message:   l.Message,
			Source:    l.Source,
			Stack:     l.Stack,
			URL:       l.URL,
			UserAgent: l.UserAgent,
			IP:        l.IP,
			CreatedAt: helper.TimeToDatetime(l.CreatedAt),
		})
	}
	return &dto.FrontErrorLogListResponse{
		PageNo:      req.PageNo,
		PageSize:    req.PageSize,
		ResultTotal: total,
		List:        list,
	}, nil
}

// batchUsernames 批量查询用户名（user_id → username）
func (s *LogService) batchUsernames(ctx context.Context, userIDs []uint64) map[uint64]string {
	m := make(map[uint64]string)
	for _, uid := range userIDs {
		if _, ok := m[uid]; ok || uid == 0 {
			continue
		}
		if u, _ := s.userRepo.FindByUserID(ctx, uid); u != nil {
			m[uid] = u.Username
		} else {
			m[uid] = "未知用户"
		}
	}
	return m
}

func userIDsOfAccess(logs []model.AccessLog) []uint64 {
	ids := make([]uint64, 0, len(logs))
	for _, l := range logs {
		ids = append(ids, l.UserID)
	}
	return ids
}

func userIDsOfOperation(logs []model.OperationLog) []uint64 {
	ids := make([]uint64, 0, len(logs))
	for _, l := range logs {
		ids = append(ids, l.UserID)
	}
	return ids
}

func userIDsOfFrontError(logs []model.FrontErrorLog) []uint64 {
	ids := make([]uint64, 0, len(logs))
	for _, l := range logs {
		ids = append(ids, l.UserID)
	}
	return ids
}
