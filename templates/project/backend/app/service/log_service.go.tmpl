package service

import (
	"context"
	"errors"
	"fmt"
	"time"

	"github.com/google/wire"

	"{{ .Module }}/app/dto"
	"{{ .Module }}/app/helper"
	"{{ .Module }}/app/model"
	"{{ .Module }}/app/repo"
)

// LogService 系统日志服务（访问日志 + 操作日志 + 前端错误日志）
type LogService struct {
	store             *repo.Store
	accessLogRepo     *repo.AccessLogRepository
	operationLogRepo  *repo.OperationLogRepository
	frontErrorLogRepo *repo.FrontErrorLogRepository
	userRepo          *repo.AdminUserRepository
	frontErrorFile    *helper.DailyLogFile // 前端错误日志文件（按天分割）
}

// LogServiceSet wire provider set
var LogServiceSet = wire.NewSet(NewLogService)

// NewLogService 创建日志服务
func NewLogService(store *repo.Store) *LogService {
	return &LogService{
		store:             store,
		accessLogRepo:     store.AccessLog(),
		operationLogRepo:  store.OperationLog(),
		frontErrorLogRepo: store.FrontErrorLog(),
		userRepo:          store.User(),
		frontErrorFile:    helper.NewDailyLogFile("logs", "front-error"),
	}
}

// ===== 访问日志 =====

// GetAccessLogList 分页查询访问日志
func (s *LogService) GetAccessLogList(ctx context.Context, req dto.AccessLogListRequest) (*dto.AccessLogListResponse, error) {
	logs, total, err := s.accessLogRepo.ListWithFilter(ctx, req.PageNo, req.PageSize, repo.AccessLogListFilter{
		UserID:     req.UserID,
		Method:     req.Method,
		Path:       req.Path,
		StatusCode: req.StatusCode,
		IP:         req.IP,
	})
	if err != nil {
		return nil, err
	}

	usernameMap := s.batchUsernames(ctx, userIDsOfAccess(logs))
	list := make([]*dto.AccessLogResponse, 0, len(logs))
	for i := range logs {
		l := logs[i]
		list = append(list, &dto.AccessLogResponse{
			LogID:        l.LogID,
			UserID:       l.UserID,
			Username:     usernameMap[l.UserID],
			Method:       l.Method,
			Path:         l.Path,
			StatusCode:   l.StatusCode,
			IP:           l.IP,
			UserAgent:    l.UserAgent,
			DurationMs:   l.DurationMs,
			Query:        l.Query,
			RequestBody:  l.RequestBody,
			ResponseBody: l.ResponseBody,
			CreatedAt:    helper.TimeToDatetime(l.CreatedAt),
		})
	}
	return &dto.AccessLogListResponse{
		PageNo:      req.PageNo,
		PageSize:    req.PageSize,
		ResultTotal: total,
		List:        list,
	}, nil
}

