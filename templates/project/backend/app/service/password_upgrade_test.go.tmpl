// 登录时把历史 SHA-256 散列自动升级成 bcrypt 的行为回归。
//
// 为什么不是只测 helper：helper 单测能证明「旧散列校验得过、并且被判定为需要升级」，
// 证不了下面这四件事 —— 而它们才是这次改动的全部风险：
//   - 升级的 UPDATE 真的发出去了（否则「平滑升级」只是注释）；
//   - 它发生在**事务提交之后**、且不自增 auth_version（否则刚签出的会话立刻失效）；
//   - 密码错误时一条写语句都不发（错密码触发写回 = 把别人的密码改成攻击者输入的值）；
//   - 存储值已经是 bcrypt 时不再写回（否则每次登录都多一次写库）。
//
// 做法同 controller 层的回归测试：sqlmock 当连接，跑真的 GORM + repo + service。
// sqlmock 按顺序匹配期望，期望里没登记的写语句一律报「未预期的语句」，
// 「零写入」因此是硬断言而不是靠读代码确认。
//
// 这里不连真实数据库：能证明语句顺序、语句类型和绑定参数，
// 证不了真实 MySQL 下的并发交错结果。
package service

import (
	"context"
	"testing"

	sqlmock "github.com/DATA-DOG/go-sqlmock"
	"gorm.io/driver/mysql"
	"gorm.io/gorm"
	"gorm.io/gorm/logger"

	"{{ .Module }}/app/helper"
	"{{ .Module }}/app/repo"
)

const (
	upgradeUserID  uint64 = 21
	upgradeLoginID uint64 = 88
	// legacySalt / legacyPwd 都是本测试内的合成值
	legacySalt = "0123456789abcdef0123456789abcdef"
	legacyPwd  = "Legacy1pass"
)

// newUpgradeAuthService 按生产方式装配 AuthService，只把 Store 绑到 sqlmock 上。
func newUpgradeAuthService(t *testing.T) (*AuthService, sqlmock.Sqlmock) {
	t.Helper()
	sqlDB, mock, err := sqlmock.New(sqlmock.QueryMatcherOption(sqlmock.QueryMatcherRegexp))
	if err != nil {
		t.Fatalf("创建 sqlmock 失败: %v", err)
	}
	t.Cleanup(func() { _ = sqlDB.Close() })

	db, err := gorm.Open(mysql.New(mysql.Config{Conn: sqlDB, SkipInitializeWithVersion: true}), &gorm.Config{
		Logger:                 logger.Discard,
		DisableAutomaticPing:   true,
		SkipDefaultTransaction: true,
	})
	if err != nil {
		t.Fatalf("GORM 挂载 sqlmock 失败: %v", err)
	}
	return NewAuthService(repo.NewStoreWithDB(db)), mock
}

// expectLoginReads 登记登录校验那两条读：用户行 + username 登录方式行。
func expectLoginReads(mock sqlmock.Sqlmock, credential, salt string) {
	mock.ExpectBegin()
	mock.ExpectQuery("SELECT .* FROM `admin_users`").
		WillReturnRows(sqlmock.NewRows([]string{"user_id", "username", "status", "auth_version"}).
			AddRow(upgradeUserID, "legacy_user", 1, 3))
	mock.ExpectQuery("SELECT .* FROM `admin_user_logins`").
		WillReturnRows(sqlmock.NewRows([]string{"login_id", "user_id", "login_type", "login_credential", "salt", "status"}).
			AddRow(upgradeLoginID, upgradeUserID, "username", credential, salt, 1))
	mock.ExpectCommit()
}

func assertNoUnexpectedStatements(t *testing.T, mock sqlmock.Sqlmock) {
	t.Helper()
	if err := mock.ExpectationsWereMet(); err != nil {
		t.Errorf("SQL 期望未满足（多发或少发了语句）: %v", err)
	}
}

// TestPasswordLogin_UpgradesLegacyHashAfterCommit 旧散列 + 正确密码：
// 登录成功，并且在事务提交之后补发一条带旧值条件的 UPDATE。
func TestPasswordLogin_UpgradesLegacyHashAfterCommit(t *testing.T) {
	s, mock := newUpgradeAuthService(t)
	legacyCredential := helper.LegacyHashPassword(legacyPwd, legacySalt)

	expectLoginReads(mock, legacyCredential, legacySalt)
	// 升级写回：在 Commit **之后**（期望顺序即断言），且只有这一条写语句 ——
	// 没有 admin_users 的 UPDATE，也就是没有自增 auth_version。
	//
	// 这里把 WHERE 的形状写进正则而不是用 WithArgs：GORM 会给 Updates 自动补一个
	// updated_at，绑定参数个数不稳定，但语句形状是稳定的，而「WHERE 带旧散列」
	// 恰恰就是要锁住的那一条。
	mock.ExpectExec("UPDATE `admin_user_logins` SET .*WHERE login_id = \\? AND login_credential = \\?").
		WillReturnResult(sqlmock.NewResult(0, 1))

	user, authVersion, err := s.PasswordLogin(context.Background(), "legacy_user", legacyPwd)
	if err != nil {
		t.Fatalf("旧散列账号应能登录: %v", err)
	}
	if user == nil || user.UserID != upgradeUserID {
		t.Fatalf("返回的用户不对: %+v", user)
	}
	// 升级不改密码，所以认证版本必须还是本次校验所依据的那个快照值
	if authVersion != 3 {
		t.Errorf("认证版本应为校验时的 3（升级不得自增），实际 %d", authVersion)
	}
	assertNoUnexpectedStatements(t, mock)
}

// TestPasswordLogin_UpgradeFailureDoesNotFailLogin 写回失败只记日志：
// 数据库抖一下不能变成「登不进去」。
func TestPasswordLogin_UpgradeFailureDoesNotFailLogin(t *testing.T) {
	s, mock := newUpgradeAuthService(t)
	legacyCredential := helper.LegacyHashPassword(legacyPwd, legacySalt)

	expectLoginReads(mock, legacyCredential, legacySalt)
	mock.ExpectExec("UPDATE `admin_user_logins`").
		WillReturnError(context.DeadlineExceeded)

	if _, _, err := s.PasswordLogin(context.Background(), "legacy_user", legacyPwd); err != nil {
		t.Fatalf("升级写回失败不应影响本次登录，实际返回错误: %v", err)
	}
	assertNoUnexpectedStatements(t, mock)
}

// TestPasswordLogin_UpgradeSkippedWhenCredentialChanged 写回命中 0 行（期间别人改了密码）
// 时安静放弃，不报错、不重试 —— 这正是「不把新密码覆盖回旧密码」的那个分支。
func TestPasswordLogin_UpgradeSkippedWhenCredentialChanged(t *testing.T) {
	s, mock := newUpgradeAuthService(t)
	legacyCredential := helper.LegacyHashPassword(legacyPwd, legacySalt)

	expectLoginReads(mock, legacyCredential, legacySalt)
	mock.ExpectExec("UPDATE `admin_user_logins`").
		WillReturnResult(sqlmock.NewResult(0, 0))

	if _, _, err := s.PasswordLogin(context.Background(), "legacy_user", legacyPwd); err != nil {
		t.Fatalf("凭证已被改写时登录仍应成功: %v", err)
	}
	assertNoUnexpectedStatements(t, mock)
}

// TestPasswordLogin_WrongPasswordWritesNothing 密码错误：登录被拒，且一条写语句都没有。
//
// 这是本组里最重要的一条。期望里只登记了两条 SELECT，任何 UPDATE 都会被 sqlmock
// 当成未预期的语句而让测试失败 —— 所以「错密码不触发升级」是被证明的，不是约定的。
func TestPasswordLogin_WrongPasswordWritesNothing(t *testing.T) {
	s, mock := newUpgradeAuthService(t)
	legacyCredential := helper.LegacyHashPassword(legacyPwd, legacySalt)

	mock.ExpectBegin()
	mock.ExpectQuery("SELECT .* FROM `admin_users`").
		WillReturnRows(sqlmock.NewRows([]string{"user_id", "username", "status", "auth_version"}).
			AddRow(upgradeUserID, "legacy_user", 1, 3))
	mock.ExpectQuery("SELECT .* FROM `admin_user_logins`").
		WillReturnRows(sqlmock.NewRows([]string{"login_id", "user_id", "login_type", "login_credential", "salt", "status"}).
			AddRow(upgradeLoginID, upgradeUserID, "username", legacyCredential, legacySalt, 1))
	mock.ExpectRollback()

	if _, _, err := s.PasswordLogin(context.Background(), "legacy_user", "Wrong1pass"); err == nil {
		t.Fatal("错误密码不该登录成功")
	}
	assertNoUnexpectedStatements(t, mock)
}

// TestPasswordLogin_BcryptHashNeedsNoWrite 存储值已经是 bcrypt：不再写回。
// 否则每次登录都多一条 UPDATE，高频路径上白加一次写库和一次行锁。
func TestPasswordLogin_BcryptHashNeedsNoWrite(t *testing.T) {
	s, mock := newUpgradeAuthService(t)
	hashed, err := helper.HashPassword(legacyPwd)
	if err != nil {
		t.Fatalf("构造 bcrypt 散列失败: %v", err)
	}

	expectLoginReads(mock, hashed, "")

	if _, _, err := s.PasswordLogin(context.Background(), "legacy_user", legacyPwd); err != nil {
		t.Fatalf("bcrypt 账号应能登录: %v", err)
	}
	assertNoUnexpectedStatements(t, mock)
}
