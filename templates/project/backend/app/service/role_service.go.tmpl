// AdminRoleService RBAC 角色权限服务
type AdminRoleService struct {
	roleRepo           *repo.AdminRoleRepository
	permissionRepo     *repo.AdminPermissionsRepository
	rolePermissionRepo *repo.AdminRolePermissionsRepository
	userRoleRepo       *repo.AdminUserRoleRepository
	store              *repo.Store
}

// AdminRoleServiceSet wire provider set（构造函数，内部手动装配仓储）
var AdminRoleServiceSet = wire.NewSet(NewAdminRoleService)

// NewAdminRoleService 创建角色权限服务
func NewAdminRoleService(store *repo.Store) *AdminRoleService {
	return &AdminRoleService{
		roleRepo:           store.Role(),
		permissionRepo:     store.Permission(),
		rolePermissionRepo: store.RolePermission(),
		userRoleRepo:       store.UserRole(),
		store:              store,
	}
}

// IsUserSuperAdmin 检查用户是否是超级管理员。
//
// 这里要求 super_admin 角色**启用中**（role.Status == 1）：它回答的是「这个人有没有
// 超管权力」，禁用角色不授予任何权力，和 FindUserPermissions 过滤禁用角色是同一条口径。
//
// 与 user_guard.go 里「目标账号是否受保护」的判定方向刻意相反 —— 那边不看角色状态，
// 否则把 super_admin 禁用一下就能改超管的密码。给权力要严、保护要宽。
func (s *AdminRoleService) IsUserSuperAdmin(ctx context.Context, userID uint64) (bool, error) {
	userRoles, err := s.userRoleRepo.FindByUserID(ctx, userID)
	if err != nil {
		// 身份查不出来一律按「不是超管」返回错误，让调用方拒绝（fail closed），
		// 不能把一次数据库抖动变成一次放行。
		return false, err
	}
	for _, userRole := range userRoles {
		role, err := s.roleRepo.FindByRoleIDAnyStatus(ctx, userRole.RoleID)
		if err != nil {
			return false, err
		}
		if role != nil && role.RoleCode == constants.SuperAdminRoleCode && role.Status == constants.RoleStatusEnabled {
			return true, nil
		}
	}
	return false, nil
}

// GetUserAllPermissions 获取用户的**有效权限**（去重）。
//
// 一条 join 直接取：只算启用角色名下的启用权限（见 repo.FindUserPermissions 的
// r.status / p.status 两个条件）。这是**有效权限的唯一来源**：接口权限校验与
// 菜单、按钮下发都从这里取数，不要在调用方另开一条「从关联表自己拼权限」的路
// —— 那样过滤条件就会分叉。
//
// 注意它返回的是「被直接授权的那些权限行」（下文称**有效叶子**）。菜单树还需要
// 祖先节点才能挂得起来，那部分由 collectMenuParentRecursive 另外补查，
// 规则见 GetUserMenusAndButtons 的说明 —— 补查只补结构，不扩授权。
func (s *AdminRoleService) GetUserAllPermissions(ctx context.Context, userID uint64) ([]model.AdminPermissions, error) {
	return s.userRoleRepo.FindUserPermissions(ctx, userID)
}

// GetUserMenusAndButtons 获取用户有权限的菜单树和按钮权限列表。
//
// 非超管的**授权来源**只有 GetUserAllPermissions（启用角色 × 启用权限），所以
// 「角色被禁用」的效果是菜单和按钮一起消失，不需要在这里再写一遍角色状态判断。
//
// 但别把它说成「完全没有第二次查询」—— 菜单树需要祖先节点才挂得起来，
// collectMenuParentRecursive 会按 parent_id 再查 admin_permissions
// （FindByPermissionID，SQL 不带状态条件）。这次补查**不是**第二条授权路径，
// 因为它受两条约束夹住：
//
//   - **只为已授权的后代补全**：递归的起点全部来自 GetUserAllPermissions 的结果。
//     没有任何有效后代时（比如角色被禁用，那条查询一行都不返回），递归根本不执行 ——
//     所以「借祖先补查让菜单冒出来」这条路不存在；
//   - **祖先自身必须启用**：parent.Status != 1 就地停住，既不收集这个祖先、
//     也不再往上走。于是禁用的祖先不会被补出来（它下面那条有效子菜单会变成
//     挂不上根的孤儿节点，由 buildFrontendMenuTree 丢弃）。
//
// 下面两处 `Status != 1` / `Status == 1` 过滤的是**权限行自身**的状态，是另一层。
func (s *AdminRoleService) GetUserMenusAndButtons(ctx context.Context, userID uint64) (dto.UserMenuButtonResponse, error) {
	response := dto.UserMenuButtonResponse{
		Menus:   make([]*dto.MenuNode, 0),
		Buttons: make([]string, 0),
	}

	isSuperAdmin, err := s.IsUserSuperAdmin(ctx, userID)
	if err != nil {
		return response, err
	}

	var userPermissions []model.AdminPermissions
	if isSuperAdmin {
		userPermissions, err = s.permissionRepo.ListActive(ctx)
		if err != nil {
			return response, err
		}
	} else {
		originPerms, err := s.GetUserAllPermissions(ctx, userID)
		if err != nil {
			return response, err
		}
		permIDMap := make(map[uint64]*model.AdminPermissions)
		for i := range originPerms {
			permIDMap[originPerms[i].PermissionID] = &originPerms[i]
		}
		for i := range originPerms {
			if err := s.collectMenuParentRecursive(ctx, &originPerms[i], permIDMap); err != nil {
				return response, err
			}
		}
		userPermissions = make([]model.AdminPermissions, 0, len(permIDMap))
		for _, v := range permIDMap {
			userPermissions = append(userPermissions, *v)
		}
	}

	menuPermissions := make([]model.AdminPermissions, 0)
	buttonPermissions := make([]model.AdminPermissions, 0)
	for _, perm := range userPermissions {
		if perm.Status != 1 {
			continue
		}
		switch perm.PermissionType {
		case constants.PermissionTypeMenu:
			menuPermissions = append(menuPermissions, perm)
		case constants.PermissionTypeButton:
			buttonPermissions = append(buttonPermissions, perm)
		}
	}

	response.Menus = s.buildFrontendMenuTree(menuPermissions)

	if isSuperAdmin {
		for _, b := range buttonPermissions {
			response.Buttons = append(response.Buttons, b.PermissionCode)
		}
	} else {
		originPerms, err := s.GetUserAllPermissions(ctx, userID)
		if err != nil {
			return response, err
		}
		for _, p := range originPerms {
			if p.Status == 1 && p.PermissionType == constants.PermissionTypeButton {
				response.Buttons = append(response.Buttons, p.PermissionCode)
			}
		}
	}

	return response, nil
}

// collectMenuParentRecursive 为一条**已授权**的权限向上补全祖先菜单节点。
//
// 只补结构、不扩授权：调用方传进来的 perm 必须来自 GetUserAllPermissions 的结果，
// 所以没有有效后代时这个函数不会被调到。祖先自身 Status != 1 就地返回 ——
// 禁用的祖先不补出来，也不继续往上找。
func (s *AdminRoleService) collectMenuParentRecursive(ctx context.Context, perm *model.AdminPermissions, collectMap map[uint64]*model.AdminPermissions) error {
	if perm.ParentID == 0 {
		return nil
	}
	if _, ok := collectMap[perm.ParentID]; ok {
		return nil
	}
	parent, err := s.permissionRepo.FindByPermissionID(ctx, perm.ParentID)
	if err != nil || parent == nil || parent.Status != 1 {
		return err
	}
	collectMap[parent.PermissionID] = parent
	return s.collectMenuParentRecursive(ctx, parent, collectMap)
}

func (s *AdminRoleService) buildFrontendMenuTree(menuPermissions []model.AdminPermissions) []*dto.MenuNode {
	if len(menuPermissions) == 0 {
		return make([]*dto.MenuNode, 0)
	}

	treeMap := make(map[uint64]*dto.MenuNode)
	for _, perm := range menuPermissions {
		node := &dto.MenuNode{
			Name:     perm.PermissionName,
			Code:     perm.PermissionCode,
			Sort:     perm.SortOrder,
			Mode:     []string{"tree"},
			Icon:     perm.Icon,
			Children: make([]*dto.MenuNode, 0),
		}
		if perm.Path != "" {
			node.Link = perm.Path
		}
		treeMap[perm.PermissionID] = node
	}

	var roots []*dto.MenuNode
	for _, perm := range menuPermissions {
		node := treeMap[perm.PermissionID]
		if perm.ParentID == 0 {
			roots = append(roots, node)
		} else if parent, exists := treeMap[perm.ParentID]; exists {
			parent.Children = append(parent.Children, node)
		}
	}

	s.sortFrontendMenuTree(roots)
	return roots
}

func (s *AdminRoleService) sortFrontendMenuTree(nodes []*dto.MenuNode) {
	if len(nodes) == 0 {
		return
	}
	sort.Slice(nodes, func(a, b int) bool { return nodes[a].Sort < nodes[b].Sort })
	for _, node := range nodes {
		s.sortFrontendMenuTree(node.Children)
	}
}

// ==================== 角色 CRUD ====================

// GetRoleList 获取角色列表（分页，支持名称模糊 + 状态过滤）
func (s *AdminRoleService) GetRoleList(ctx context.Context, page, pageSize int, roleName string, status int) (*dto.RoleListResponse, error) {
	roles, total, err := s.roleRepo.ListWithFilter(ctx, page, pageSize, repo.AdminRoleListFilter{
		RoleName: roleName,
		Status:   status,
	})
	if err != nil {
		return nil, err
	}

	items := make([]*dto.RoleListResponseItem, 0, len(roles))
	for i := range roles {
		r := roles[i]
		items = append(items, &dto.RoleListResponseItem{
			RoleID:      r.RoleID,
			RoleName:    r.RoleName,
			RoleCode:    r.RoleCode,
			Description: r.Description,
			SortOrder:   r.SortOrder,
			Status:      r.Status,
			IsSystem:    r.IsSystem,
			UpdatedAt:   r.UpdatedAt.Format("2006-01-02 15:04:05"),
			CreatedAt:   r.CreatedAt.Format("2006-01-02 15:04:05"),
		})
	}

	return &dto.RoleListResponse{
		PageNo:      page,
		PageSize:    pageSize,
		ResultTotal: total,
		List:        items,
	}, nil
}

// AddRole 新增角色（含权限关联，事务整体提交）
func (s *AdminRoleService) AddRole(ctx context.Context, req *dto.AddRoleRequest) error {
	if err := CheckNewRoleCode(req.RoleCode); err != nil {
		return err
	}
	existing, err := s.roleRepo.FindByRoleCode(ctx, req.RoleCode)
	if err != nil {
		return err
	}
	if existing != nil {
		return errors.New("角色编码已存在")
	}
	existing, err = s.roleRepo.FindByRoleName(ctx, req.RoleName)
	if err != nil {
		return err
	}
	if existing != nil {
		return errors.New("角色名称已存在")
	}

	// 事务前校验权限 ID（只读，避免事务内校验失败才回滚）
	for _, permID := range req.PermissionIDs {
		perm, err := s.permissionRepo.FindByPermissionID(ctx, permID)
		if err != nil {
			return err
		}
		if perm == nil {
			return errors.New("权限ID不存在")
		}
	}

	// 建角色 + 建权限关联，任一失败整体回滚
	return s.store.RunInTx(ctx, func(tx *repo.Tx) error {
		role := &model.AdminRole{
			RoleName:    req.RoleName,
			RoleCode:    req.RoleCode,
			Description: req.Description,
			SortOrder:   req.SortOrder,
			Status:      1,
			// is_system 永远是 0：系统角色只能由初始化 SQL 定义，
			// 不接受接口入参，否则调用方可以自己造一个「不可删改」的角色。
			IsSystem: 0,
		}
		if err := tx.Role().Create(ctx, role); err != nil {
			return err
		}
		for _, permID := range req.PermissionIDs {
			if err := tx.RolePermission().Create(ctx, &model.AdminRolePermissions{RoleID: role.RoleID, PermissionID: permID}); err != nil {
				return err
			}
		}
		return nil
	})
}

// UpdateRole 更新角色（名称 + 权限，事务整体提交）
func (s *AdminRoleService) UpdateRole(ctx context.Context, req *dto.UpdateRoleRequest) error {
	role, err := s.roleRepo.FindByRoleIDAnyStatus(ctx, req.RoleID)
	if err != nil {
		return err
	}
	if err := CheckRoleMutable(role, "修改"); err != nil {
		return err
	}

	// 事务前校验权限 ID（只读）
	for _, permID := range req.PermissionIDs {
		perm, err := s.permissionRepo.FindByPermissionID(ctx, permID)
		if err != nil {
			return err
		}
		if perm == nil {
			return errors.New("权限ID不存在")
		}
	}

	// 改名 + 删旧权限 + 加新权限，任一失败整体回滚
	return s.store.RunInTx(ctx, func(tx *repo.Tx) error {
		if req.RoleName != "" {
			if err := tx.Role().UpdateByID(ctx, req.RoleID, map[string]interface{}{"role_name": req.RoleName}); err != nil {
				return err
			}
		}
		oldRPs, err := tx.RolePermission().FindByRoleID(ctx, req.RoleID)
		if err != nil {
			return err
		}
		for _, rp := range oldRPs {
			if err := tx.RolePermission().Delete(ctx, &rp); err != nil {
				return err
			}
		}
		for _, permID := range req.PermissionIDs {
			if err := tx.RolePermission().Create(ctx, &model.AdminRolePermissions{RoleID: req.RoleID, PermissionID: permID}); err != nil {
				return err
			}
		}
		return nil
	})
}

// DeleteRole 删除角色（系统角色不能删，绑定用户不能删；事务整体提交）
func (s *AdminRoleService) DeleteRole(ctx context.Context, roleID uint64) error {
	role, err := s.roleRepo.FindByRoleIDAnyStatus(ctx, roleID)
	if err != nil {
		return err
	}
	if err := CheckRoleMutable(role, "删除"); err != nil {
		return err
	}
	userRoles, err := s.userRoleRepo.FindByRoleID(ctx, roleID)
	if err != nil {
		return err
	}
	if len(userRoles) > 0 {
		return errors.New("该角色已绑定用户，无法删除")
	}

	// 删权限关联 + 删角色，任一失败整体回滚
	return s.store.RunInTx(ctx, func(tx *repo.Tx) error {
		rolePermissions, err := tx.RolePermission().FindByRoleID(ctx, roleID)
		if err != nil {
			return err
		}
		for _, rp := range rolePermissions {
			if err := tx.RolePermission().Delete(ctx, &rp); err != nil {
				return err
			}
		}
		return tx.Role().Delete(ctx, role)
	})
}

// UpdateRoleStatus 更新角色状态（角色必须存在，系统角色不能改状态）
func (s *AdminRoleService) UpdateRoleStatus(ctx context.Context, roleID uint64, status int) error {
	if status != int(constants.UserStatusEnabled) && status != int(constants.UserStatusDisabled) {
		return errors.New("状态值必须为0(禁用)或1(启用)")
	}
	role, err := s.roleRepo.FindByRoleIDAnyStatus(ctx, roleID)
	if err != nil {
		return err
	}
	// 原来这里直接 UPDATE，角色不存在也返回成功，系统角色也能被禁用；
	// 禁用 super_admin 等于把整套权限体系锁死。
	if err := CheckRoleMutable(role, "禁用或启用"); err != nil {
		return err
	}
	return s.roleRepo.UpdateByID(ctx, roleID, map[string]interface{}{"status": status})
}

// ==================== 用户角色 ====================

// GetUserRolesAndPermissions 获取用户角色和权限。
//
// 返回的 Roles 是「全部启用角色」**并上**「该用户当前真实持有的角色（含已禁用）」：
// 只列启用角色的话，用户持有的某个角色一旦被禁用，编辑页就看不到这条关联、
// 回显出来的 role_ids 里也没有它，保存资料时整体替换就把这条关联顺手删了 ——
// 一次「改昵称」变成一次静默的角色撤销。所以持有中的禁用角色必须一起带出来，
// 由前端显示成「已禁用」并保持勾选（新增禁用角色仍由服务端 CheckRoleStatusAssignable 拒绝）。
//
// 返回的 AllPermissions 是**回显用途**：它按「这些角色挂着哪些权限」逐个关联查出来，
// 刻意不按角色状态过滤（禁用角色名下的权限也要能在编辑页看到）。
// 它**不是**有效权限，不要拿它做任何鉴权判定 —— 鉴权只认 GetUserAllPermissions
// （→ repo.FindUserPermissions，带 r.status / p.status 过滤）。
// 同理 GetEditRoleInfo 的权限树也只是展示。
func (s *AdminRoleService) GetUserRolesAndPermissions(ctx context.Context, userID uint64) (dto.UserRoleDetailResponse, error) {
	response := dto.UserRoleDetailResponse{
		UserID:         userID,
		Roles:          make([]dto.UserRoleDetail, 0),
		AllPermissions: make([]model.AdminPermissions, 0),
	}

	allRoles, err := s.roleRepo.ListActive(ctx)
	if err != nil {
		return response, err
	}
	userRoles, err := s.userRoleRepo.FindByUserID(ctx, userID)
	if err != nil {
		return response, err
	}
	userRoleIDMap := make(map[uint64]bool)
	for _, ur := range userRoles {
		userRoleIDMap[ur.RoleID] = true
	}

	// 把「持有中但不在启用列表里」的角色补进来（通常就是被禁用的角色）。
	// 以库里的关联表为准，不依赖前端把它回传。
	listedIDs := make(map[uint64]bool, len(allRoles))
	for _, role := range allRoles {
		listedIDs[role.RoleID] = true
	}
	for _, ur := range userRoles {
		if listedIDs[ur.RoleID] {
			continue
		}
		role, err := s.roleRepo.FindByRoleIDAnyStatus(ctx, ur.RoleID)
		if err != nil {
			return response, err
		}
		if role == nil {
			continue // 角色行已被删除，关联是孤儿，不展示
		}
		listedIDs[role.RoleID] = true
		allRoles = append(allRoles, *role)
	}

	permissionMap := make(map[uint64]model.AdminPermissions)
	for _, role := range allRoles {
		response.Roles = append(response.Roles, dto.UserRoleDetail{Role: role, Checked: userRoleIDMap[role.RoleID]})
		if !userRoleIDMap[role.RoleID] {
			continue
		}
		rps, err := s.rolePermissionRepo.FindByRoleID(ctx, role.RoleID)
		if err != nil {
			return response, err
		}
		for _, rp := range rps {
			perm, err := s.permissionRepo.FindByPermissionID(ctx, rp.PermissionID)
			if err != nil {
				return response, err
			}
			if perm == nil {
				continue
			}
			permissionMap[perm.PermissionID] = *perm
		}
	}

	response.AllPermissions = make([]model.AdminPermissions, 0, len(permissionMap))
	for _, p := range permissionMap {
		response.AllPermissions = append(response.AllPermissions, p)
	}
	return response, nil
}

// UpdateUserRoles 更新用户角色（整体替换，一个事务）。
//
// operatorID 是发起操作的人（来自 JWT）。三道判定都在写入之前、且在同一个事务里：
//   - 目标账号保护：非超管不能动持有超管角色的账号（guardUserWrite）；
//   - 角色变更保护：非超管不能增删受保护角色，既包括「给自己或别人加超管」，
//     也包括「把别人的超管摘掉」（CheckRoleAssignmentAllowed）；
//   - 角色状态保护：不能新增已禁用的角色，但目标已经持有的禁用角色可以原样保留
//     （CheckRoleStatusAssignable）。
//
// 本方法是整体替换语义：roleIDs 为空表示清空该用户的角色关联。
// 调用方若想表达「本次不动角色」，不要传空切片，而是干脆不调它
// （资料编辑见 dto.UpdateUserRequest.RolesProvided 的约定）。
//
// 判定所依据的事实（操作人是否超管、目标现有角色、目标角色是否受保护）一律从库里
// 的关联表读，不看入参 role_ids 之外的任何调用方声明。读的方式也有讲究：
// guardUserWrite 先按固定顺序锁住操作人与目标的用户行，再**加锁当前读**身份，
// 所以「我读到目标不是超管 → 别人把超管授给他 → 我按旧事实写」这条竞态被锁挡在外面；
// 用普通读（事务快照）做不到这一点，它看不见并发已提交的授权。
//
// 这也是「新增用户之后赋角色」走的入口（AddUser 只建账号不赋角色），
// 所以目标此刻可能一条角色关联都没有 —— 锁锚在用户行上，空角色同样锁得住。
func (s *AdminRoleService) UpdateUserRoles(ctx context.Context, operatorID, userID uint64, roleIDs []uint64) error {
	return s.store.RunInTx(ctx, func(tx *repo.Tx) error {
		g, err := guardUserWrite(ctx, tx, operatorID, userID)
		if err != nil {
			return err
		}
		next, err := txRoleFactsByIDs(ctx, tx, roleIDs)
		if err != nil {
			return err
		}
		if err := CheckRoleAssignmentAllowed(g.OperatorIsSuperAdmin, g.TargetRoleFacts, next); err != nil {
			return err
		}
		if err := CheckRoleStatusAssignable(g.TargetRoleFacts, next); err != nil {
			return err
		}
		return replaceUserRolesTx(ctx, tx, userID, roleIDs)
	})
}

// txRoleFactsByIDs 校验这组角色 ID 都存在，并取出判定要素（事务作用域）。
// 不存在的角色一律报错而不是跳过：否则「传个不存在的 ID」会变成静默少赋一个角色。
//
// 用 FOR SHARE 当前读：这些角色事实（is_system、role_code、status）直接决定「能不能赋」，
// 读到事务快照里的旧值就可能把一个刚被改过的角色按旧事实放过去；共享锁还保证
// 判定到写入之间这些角色行不被改。不用排他锁 —— 这里只读角色、不写角色。
//
// **不过滤 status**：禁用角色也要能查出来，否则「目标账号已经持有某个后来被禁用的
// 角色」在编辑页提交时会被当成「角色ID不存在」而整笔失败。状态该怎么判定交给
// CheckRoleStatusAssignable（已持有可保留、新增一律拒绝），不在查询里悄悄过滤。
func txRoleFactsByIDs(ctx context.Context, tx *repo.Tx, roleIDs []uint64) ([]RoleFact, error) {
	facts := make([]RoleFact, 0, len(roleIDs))
	for _, roleID := range roleIDs {
		role, err := tx.Role().FindByRoleIDAnyStatusForShare(ctx, roleID)
		if err != nil {
			return nil, err
		}
		if role == nil {
			return nil, errors.New("角色ID不存在")
		}
		facts = append(facts, RoleFactOf(role))
	}
	return facts, nil
}

// replaceUserRolesTx 用 roleIDs 整体替换该用户的角色关联（事务作用域）。
// 只负责写，不做任何授权判定 —— 调用方必须已经在同一事务内判定过，
// 且必须已经通过 guardUserWrite 锁住了这个用户行。
//
// 删除按 user_id 条件一次删掉，不是「先查出关联行再按主键逐行删」：
// 逐行删只删得掉自己读到的那份快照里的行，快照之后新插入的关联行会原样留下，
// 「整体替换」就变成了「替换 + 多出一个本次没打算赋的角色」。
func replaceUserRolesTx(ctx context.Context, tx *repo.Tx, userID uint64, roleIDs []uint64) error {
	if err := tx.UserRole().DeleteByUserID(ctx, userID); err != nil {
		return err
	}
	for _, roleID := range roleIDs {
		if err := tx.UserRole().Create(ctx, &model.AdminUserRole{UserID: userID, RoleID: roleID}); err != nil {
			return err
		}
	}
	return nil
}

// GetEditRoleInfo 获取编辑角色信息（角色字段 + 全量权限树，当前角色拥有的权限标记选中）
func (s *AdminRoleService) GetEditRoleInfo(ctx context.Context, roleID uint64) (*dto.EditRoleInfoResponse, error) {
	role, err := s.roleRepo.FindByRoleIDAnyStatus(ctx, roleID)
	if err != nil {
		return nil, err
	}
	if role == nil {
		return nil, errors.New("角色不存在")
	}

	// 全量启用权限
	allPermissions, err := s.permissionRepo.ListActive(ctx)
	if err != nil {
		return nil, err
	}

	// 当前角色拥有的权限 ID 集合
	rolePermissions, err := s.rolePermissionRepo.FindByRoleID(ctx, roleID)
	if err != nil {
		return nil, err
	}
	checkedMap := make(map[uint64]bool, len(rolePermissions))
	for _, rp := range rolePermissions {
		checkedMap[rp.PermissionID] = true
	}

	return &dto.EditRoleInfoResponse{
		RoleID:      role.RoleID,
		RoleName:    role.RoleName,
		RoleCode:    role.RoleCode,
		Description: role.Description,
		SortOrder:   role.SortOrder,
		Status:      role.Status,
		IsSystem:    role.IsSystem,
		AddTime:     role.CreatedAt.Format("2006-01-02 15:04:05"),
		UpdateTime:  role.UpdatedAt.Format("2006-01-02 15:04:05"),
		Permissions: buildEditPermissionTree(allPermissions, checkedMap),
	}, nil
}

// buildEditPermissionTree 构建编辑权限树（标记选中状态）
func buildEditPermissionTree(allPermissions []model.AdminPermissions, checkedMap map[uint64]bool) []*dto.EditRolePermissionTree {
	treeMap := make(map[uint64]*dto.EditRolePermissionTree, len(allPermissions))
	for i := range allPermissions {
		p := allPermissions[i]
		treeMap[p.PermissionID] = &dto.EditRolePermissionTree{
			PermissionID:   p.PermissionID,
			ParentID:       p.ParentID,
			PermissionName: p.PermissionName,
			PermissionCode: p.PermissionCode,
			PermissionType: p.PermissionType,
			Path:           p.Path,
			Icon:           p.Icon,
			SortOrder:      p.SortOrder,
			Status:         p.Status,
			IsSystem:       p.IsSystem,
			Checked:        checkedMap[p.PermissionID],
			Children:       make([]*dto.EditRolePermissionTree, 0),
		}
	}

	var roots []*dto.EditRolePermissionTree
	for _, p := range allPermissions {
		node := treeMap[p.PermissionID]
		if p.ParentID == 0 {
			roots = append(roots, node)
		} else if parent, ok := treeMap[p.ParentID]; ok {
			parent.Children = append(parent.Children, node)
		}
	}
	sortEditPermissionTree(roots)
	return roots
}

// sortEditPermissionTree 递归按 sort_order 排序权限树
func sortEditPermissionTree(nodes []*dto.EditRolePermissionTree) {
	if len(nodes) == 0 {
		return
	}
	sort.Slice(nodes, func(a, b int) bool { return nodes[a].SortOrder < nodes[b].SortOrder })
	for _, n := range nodes {
		sortEditPermissionTree(n.Children)
	}
}
