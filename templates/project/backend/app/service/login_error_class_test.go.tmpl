// 登录失败的分类回归：凭证 / 账号状态导致的拒绝必须原文返回、不归入 ErrLoginBackend；
// 事务中途的数据库错误必须归入 ErrLoginBackend，由控制器转成通用提示。
// 分错类的两个方向都有代价：拒绝被当成后端错误，用户看不到「用户名或密码错误」；
// 后端错误被当成拒绝，内部错误文本就会原样回到客户端。
package service

import (
	"context"
	"errors"
	"strings"
	"testing"

	sqlmock "github.com/DATA-DOG/go-sqlmock"

	"{{ .Module }}/app/helper"
)

func TestPasswordLogin_RejectionsAreNotBackendErrors(t *testing.T) {
	hashed, err := helper.HashPassword(legacyPwd)
	if err != nil {
		t.Fatalf("构造 bcrypt 散列失败: %v", err)
	}
	cases := []struct {
		name     string
		password string
		expect   func(sqlmock.Sqlmock)
		message  string
	}{
		{
			name:     "用户不存在",
			password: legacyPwd,
			expect: func(mock sqlmock.Sqlmock) {
				mock.ExpectQuery("SELECT .* FROM `admin_users`").
					WillReturnRows(sqlmock.NewRows([]string{"user_id", "username", "status", "auth_version"}))
			},
			message: "用户名或密码错误",
		},
		{
			name:     "密码错误",
			password: "Wrong1pass",
			expect: func(mock sqlmock.Sqlmock) {
				mock.ExpectQuery("SELECT .* FROM `admin_users`").
					WillReturnRows(sqlmock.NewRows([]string{"user_id", "username", "status", "auth_version"}).
						AddRow(upgradeUserID, "legacy_user", 1, 3))
				mock.ExpectQuery("SELECT .* FROM `admin_user_logins`").
					WillReturnRows(sqlmock.NewRows([]string{"login_id", "user_id", "login_type", "login_credential", "salt", "status"}).
						AddRow(upgradeLoginID, upgradeUserID, "username", hashed, "", 1))
			},
			message: "用户名或密码错误",
		},
		{
			name:     "账号被禁用",
			password: legacyPwd,
			expect: func(mock sqlmock.Sqlmock) {
				mock.ExpectQuery("SELECT .* FROM `admin_users`").
					WillReturnRows(sqlmock.NewRows([]string{"user_id", "username", "status", "auth_version"}).
						AddRow(upgradeUserID, "legacy_user", 0, 3))
				mock.ExpectQuery("SELECT .* FROM `admin_user_logins`").
					WillReturnRows(sqlmock.NewRows([]string{"login_id", "user_id", "login_type", "login_credential", "salt", "status"}).
						AddRow(upgradeLoginID, upgradeUserID, "username", hashed, "", 1))
			},
			message: "账号状态非法",
		},
	}
	for _, tc := range cases {
		t.Run(tc.name, func(t *testing.T) {
			s, mock := newUpgradeAuthService(t)
			mock.ExpectBegin()
			tc.expect(mock)
			mock.ExpectRollback()

			_, _, err := s.PasswordLogin(context.Background(), "legacy_user", tc.password)
			if err == nil || err.Error() != tc.message {
				t.Fatalf("应以原文案 %q 拒绝，实际 %v", tc.message, err)
			}
			if errors.Is(err, ErrLoginBackend) {
				t.Fatalf("登录拒绝不能被归为后端错误: %v", err)
			}
			assertNoUnexpectedStatements(t, mock)
		})
	}
}

func TestPasswordLogin_QueryErrorsAreBackendErrors(t *testing.T) {
	const detail = "dial tcp 10.0.0.9:3306: internal-detail-marker"
	cases := []struct {
		name   string
		expect func(sqlmock.Sqlmock)
	}{
		{
			name: "用户表查询出错",
			expect: func(mock sqlmock.Sqlmock) {
				mock.ExpectQuery("SELECT .* FROM `admin_users`").WillReturnError(errors.New(detail))
			},
		},
		{
			name: "凭证表查询出错",
			expect: func(mock sqlmock.Sqlmock) {
				mock.ExpectQuery("SELECT .* FROM `admin_users`").
					WillReturnRows(sqlmock.NewRows([]string{"user_id", "username", "status", "auth_version"}).
						AddRow(upgradeUserID, "legacy_user", 1, 3))
				mock.ExpectQuery("SELECT .* FROM `admin_user_logins`").WillReturnError(errors.New(detail))
			},
		},
	}
	for _, tc := range cases {
		t.Run(tc.name, func(t *testing.T) {
			s, mock := newUpgradeAuthService(t)
			mock.ExpectBegin()
			tc.expect(mock)
			mock.ExpectRollback()

			_, _, err := s.PasswordLogin(context.Background(), "legacy_user", legacyPwd)
			if !errors.Is(err, ErrLoginBackend) {
				t.Fatalf("事务中途的查询错误应归为 ErrLoginBackend，实际 %v", err)
			}
			// 详细原因保留在错误链里供服务端日志使用；是否回给客户端由控制器决定。
			if !strings.Contains(err.Error(), "internal-detail-marker") {
				t.Fatalf("后端错误应保留原始原因供日志排查，实际 %v", err)
			}
			assertNoUnexpectedStatements(t, mock)
		})
	}
}
