// 散列升级写回的 SQL 形状测试。
//
// 为什么必须测语句本身：这次写回的安全性**完全**依赖 WHERE 里那个
// `login_credential = ?` 条件。少了它，登录校验到写回之间如果有人改了密码
// （本人改密 / 管理员重置），这条 UPDATE 就会用旧密码的 bcrypt 把新密码覆盖掉 ——
// 等于把密码悄悄改回去，而且登录照样成功，从接口上一点看不出来。
// Go 代码层面「带条件」和「不带条件」的签名完全一样，差别只在生成的 SQL 里。
//
// 用真实的 MySQL dialector + DryRun：和生产同一套 SQL 构建，只构建不执行。
//
// 边界：这里证明的是「语句带了旧值条件、salt 被写空串」。
// 「MySQL 真的在并发下只让一条 UPDATE 命中」属于真库行为，不在本测试范围内。
package repo

import (
	"context"
	"strings"
	"testing"

	"golang.org/x/crypto/bcrypt"
	"gorm.io/gorm"
)

// captureUpdateSQL 跑一遍仓储的更新方法，返回 GORM 构建出的 UPDATE 语句与绑定参数。
func captureUpdateSQL(t *testing.T, run func(db *gorm.DB) error) (string, []interface{}) {
	t.Helper()
	db := newDryRunDB(t)

	var (
		sql  string
		vars []interface{}
	)
	if err := db.Callback().Update().After("gorm:update").Register("test:capture_update", func(tx *gorm.DB) {
		if tx.Statement != nil && tx.Statement.SQL.Len() > 0 {
			sql = tx.Statement.SQL.String()
			vars = tx.Statement.Vars
		}
	}); err != nil {
		t.Fatalf("注册 update 回调失败: %v", err)
	}

	if err := run(db); err != nil {
		t.Fatalf("仓储方法执行失败: %v", err)
	}
	if sql == "" {
		t.Fatal("没有捕获到 UPDATE 语句：仓储方法没有走到 gorm:update 回调")
	}
	return sql, vars
}

func TestUpgradeCredentialSQL_GuardsOnOldValue(t *testing.T) {
	const (
		loginID = uint64(7)
		oldHash = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
		newHash = "$2a$10$0123456789012345678901uGZ1yd9Qq0zq0zq0zq0zq0zq0zq0zq0z"
	)

	sql, vars := captureUpdateSQL(t, func(db *gorm.DB) error {
		_, err := NewAdminUserLoginRepositoryWithDB(db).
			UpgradeCredentialIfUnchanged(context.Background(), loginID, oldHash, newHash)
		return err
	})

	if !strings.Contains(sql, "`admin_user_logins`") {
		t.Fatalf("更新没有落在 admin_user_logins 上。SQL: %s", sql)
	}
	for _, want := range []struct {
		fragment string
		why      string
	}{
		{"login_id = ?", "必须按主键定位，不能按 user_id 之类的宽条件批量改"},
		{"login_credential = ?", "WHERE 必须带上刚校验过的旧散列：这是防止覆盖新密码的唯一屏障"},
		{"`login_credential`=?", "SET 里要写新散列"},
		{"`salt`=?", "SET 里要把 salt 一起写掉，不能留下「bcrypt 散列 + 旧盐」的矛盾行"},
	} {
		if !strings.Contains(sql, want.fragment) {
			t.Errorf("语句缺少 %q（%s）。SQL: %s", want.fragment, want.why, sql)
		}
	}

	// 绑定参数：SET 的两个值（新散列 + 空串 salt）在前，WHERE 的两个（login_id、旧散列）在后。
	// 这里只断言「该出现的值都出现了、salt 绑的是空串」，不依赖具体顺序。
	var sawNew, sawOld, sawEmptySalt, sawLoginID bool
	for _, v := range vars {
		switch val := v.(type) {
		case string:
			switch val {
			case newHash:
				sawNew = true
			case oldHash:
				sawOld = true
			case "":
				sawEmptySalt = true
			}
		case uint64:
			if val == loginID {
				sawLoginID = true
			}
		}
	}
	if !sawNew {
		t.Errorf("绑定参数里没有新散列。vars=%v", vars)
	}
	if !sawOld {
		t.Errorf("绑定参数里没有旧散列：WHERE 条件没真的带上它。vars=%v", vars)
	}
	if !sawEmptySalt {
		t.Errorf("salt 没有被写成空串。vars=%v", vars)
	}
	if !sawLoginID {
		t.Errorf("绑定参数里没有 login_id。vars=%v", vars)
	}
}

// TestSyncPasswordHashSQL_ClearsSalt 管理员重置 / 新建用户走的写入路径同样要把 salt 清空。
// 老账号升级后 salt 还留着旧值的话，后面排查「这行是什么算法」就会误判。
//
// 入参是**调用方算好的** bcrypt 散列（SyncPasswordHash 不自己算，见该方法注释：
// 它会在事务里被调用，bcrypt 放事务内等于凭空多持 100ms 行锁）。所以这里除了
// 「写的是 bcrypt 串、salt 是空串」，还要钉一条更强的：落库的值必须与传入的散列
// **逐字节相同** —— 一旦有人在仓储里顺手再散列一次，或者把明文透传下去，
// 这个断言就会失败。
func TestSyncPasswordHashSQL_ClearsSalt(t *testing.T) {
	db := newDryRunDB(t)

	var (
		sql  string
		vars []interface{}
	)
	if err := db.Callback().Update().After("gorm:update").Register("test:capture_sync", func(tx *gorm.DB) {
		if tx.Statement != nil && tx.Statement.SQL.Len() > 0 {
			sql = tx.Statement.SQL.String()
			vars = tx.Statement.Vars
		}
	}); err != nil {
		t.Fatalf("注册 update 回调失败: %v", err)
	}
	// DryRun 下这条查询返回空结果，SyncPasswordHash 会走「没有记录 → Create」分支，
	// 所以这里只能断言 Create 路径。更新分支的 salt 清空由上面那个用例覆盖
	// （两条路径写的是同一组列）。
	if err := db.Callback().Create().After("gorm:create").Register("test:capture_sync_create", func(tx *gorm.DB) {
		if tx.Statement != nil && tx.Statement.SQL.Len() > 0 {
			sql = tx.Statement.SQL.String()
			vars = tx.Statement.Vars
		}
	}); err != nil {
		t.Fatalf("注册 create 回调失败: %v", err)
	}

	// 真算一个 bcrypt 散列，而不是手写一个假串：这样「落库的值就是传进来的散列」
	// 这条断言同时也证明了它是个真能校验密码的散列。
	hashed, err := bcrypt.GenerateFromPassword([]byte("Reset1pass"), bcrypt.DefaultCost)
	if err != nil {
		t.Fatalf("生成 bcrypt 散列失败: %v", err)
	}
	if err := NewAdminUserLoginRepositoryWithDB(db).
		SyncPasswordHash(context.Background(), 42, "staff", string(hashed)); err != nil {
		t.Fatalf("SyncPasswordHash 失败: %v", err)
	}
	if sql == "" {
		t.Fatal("没有捕获到写入语句")
	}
	if !strings.Contains(sql, "salt") {
		t.Fatalf("写入语句里没有 salt 列：老行的旧盐不会被清掉。SQL: %s", sql)
	}

	// 写进去的凭证必须是 bcrypt 格式、与传入的散列逐字节相同，salt 必须是空串
	var sawBcrypt, sawEmptySalt, sawSameHash bool
	for _, v := range vars {
		s, ok := v.(string)
		if !ok {
			continue
		}
		if strings.HasPrefix(s, "$2a$") || strings.HasPrefix(s, "$2b$") || strings.HasPrefix(s, "$2y$") {
			sawBcrypt = true
		}
		if s == string(hashed) {
			sawSameHash = true
		}
		if s == "" {
			sawEmptySalt = true
		}
		if s == "Reset1pass" {
			t.Fatalf("明文密码被写进了语句参数：仓储不该拿到明文。SQL: %s", sql)
		}
	}
	if !sawBcrypt {
		t.Errorf("写入的凭证不是 bcrypt 格式。SQL: %s", sql)
	}
	if !sawSameHash {
		t.Errorf("落库的凭证与传入的散列不一致：仓储不该再加工散列。vars=%v", vars)
	}
	if !sawEmptySalt {
		t.Errorf("salt 没有写成空串。SQL: %s", sql)
	}
}
