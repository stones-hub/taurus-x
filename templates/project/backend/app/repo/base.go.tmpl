package repo

import (
	"context"
	"errors"
	"fmt"

	"gorm.io/gorm"

	"{{ .Module }}/internal/taurus"
)

// TableNamer 干净 model 只需实现 TableName()，无需 DB()/gorm 依赖
type TableNamer interface {
	TableName() string
}

// baseRepository 自建泛型仓储：连接显式传入，model 保持贫血。
// TableNamer 约束声明「仓储只接受实现了 TableName() 的 model」——这是
// repo 层的表名契约，gorm 内部会通过该消息反射获取表名，此处无需存副本。
type baseRepository[T TableNamer] struct {
	db *gorm.DB
}

// newBaseRepository 创建仓储实例（db 显式传入）
func newBaseRepository[T TableNamer](db *gorm.DB) *baseRepository[T] {
	return &baseRepository[T]{db: db}
}

// defaultDB 从全局容器取默认数据库连接
func defaultDB() *gorm.DB {
	if taurus.Container == nil {
		return nil
	}
	if db, ok := taurus.Container.DbList["default"]; ok {
		return db
	}
	for _, d := range taurus.Container.DbList {
		return d
	}
	return nil
}

// Create 创建记录
func (r *baseRepository[T]) Create(ctx context.Context, entity *T) error {
	if entity == nil {
		return errors.New("entity cannot be nil")
	}
	return r.db.WithContext(ctx).Create(entity).Error
}

// CreateBatch 批量创建记录（空切片直接返回 nil）
func (r *baseRepository[T]) CreateBatch(ctx context.Context, entities []T) error {
	if len(entities) == 0 {
		return nil
	}
	if err := r.db.WithContext(ctx).Create(&entities).Error; err != nil {
		return fmt.Errorf("batch create failed: %w", err)
	}
	return nil
}

// Delete 删除记录
func (r *baseRepository[T]) Delete(ctx context.Context, entity *T) error {
	if entity == nil {
		return errors.New("entity cannot be nil")
	}
	return r.db.WithContext(ctx).Delete(entity).Error
}

// DeleteByID 根据 ID 删除
func (r *baseRepository[T]) DeleteByID(ctx context.Context, id uint) error {
	if id == 0 {
		return errors.New("id cannot be zero")
	}
	var e T
	return r.db.WithContext(ctx).Delete(&e, id).Error
}

// FindByID 根据 ID 查找
func (r *baseRepository[T]) FindByID(ctx context.Context, id uint) (*T, error) {
	if id == 0 {
		return nil, errors.New("id cannot be zero")
	}
	var e T
	if err := r.db.WithContext(ctx).First(&e, id).Error; err != nil {
		if errors.Is(err, gorm.ErrRecordNotFound) {
			return nil, fmt.Errorf("record not found with id: %d", id)
		}
		return nil, err
	}
	return &e, nil
}

// Count 统计总数
func (r *baseRepository[T]) Count(ctx context.Context) (int64, error) {
	var count int64
	err := r.db.WithContext(ctx).Model(new(T)).Count(&count).Error
	return count, err
}

// firstBy 按条件查询单条（未找到返回 nil），仅供包内领域方法复用。
func (r *baseRepository[T]) firstBy(ctx context.Context, where string, args ...interface{}) (*T, error) {
	var v T
	if err := r.db.WithContext(ctx).Where(where, args...).First(&v).Error; err != nil {
		if errors.Is(err, gorm.ErrRecordNotFound) {
			return nil, nil
		}
		return nil, err
	}
	return &v, nil
}

// findBy 按条件查询多条，仅供包内领域方法复用。
func (r *baseRepository[T]) findBy(ctx context.Context, where string, args ...interface{}) ([]T, error) {
	var list []T
	err := r.db.WithContext(ctx).Where(where, args...).Find(&list).Error
	return list, err
}

// page 对已构建好条件的 q 执行分页，返回列表与总数，仅供包内领域方法复用。
func (r *baseRepository[T]) page(q *gorm.DB, page, pageSize int, orderBy string) ([]T, int64, error) {
	var list []T
	total, err := paginate(q, page, pageSize, orderBy, &list)
	if err != nil {
		return nil, 0, err
	}
	return list, total, nil
}

// Save 整实体保存（含主键则更新全部字段，无主键则插入）
func (r *baseRepository[T]) Save(ctx context.Context, entity *T) error {
	if entity == nil {
		return errors.New("entity cannot be nil")
	}
	return r.db.WithContext(ctx).Save(entity).Error
}

// paginate 执行分页查询：统计 total 并按 orderBy（含方向，如 "id DESC"）排序后分页填充 out。
// q 需已 Model + 已加 Where 条件。
func paginate[T any](q *gorm.DB, page, pageSize int, orderBy string, out *[]T) (int64, error) {
	var total int64
	if err := q.Count(&total).Error; err != nil {
		return 0, fmt.Errorf("count query failed: %w", err)
	}
	if err := q.Order(orderBy).Offset((page - 1) * pageSize).Limit(pageSize).Find(out).Error; err != nil {
		return 0, fmt.Errorf("find query failed: %w", err)
	}
	return total, nil
}
