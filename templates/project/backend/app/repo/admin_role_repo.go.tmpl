package repo

import (
	"context"

	"gorm.io/gorm"

	"{{ .Module }}/app/model"
)

// AdminRoleRepository 角色数据访问层
type AdminRoleRepository struct {
	*baseRepository[model.AdminRole]
}

func NewAdminRoleRepositoryWithDB(db *gorm.DB) *AdminRoleRepository {
	return &AdminRoleRepository{baseRepository: newBaseRepository[model.AdminRole](db)}
}

// FindByRoleID 根据角色 ID 查找角色（仅启用）
func (r *AdminRoleRepository) FindByRoleID(ctx context.Context, roleID uint64) (*model.AdminRole, error) {
	return r.firstBy(ctx, "role_id = ? and status = 1", roleID)
}

// Role 返回角色仓储
func (r repoSet) Role() *AdminRoleRepository { return NewAdminRoleRepositoryWithDB(r.db) }

// UpdateByID 按主键更新指定字段
func (r *AdminRoleRepository) UpdateByID(ctx context.Context, id uint64, updates interface{}) error {
	return r.db.WithContext(ctx).Model(&model.AdminRole{}).Where("role_id = ?", id).Updates(updates).Error
}

// FindByRoleCode 根据角色编码查找角色
func (r *AdminRoleRepository) FindByRoleCode(ctx context.Context, code string) (*model.AdminRole, error) {
	return r.firstBy(ctx, "role_code = ?", code)
}

// FindByRoleName 根据角色名称查找角色
func (r *AdminRoleRepository) FindByRoleName(ctx context.Context, name string) (*model.AdminRole, error) {
	return r.firstBy(ctx, "role_name = ?", name)
}

// FindByRoleIDAnyStatus 根据角色 ID 查找角色（不过滤 status）
func (r *AdminRoleRepository) FindByRoleIDAnyStatus(ctx context.Context, roleID uint64) (*model.AdminRole, error) {
	return r.firstBy(ctx, "role_id = ?", roleID)
}

// FindByRoleIDForShare 当前读单个启用角色（SELECT ... FOR SHARE）。
//
// 用共享锁而不是排他锁：身份判定只读角色行、不改它，拿排他锁会无谓地挡住角色管理，
// 还会把死锁面扩大到角色模块。共享锁已经足够拿到当前读 + 判定期间这一行不被改。
//
// 注意：**当前没有生产调用方**。身份与入参判定一律改用
// FindByRoleIDAnyStatusForShare —— 状态是策略判定的输入，不是查询条件
// （在查询里过滤 status 会让「保留一个已持有的禁用角色」变成「角色ID不存在」）。
// 这里保留它是因为「当前读某个启用角色」是个合法的查询原语，且已有 SQL 形状测试；
// 要用它之前先确认你真的想让禁用的角色在结果里直接消失。
func (r *AdminRoleRepository) FindByRoleIDForShare(ctx context.Context, roleID uint64) (*model.AdminRole, error) {
	return r.firstLocking(ctx, lockForShare, "role_id = ? and status = 1", roleID)
}

// FindByRoleIDAnyStatusForShare 当前读单个角色、不过滤 status（SELECT ... FOR SHARE）。
// 已禁用的 super_admin 同样是「这个账号是超管」的证据，所以身份判定不能过滤状态。
func (r *AdminRoleRepository) FindByRoleIDAnyStatusForShare(ctx context.Context, roleID uint64) (*model.AdminRole, error) {
	return r.firstLocking(ctx, lockForShare, "role_id = ?", roleID)
}

// ListActive 查询所有启用状态的角色
func (r *AdminRoleRepository) ListActive(ctx context.Context) ([]model.AdminRole, error) {
	return r.findBy(ctx, "status = 1")
}

// AdminRoleListFilter 角色列表筛选条件
type AdminRoleListFilter struct {
	RoleName string
	Status   int
}

// ListWithFilter 分页查询角色（结构化筛选）
func (r *AdminRoleRepository) ListWithFilter(ctx context.Context, page, pageSize int, f AdminRoleListFilter) ([]model.AdminRole, int64, error) {
	q := r.db.WithContext(ctx).Model(&model.AdminRole{})
	if f.RoleName != "" {
		q = q.Where("role_name LIKE ?", "%"+f.RoleName+"%")
	}
	if f.Status >= 0 {
		q = q.Where("status = ?", f.Status)
	}
	return r.page(q, page, pageSize, "role_id DESC")
}
