package repo

import (
	"context"

	"gorm.io/gorm"

	"{{ .Module }}/app/model"
)

// AdminRolePermissionsRepository 角色权限关联数据访问层
type AdminRolePermissionsRepository struct {
	*baseRepository[model.AdminRolePermissions]
}

func NewAdminRolePermissionsRepositoryWithDB(db *gorm.DB) *AdminRolePermissionsRepository {
	return &AdminRolePermissionsRepository{baseRepository: newBaseRepository[model.AdminRolePermissions](db)}
}

// FindByRoleID 根据角色 ID 查找角色权限关联
func (r *AdminRolePermissionsRepository) FindByRoleID(ctx context.Context, roleID uint64) ([]model.AdminRolePermissions, error) {
	return r.findBy(ctx, "role_id = ?", roleID)
}

// RolePermission 返回角色-权限关联仓储
func (r repoSet) RolePermission() *AdminRolePermissionsRepository {
	return NewAdminRolePermissionsRepositoryWithDB(r.db)
}

// ListByPermissionID 查询指定权限关联的角色权限记录
func (r *AdminRolePermissionsRepository) ListByPermissionID(ctx context.Context, permissionID uint64) ([]model.AdminRolePermissions, error) {
	return r.findBy(ctx, "permission_id = ?", permissionID)
}
