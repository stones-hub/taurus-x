package controller

import (
	"encoding/json"
	"net/http"

	"github.com/google/wire"

	"{{ .Module }}/app/dto"
	"{{ .Module }}/app/service"
)

// DeptController 部门管理控制器
type DeptController struct {
	DeptService *service.AdminDeptService
}

// DeptControllerSet wire provider set
var DeptControllerSet = wire.NewSet(wire.Struct(new(DeptController), "*"))

// GetDeptList 部门列表（POST /admin/dept/list）
func (c *DeptController) GetDeptList(w http.ResponseWriter, r *http.Request) {
	var req dto.DeptListRequest
	if !BindJSON(w, r, &req) {
		return
	}
	req.Normalize()
	resp, err := c.DeptService.GetDeptList(r.Context(), req.PageNo, req.PageSize, req.DeptName, req.Status)
	if err != nil {
		Fail(w, http.StatusInternalServerError, err.Error())
		return
	}
	OK(w, resp)
}

// GetEditDeptInfo 获取编辑部门信息（POST /admin/dept/edit-info）
func (c *DeptController) GetEditDeptInfo(w http.ResponseWriter, r *http.Request) {
	var req dto.DeptIDRequest
	if !BindJSON(w, r, &req) {
		return
	}
	if req.DeptID == 0 {
		Fail(w, http.StatusBadRequest, "部门ID不能为空")
		return
	}
	resp, err := c.DeptService.GetEditDeptInfo(r.Context(), req.DeptID)
	if err != nil {
		Fail(w, http.StatusInternalServerError, err.Error())
		return
	}
	OK(w, resp)
}

// GetAllDepts 获取所有启用部门（POST /admin/dept/option-depts）
func (c *DeptController) GetAllDepts(w http.ResponseWriter, r *http.Request) {
	var req dto.GetAllDeptsRequest
	_ = json.NewDecoder(r.Body).Decode(&req)
	resp, err := c.DeptService.GetAllDepts(r.Context(), req.ExcludeDeptID)
	if err != nil {
		Fail(w, http.StatusInternalServerError, err.Error())
		return
	}
	OK(w, resp)
}

