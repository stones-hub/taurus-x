// ---------- UpdateUser：role_ids 的选择性更新语义 ----------

// TestUpdateUser_RoleIDsSelectiveUpdate role_ids 的三种 JSON 形态对应三种行为，
// 必须在**真实的 handler 解码**上验证：
//
//	字段缺失 / null → 完全不碰 admin_user_roles（不校验、不删、不插）
//	[]             → 清空：一条按 user_id 的 DELETE，零 INSERT
//	[3]            → 整体替换：先校验角色，再 DELETE + INSERT
//
// 这条测试盯着一个真实存在过的缺陷：UpdateUser 无条件调用角色整体替换，于是
// 「只改昵称」的保存（前端没带 role_ids）会把该账号的角色关联全部删掉。
// 判定依据只能是切片的 nil 性，不能是长度 —— `len(RoleIDs) == 0` 会把「缺失」
// 和「显式清空」混成一种，这里的前两个和第三个用例就是用来钉死这个区别的。
//
// 同时也是需求 (2) 的证据：四个用例的事务开头都是同一组加锁当前读
// （操作人 + 目标的用户行、双方身份），「不传 role_ids」并不会少锁一行、
// 少读一次身份 —— 目标账号保护跟本次改不改角色无关。
func TestUpdateUser_RoleIDsSelectiveUpdate(t *testing.T) {
	cases := []struct {
		name string
		body string
		// rolePrecheck 预检阶段该出现的角色语句（txRoleFactsByIDs）；nil 表示一条都不该有
		rolePrecheck func(mock sqlmock.Sqlmock)
		// roleWrite 写入阶段该出现的角色语句（replaceUserRolesTx）；nil 表示一条都不该有
		roleWrite func(mock sqlmock.Sqlmock)
	}{
		{
			name: "字段缺失：不校验、不替换",
			body: fmt.Sprintf(`{"user_id":%d,"realname":"张三","nickname":"三"}`, targetOrdinaryID),
		},
		{
			name: "null：同缺失，不清空",
			body: fmt.Sprintf(`{"user_id":%d,"realname":"张三","role_ids":null}`, targetOrdinaryID),
		},
		{
			name: "空数组：清空（按 user_id 删一次，零 INSERT）",
			body: fmt.Sprintf(`{"user_id":%d,"realname":"张三","role_ids":[]}`, targetOrdinaryID),
			roleWrite: func(mock sqlmock.Sqlmock) {
				expectReplaceRoles(mock, targetOrdinaryID, 0)
			},
		},
		{
			name: "非空数组：校验后整体替换",
			body: fmt.Sprintf(`{"user_id":%d,"realname":"张三","role_ids":[%d]}`, targetOrdinaryID, roleOrdinaryID),
			rolePrecheck: func(mock sqlmock.Sqlmock) {
				expectRoleCheck(mock, ordinaryRole)
			},
			roleWrite: func(mock sqlmock.Sqlmock) {
				expectReplaceRoles(mock, targetOrdinaryID, 1)
			},
		},
	}

	for _, tc := range cases {
		t.Run(tc.name, func(t *testing.T) {
			c, mock := newUserController(t)

			mock.ExpectBegin()
			// 不管改不改角色，身份锁与目标账号保护照样跑完
			expectLockUserRow(mock, operatorSuperID, "super")
			expectLockUserRow(mock, targetOrdinaryID, "staff")
			expectRolesOf(mock, operatorSuperID, superRole)
			expectRolesOf(mock, targetOrdinaryID, ordinaryRole) // 目标现有角色：普通角色
			if tc.rolePrecheck != nil {
				tc.rolePrecheck(mock)
			}
			// ===== 预检之后才是写 =====
			mock.ExpectExec(upd("admin_users")).WillReturnResult(sqlmock.NewResult(0, 1)) // 资料
			if tc.roleWrite != nil {
				tc.roleWrite(mock)
			}
			mock.ExpectCommit()

			rec := httptest.NewRecorder()
			c.UpdateUser(rec, rawJSONRequest(t, operatorSuperID, tc.body))

			if got := respCode(t, rec); got != http.StatusOK {
				t.Errorf("编辑应成功，实际 body.code = %d，body = %s", got, rec.Body.String())
			}
			// 「缺失 / null」两个用例里期望表中一条角色语句都没登记：
			// 实现只要碰一次 admin_user_roles 就会撞上未预期的语句而失败
			assertNoUnexpectedSQL(t, mock)
		})
	}
}

