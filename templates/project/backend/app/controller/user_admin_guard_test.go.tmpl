	// 入参里只有启用角色：禁用角色这次被摘掉，预检不该再去查它
	expectRoleCheck(mock, ordinaryRole)
	mock.ExpectExec(upd("admin_users")).WillReturnResult(sqlmock.NewResult(0, 1))
	// 删一次 + 插一条：留下的只有启用角色
	expectReplaceRoles(mock, targetOrdinaryID, 1)
	mock.ExpectCommit()

	rec := httptest.NewRecorder()
	c.UpdateUser(rec, rawJSONRequest(t, operatorSuperID,
		fmt.Sprintf(`{"user_id":%d,"realname":"张三","role_ids":[%d]}`, targetOrdinaryID, roleOrdinaryID)))

	if got := respCode(t, rec); got != http.StatusOK {
		t.Errorf("明确移除已持有的禁用角色应成功，实际 body.code = %d，body = %s", got, rec.Body.String())
	}
	assertNoUnexpectedSQL(t, mock)
}

