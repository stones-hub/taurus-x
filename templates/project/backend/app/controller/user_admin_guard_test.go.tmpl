//
// 事务第一条语句是锁本人用户行：自助改密不做身份判定，锁它只为统一全局加锁顺序
// （先 admin_users 再 admin_user_logins），避免与管理员重置密码互为相反顺序而死锁。
func TestChangePassword_SuperAdminSelfServiceStillWorks(t *testing.T) {
	const oldPwd = "Old1pass"
	// 库里存的是 bcrypt 散列，salt 列恒为空串（见 app/helper/crypto.go）
	credential, err := helper.HashPassword(oldPwd)
	if err != nil {
		t.Fatalf("构造测试散列失败: %v", err)
	}
	const salt = ""

	t.Run("旧密码正确则改密并吊销会话", func(t *testing.T) {
		c, mock := newUserController(t)

		mock.ExpectBegin()
		expectLockUserRow(mock, operatorSuperID, "super")
		mock.ExpectQuery(sel("admin_user_logins")).WillReturnRows(
			sqlmock.NewRows([]string{"login_id", "user_id", "login_type", "login_credential", "salt"}).
				AddRow(3, operatorSuperID, string(constants.LoginTypeUsername), credential, salt))
		mock.ExpectExec(upd("admin_user_logins")).WillReturnResult(sqlmock.NewResult(0, 1))
		mock.ExpectExec(upd("admin_users")).WillReturnResult(sqlmock.NewResult(0, 1))
		mock.ExpectCommit()

		rec := httptest.NewRecorder()
		c.ChangePassword(rec, jwtRequest(t, operatorSuperID, dto.ChangePasswordRequest{
			OldPassword: oldPwd, NewPassword: "New1pass",
		}))

		if got := respCode(t, rec); got != http.StatusOK {
			t.Errorf("超管自助改密应成功，实际 body.code = %d，body = %s", got, rec.Body.String())
		}
		assertNoUnexpectedSQL(t, mock)
	})

	t.Run("旧密码错误则零写入", func(t *testing.T) {
		c, mock := newUserController(t)

		mock.ExpectBegin()
		expectLockUserRow(mock, operatorSuperID, "super")
		mock.ExpectQuery(sel("admin_user_logins")).WillReturnRows(
			sqlmock.NewRows([]string{"login_id", "user_id", "login_type", "login_credential", "salt"}).
				AddRow(3, operatorSuperID, string(constants.LoginTypeUsername), credential, salt))
		mock.ExpectRollback()

		rec := httptest.NewRecorder()
		c.ChangePassword(rec, jwtRequest(t, operatorSuperID, dto.ChangePasswordRequest{
			OldPassword: "Wrong1pass", NewPassword: "New1pass",
		}))

		if got := respCode(t, rec); got == http.StatusOK {
			t.Error("旧密码错误时不能改密成功")
		}
		assertNoUnexpectedSQL(t, mock)
	})

	t.Run("本人账号已被删除则拒绝且零写入", func(t *testing.T) {
		c, mock := newUserController(t)

		mock.ExpectBegin()
		expectLockUserRowMissing(mock, operatorSuperID)
		mock.ExpectRollback()

		rec := httptest.NewRecorder()
		c.ChangePassword(rec, jwtRequest(t, operatorSuperID, dto.ChangePasswordRequest{
			OldPassword: oldPwd, NewPassword: "New1pass",
		}))

		if got := respCode(t, rec); got == http.StatusOK {
			t.Error("账号已不存在时不能改密成功")
		}
		assertNoUnexpectedSQL(t, mock)
	})

	// 历史账号：库里存的还是 SHA-256(password + salt)。自助改密必须认这种旧凭证，
	// 否则「老用户改密码」会卡在旧密码校验上 —— 而这正是他们摆脱旧算法的入口。
	t.Run("旧 SHA-256 凭证也能改密", func(t *testing.T) {
		c, mock := newUserController(t)

		const legacySalt = "0123456789abcdef0123456789abcdef"
		legacyCredential := helper.LegacyHashPassword(oldPwd, legacySalt)

		mock.ExpectBegin()
		expectLockUserRow(mock, operatorSuperID, "super")
		mock.ExpectQuery(sel("admin_user_logins")).WillReturnRows(
			sqlmock.NewRows([]string{"login_id", "user_id", "login_type", "login_credential", "salt"}).
				AddRow(3, operatorSuperID, string(constants.LoginTypeUsername), legacyCredential, legacySalt))
		mock.ExpectExec(upd("admin_user_logins")).WillReturnResult(sqlmock.NewResult(0, 1))
		mock.ExpectExec(upd("admin_users")).WillReturnResult(sqlmock.NewResult(0, 1))
		mock.ExpectCommit()

		rec := httptest.NewRecorder()
		c.ChangePassword(rec, jwtRequest(t, operatorSuperID, dto.ChangePasswordRequest{
			OldPassword: oldPwd, NewPassword: "New1pass",
		}))

		if got := respCode(t, rec); got != http.StatusOK {
			t.Errorf("旧散列账号应能改密，实际 body.code = %d，body = %s", got, rec.Body.String())
		}
		assertNoUnexpectedSQL(t, mock)
	})
}

// ---------- 编辑页回显：持有中的禁用角色不能丢 ----------

// TestGetUserInfo_IncludesHeldDisabledRole 用户详情（编辑页的数据来源）必须把
// 「该账号真实持有、但已被禁用」的角色一并带出来并标记为已选中。
//
// 不带出来的后果不是「少显示一行」：编辑页按返回的 checked 构造 role_ids，
// 这条关联不在里面，一次「改昵称」的整体替换就把它静默删掉了。所以这里的事实
// 来源必须是库里的 admin_user_roles 关联表，而不是「启用角色列表」，
// 也不是前端回传的 role_ids。
//
// 期望里第二条 admin_roles 查询就是这个补查（按 role_id、不过滤 status）：
// 实现要是只用启用列表，这条期望不会被用到而测试失败。
func TestGetUserInfo_IncludesHeldDisabledRole(t *testing.T) {
	c, mock := newUserController(t)

	// GetUserInfo：取用户行
	mock.ExpectQuery(sel("admin_users")).WithArgs(firstArgs(targetOrdinaryID)...).
		WillReturnRows(sqlmock.NewRows([]string{"user_id", "username", "status"}).
			AddRow(targetOrdinaryID, "staff", 1))
	// 启用角色列表里没有那个被禁用的角色
	mock.ExpectQuery(sel("admin_roles")).WillReturnRows(
		roleRows().AddRow(roleOrdinaryID, ordinaryRole.roleCode, ordinaryRole.isSystem, ordinaryRole.status))
	// 但该账号真实持有两条关联：一个启用、一个已被禁用
	mock.ExpectQuery(sel("admin_user_roles")).WithArgs(targetOrdinaryID).WillReturnRows(
		sqlmock.NewRows([]string{"id", "user_id", "role_id"}).
			AddRow(1, targetOrdinaryID, roleOrdinaryID).
			AddRow(2, targetOrdinaryID, roleDisabledID))
	// 持有但没列出来的那个，按 role_id 单独补查（不过滤 status）
	mock.ExpectQuery(sel("admin_roles")).WithArgs(firstArgs(roleDisabledID)...).WillReturnRows(
		roleRows().AddRow(roleDisabledID, disabledRole.roleCode, disabledRole.isSystem, disabledRole.status))
	// 两个勾选中的角色各查一次权限关联（返回空：权限内容不是这条测试的关注点）
	mock.ExpectQuery(sel("admin_role_permissions")).WithArgs(roleOrdinaryID).WillReturnRows(
		sqlmock.NewRows([]string{"id", "role_id", "permission_id"}))
	mock.ExpectQuery(sel("admin_role_permissions")).WithArgs(roleDisabledID).WillReturnRows(
		sqlmock.NewRows([]string{"id", "role_id", "permission_id"}))

	rec := httptest.NewRecorder()
	c.GetUserInfo(rec, jwtRequest(t, operatorSuperID, dto.UserIDRequest{UserID: targetOrdinaryID}))

	var resp struct {
		Code int `json:"code"`
		Data struct {
			Permissions struct {
				Roles []struct {
					Role struct {
						RoleID uint64 `json:"role_id"`
						Status int8   `json:"status"`
					} `json:"role"`
					Checked bool `json:"checked"`
				} `json:"roles"`
			} `json:"permissions"`
		} `json:"data"`
	}
	if err := json.Unmarshal(rec.Body.Bytes(), &resp); err != nil {
		t.Fatalf("解析响应失败: %v，body = %s", err, rec.Body.String())
	}
	if resp.Code != http.StatusOK {
		t.Fatalf("取用户详情应成功，实际 body.code = %d，body = %s", resp.Code, rec.Body.String())
	}

	var found bool
	for _, item := range resp.Data.Permissions.Roles {
		if item.Role.RoleID != roleDisabledID {
			continue
		}
		found = true
		if !item.Checked {
			t.Error("持有中的禁用角色必须回显为已选中，否则保存资料时这条关联会被删掉")
		}
		if item.Role.Status != 0 {
			t.Errorf("禁用角色的 status 必须按库里的事实返回（0），实际 %d", item.Role.Status)
		}
	}
	if !found {
		t.Errorf("返回的角色列表里必须包含持有中的禁用角色 %d，实际 = %s", roleDisabledID, rec.Body.String())
	}
	assertNoUnexpectedSQL(t, mock)
}
