package controller

import (
	"net/http"

	"github.com/google/wire"

	"{{ .Module }}/app/dto"
	tmid "{{ .Module }}/app/middleware"
	"{{ .Module }}/app/service"
)

// LogController 系统日志控制器
type LogController struct {
	LogService *service.LogService
}

// LogControllerSet wire provider set
var LogControllerSet = wire.NewSet(wire.Struct(new(LogController), "*"))

// GetAccessLogList 获取访问日志列表（POST /admin/log/access/list）
func (c *LogController) GetAccessLogList(w http.ResponseWriter, r *http.Request) {
	var req dto.AccessLogListRequest
	if !BindJSON(w, r, &req) {
		return
	}
	req.Normalize()
	resp, err := c.LogService.GetAccessLogList(r.Context(), req)
	if err != nil {
		Fail(w, http.StatusInternalServerError, err.Error())
		return
	}
	OK(w, resp)
}

