// ReportFrontError 前端错误上报（公共路由，无需登录）
func (c *LogController) ReportFrontError(w http.ResponseWriter, r *http.Request) {
	var req dto.FrontErrorReportRequest
	if !BindJSON(w, r, &req) {
		return
	}

	var userID uint64
	if uid, ok := tmid.CurrentUserIDFromJWT(r); ok {
		userID = uid
	}

	if err := c.LogService.ReportFrontError(r.Context(), &req, userID, tmid.ClientIP(r), r.UserAgent()); err != nil {
		// 错误上报兜底失败：不打日志会静默吞掉，这里降级记录但不影响对前端的 200 响应
		Fail(w, http.StatusInternalServerError, "前端错误上报失败")
		return
	}
	OK(w, nil)
}
