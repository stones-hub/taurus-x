package controller

import (
	"encoding/json"
	"errors"
	"fmt"
	"log"
	"net/http"
	"time"

	"github.com/google/wire"

	"{{ .Module }}/app/constants"
	"{{ .Module }}/app/dto"
	"{{ .Module }}/app/helper/store"
	"{{ .Module }}/app/middleware"
	"{{ .Module }}/app/service"
)

// AuthController 认证控制器
type AuthController struct {
	AuthService     *service.AuthService
	LoginLogService *service.AdminLoginLogService
}

// AuthControllerSet wire provider set
var AuthControllerSet = wire.NewSet(wire.Struct(new(AuthController), "*"))

// Login 用户登录
func (c *AuthController) Login(w http.ResponseWriter, r *http.Request) {
	if !middleware.AllowAuthRequest(w, r, false) {
		return
	}
	var req dto.LoginRequest
	if r.Header.Get("Content-Type") == "application/json" {
		if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
			Fail(w, http.StatusBadRequest, "请求参数解析失败: "+err.Error())
			return
		}
	} else {
		if err := r.ParseForm(); err != nil {
			Fail(w, http.StatusBadRequest, "请求参数解析失败: "+err.Error())
			return
		}
		req.Username = r.FormValue("username")
		req.Password = r.FormValue("password")
	}

	if req.Username == "" || req.Password == "" {
		c.recordLogin(r, 0, service.LoginStatusFailure, "用户名或密码为空")
		Fail(w, http.StatusBadRequest, "用户名和密码不能为空")
		return
	}

	user, authVersion, err := c.AuthService.PasswordLogin(r.Context(), req.Username, req.Password)
	if errors.Is(err, service.ErrLoginBackend) {
		// 数据库等内部错误只进服务端日志，不回给客户端，也不写进管理端可见的登录日志。
		log.Printf("登录校验失败: %v\n", err)
		c.recordLogin(r, 0, service.LoginStatusFailure, "登录服务异常")
		Fail(w, http.StatusInternalServerError, service.ErrLoginBackend.Error())
		return
	}
	if err != nil {
		// 账号不存在时归属到 user_id=0，日志仍然要留：
		// 「某个 IP 在猜不存在的账号」本身就是要观测的信号。
		c.recordLogin(r, c.AuthService.LookupUserIDByUsername(r.Context(), req.Username), service.LoginStatusFailure, err.Error())
		Fail(w, http.StatusUnauthorized, err.Error())
		return
	}

	// authVersion 必须是校验凭证那一刻的值，原样传下去：
	// 让签发侧现查当前版本会给「旧密码并发登录」留出可用会话。
	// 令牌写入响应之后才记「登录成功」：写入失败时会话已被吊销，客户端也没拿到令牌，
	// 这次登录实际没有成功，审计日志必须如实记失败。
	token, expiresAt, err := middleware.IssueLoginJWT(w, fmt.Sprintf("%d", user.UserID), user.Username, authVersion)
	if err != nil {
		if errors.Is(err, middleware.ErrJWTWriteFailed) {
			log.Printf("登录写入令牌失败: %v\n", err)
			c.recordLogin(r, user.UserID, service.LoginStatusFailure, "令牌写入失败")
			Fail(w, http.StatusInternalServerError, "令牌写入失败")
			return
		}
		// 详细错误（可能含 Redis 地址等内部信息）只进服务端日志，不返回给客户端。
		log.Printf("登录签发令牌失败: %v\n", err)
		c.recordLogin(r, user.UserID, service.LoginStatusFailure, "生成令牌失败")
		if errors.Is(err, store.ErrSessionStoreUnavailable) {
			Fail(w, http.StatusServiceUnavailable, "认证服务暂时不可用")
			return
		}
		Fail(w, http.StatusInternalServerError, "生成令牌失败")
		return
	}

	c.recordLogin(r, user.UserID, service.LoginStatusSuccess, "")
	// IP 取法与登录日志一致（middleware.ClientIP，遵守 trusted_proxies）；失败只记日志，不影响登录。
	if err := c.AuthService.RecordLastLogin(r.Context(), user.UserID, middleware.ClientIP(r)); err != nil {
		log.Printf("更新最后登录信息失败: %v\n", err)
	}

	response := dto.LoginResponse{Token: token, User: dto.ToUserInfo(user), ExpiresAt: expiresAt}
	setCSRFCookie(w, expiresAt)

	OK(w, response)
}

// Logout 用户登出
//
// 除了清 Cookie，还必须把当前 Token 的 jti 从会话白名单里删掉：
// 不吊销的话，登出只是「浏览器忘记了 Token」，Token 本身到期前仍然可用。
//
// Token 的提取统一走 middleware.GetJWTToken —— 认证中间件用的就是它。
// controller 自己再写一套优先级（旧实现 Authorization 优先）会导致同时带
// Cookie 和 Bearer 时「认证用的是 Cookie，登出吊销的却是 Bearer」，
// 结果请求真正在用的那个会话毫发无伤。
func (c *AuthController) Logout(w http.ResponseWriter, r *http.Request) {
	if !middleware.AllowLogoutRequest(w, r) {
		return
	}
	// Token 解析不出来（缺失/过期/签名不对）时无需吊销：这种 Token 本来就过不了认证。
	if token := middleware.GetJWTToken(r); token != "" {
		if claims, _, err := middleware.ValidateJWTToken(token); err == nil && claims.JTI != "" {
			if err := middleware.AuthSessionStore().RevokeSession(claims.JTI); err != nil {
				// 吊销失败不能报成功：客户端以为登出了，服务端其实还认这个 Token。
				log.Printf("登出吊销会话失败: %v\n", err)
				Fail(w, http.StatusInternalServerError, "登出失败，请重试")
				return
			}
		}
	}

	middleware.ClearJWTToken(w)
	middleware.ClearCSRFToken(w)
	Fail(w, http.StatusOK, "登出成功")
}

// RefreshToken 刷新 JWT 令牌
func (c *AuthController) RefreshToken(w http.ResponseWriter, r *http.Request) {
	if !middleware.AllowAuthRequest(w, r, true) {
		return
	}
	token := middleware.GetJWTToken(r)
	if token == "" {
		Fail(w, http.StatusUnauthorized, "缺少JWT令牌")
		return
	}
	newToken, expiresAt, err := middleware.RefreshJWTToken(w, token)
	if err != nil {
		if errors.Is(err, store.ErrSessionStoreUnavailable) {
			Fail(w, http.StatusServiceUnavailable, "认证服务暂时不可用")
			return
		}
		log.Printf("令牌刷新失败: %v\n", err)
		Fail(w, http.StatusUnauthorized, "令牌刷新失败，请重新登录")
		return
	}
	response := dto.LoginResponse{Token: newToken, ExpiresAt: expiresAt}
	middleware.SetCSRFToken(w, middleware.GetCSRFTokenByCookie(r), expiresAt)
	OK(w, response)
}

// recordLogin 写一条登录日志（成功或失败）。
//
// 日志写失败不影响登录结果，只打印到服务端日志：
// 不能因为日志表出问题就把所有人挡在门外。
func (c *AuthController) recordLogin(r *http.Request, userID uint64, status int8, failureReason string) {
	err := c.LoginLogService.RecordLogin(r.Context(), userID, string(constants.LoginTypeUsername),
		middleware.ClientIP(r), r.UserAgent(), status, failureReason)
	if err != nil {
		log.Printf("登录日志写入失败: %v\n", err)
	}
}

// setCSRFCookie 下发 CSRF Token Cookie（供受 CSRF 保护的写请求使用）
func setCSRFCookie(w http.ResponseWriter, expiresAt time.Time) {
	csrfToken, err := middleware.GenerateCSRFToken()
	if err != nil {
		return
	}
	middleware.SetCSRFToken(w, csrfToken, expiresAt)
}
