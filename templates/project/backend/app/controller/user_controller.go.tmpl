// GetUserList 用户列表（POST /admin/user/list）
func (c *UserController) GetUserList(w http.ResponseWriter, r *http.Request) {
	var req dto.UserListRequest
	if !BindJSON(w, r, &req) {
		return
	}
	req.Normalize()
	resp, err := c.UserService.GetUserList(r.Context(), req.PageNo, req.PageSize, req.UsernameMobileEmail, req.Status)
	if err != nil {
		Fail(w, http.StatusInternalServerError, err.Error())
		return
	}
	OK(w, resp)
}

// GetUserInfo 用户详情（含角色权限，POST /admin/user/info）
func (c *UserController) GetUserInfo(w http.ResponseWriter, r *http.Request) {
	var req dto.UserIDRequest
	if !BindJSON(w, r, &req) {
		return
	}
	if req.UserID == 0 {
		Fail(w, http.StatusBadRequest, "用户ID不能为空")
		return
	}
	user, err := c.UserService.GetUserInfo(r.Context(), req.UserID)
	if err != nil {
		Fail(w, http.StatusInternalServerError, err.Error())
		return
	}
	permissions, err := c.RoleService.GetUserRolesAndPermissions(r.Context(), req.UserID)
	if err != nil {
		Fail(w, http.StatusInternalServerError, err.Error())
		return
	}
	OK(w, map[string]interface{}{
		"user":        user,
		"permissions": permissions,
	})
}

// AddUser 新增用户（POST /admin/user/add）
func (c *UserController) AddUser(w http.ResponseWriter, r *http.Request) {
	var req dto.AddUserRequest
	if !BindJSON(w, r, &req) {
		return
	}
	if len(req.Username) < 5 || len(req.Username) > 20 {
		Fail(w, http.StatusBadRequest, "用户名长度必须在5-20位之间")
		return
	}
	userID, err := c.UserService.AddUser(r.Context(), &req)
	if err != nil {
		Fail(w, http.StatusInternalServerError, err.Error())
		return
	}
	// 分配角色
	if len(req.RoleIDs) > 0 {
		if err := c.RoleService.UpdateUserRoles(r.Context(), userID, req.RoleIDs); err != nil {
			Fail(w, http.StatusInternalServerError, err.Error())
			return
		}
	}
	OK(w, map[string]string{"status": "success"})
}

// UpdateUser 更新用户（POST /admin/user/update）
func (c *UserController) UpdateUser(w http.ResponseWriter, r *http.Request) {
	var req dto.UpdateUserRequest
	if !BindJSON(w, r, &req) {
		return
	}
	if req.UserID == 0 {
		Fail(w, http.StatusBadRequest, "用户ID不能为空")
		return
	}
	if err := c.UserService.UpdateUser(r.Context(), &req); err != nil {
		Fail(w, http.StatusInternalServerError, err.Error())
		return
	}
	// 可选：更新密码
	if req.Password != "" {
		if err := c.AuthService.UpdateUserPassword(r.Context(), req.UserID, req.Password); err != nil {
			Fail(w, http.StatusInternalServerError, err.Error())
			return
		}
	}
	// 更新角色
	if err := c.RoleService.UpdateUserRoles(r.Context(), req.UserID, req.RoleIDs); err != nil {
		Fail(w, http.StatusInternalServerError, err.Error())
		return
	}
	OK(w, map[string]string{"status": "success"})
}

