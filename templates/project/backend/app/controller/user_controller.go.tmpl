package controller

import (
	"net/http"

	"github.com/google/wire"
	"{{ .Module }}/app/dto"
	"{{ .Module }}/app/middleware"
	"{{ .Module }}/app/service"
)

// UserController 当前用户（个人信息）控制器
type UserController struct {
	AuthService *service.AuthService
	UserService *service.AdminUserService
	RoleService *service.AdminRoleService
}

// UserControllerSet wire provider set
var UserControllerSet = wire.NewSet(wire.Struct(new(UserController), "*"))

// GetCurrentUserInfo 获取当前用户信息（GET /admin/user/current-info）
func (c *UserController) GetCurrentUserInfo(w http.ResponseWriter, r *http.Request) {
	userID, ok := middleware.CurrentUserIDFromJWT(r)
	if !ok {
		Fail(w, http.StatusUnauthorized, "未授权访问")
		return
	}
	info, err := c.AuthService.GetCurrentUserInfo(r.Context(), userID)
	if err != nil {
		Fail(w, http.StatusInternalServerError, err.Error())
		return
	}
	OK(w, info)
}

// UpdateProfile 更新当前用户个人信息（POST /admin/user/update-profile）
func (c *UserController) UpdateProfile(w http.ResponseWriter, r *http.Request) {
	userID, ok := middleware.CurrentUserIDFromJWT(r)
	if !ok {
		Fail(w, http.StatusUnauthorized, "未授权访问")
		return
	}
	var req dto.UpdateProfileRequest
	if !BindJSON(w, r, &req) {
		return
	}
	if err := c.AuthService.UpdateProfile(r.Context(), userID, &req); err != nil {
		Fail(w, http.StatusInternalServerError, err.Error())
		return
	}
	OK(w, map[string]string{"status": "success"})
}

