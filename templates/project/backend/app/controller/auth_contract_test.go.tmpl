// TestRefreshTokenWriteFailureAfterRotation 轮换已成功、但写入新令牌失败：
// 返回 401、不下发 Cookie，旧会话已被消费（失败即关闭，用户需重新登录）。
func TestRefreshTokenWriteFailureAfterRotation(t *testing.T) {
