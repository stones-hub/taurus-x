// assertFixedJWTInvalidResponse JWT 校验失败的响应：data 恰好是固定提示，且不含 leaked 原文。
func assertFixedJWTInvalidResponse(t *testing.T, recorder *httptest.ResponseRecorder, leaked string) {
	t.Helper()
	var body struct {
		Data string `json:"data"`
	}
	if err := json.Unmarshal(recorder.Body.Bytes(), &body); err != nil {
		t.Fatal(err)
	}
	if body.Data != middleware.JWTInvalidMessage {
		t.Fatalf("JWT 校验失败应返回固定提示 %q，实际 %q", middleware.JWTInvalidMessage, body.Data)
	}
	if leaked != "" && bytes.Contains(recorder.Body.Bytes(), []byte(leaked)) {
		t.Fatalf("响应回显了 JWT 校验的错误原文: %s", recorder.Body.String())
	}
}

// TestAdminChainRejectsInvalidTokensWithFixedMessage 过期、签名不对、格式错误的令牌走 /admin/** 认证链：
// 401、不访问会话存储、不进入业务处理，响应只有固定提示（不含 JWT 库的错误文本）。
func TestAdminChainRejectsInvalidTokensWithFixedMessage(t *testing.T) {
	sessions := authPolicyConfig(t, false)
	taurus.Container.Config.MergeMap(map[string]interface{}{"http": map[string]interface{}{
		"jwt": map[string]interface{}{"enabled": true},
	}})
	reached := 0
	chain := middleware.JWTMiddleware()(middleware.SessionValidatorMiddleware()(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
		reached++
		OK(w, map[string]bool{"reached": true})
	})))
	secret := taurus.Container.Config.GetString("http.jwt.secret")
	expired, err := jwt.NewWithClaims(jwt.SigningMethodHS256, &tcrypt.Claims{
		Uid: "7", Username: "policy-user",
		RegisteredClaims: jwt.RegisteredClaims{ID: "expired-admin-session", ExpiresAt: jwt.NewNumericDate(time.Now().Add(-time.Hour))},
	}).SignedString([]byte(secret))
	if err != nil {
		t.Fatal(err)
	}
	wrongKey, err := tcrypt.GenerateTokenWithExpiration("7", "policy-user", "policy-test", secret+"-different-key", time.Hour)
	if err != nil {
		t.Fatal(err)
	}
	for name, token := range map[string]string{"过期": expired, "签名不对": wrongKey, "格式错误": "malformed-jwt"} {
		_, _, validateErr := middleware.ValidateJWTToken(token)
		if validateErr == nil {
			t.Fatalf("%s: fixture must be invalid", name)
		}
		req := httptest.NewRequest(http.MethodGet, "http://example.test/admin/user/info", nil)
		req.AddCookie(&http.Cookie{Name: middleware.JWTTokenKey, Value: token})
		recorder := httptest.NewRecorder()
		logs := captureLog(t)
		chain.ServeHTTP(recorder, req)
		// 客户端只拿固定提示，但服务端日志必须留下可诊断的失败原因
		if !strings.Contains(logs.String(), "reason="+strconv.Quote(validateErr.Error())) {
			t.Fatalf("%s: 服务端日志缺少失败原因 %q，实际 %q", name, validateErr.Error(), logs.String())
		}
		if strings.Contains(logs.String(), token) && len(token) > 20 {
			t.Fatalf("%s: 服务端日志不应记录令牌本身", name)
		}
		if authPolicyCode(t, recorder) != 401 || reached != 0 || sessions.validations != 0 {
			t.Fatalf("%s: admin chain accepted an invalid token or consulted the session store", name)
		}
		assertFixedJWTInvalidResponse(t, recorder, validateErr.Error())
	}
}

// TestJWTFailureLogCannotBeSplitByPath URL.Path 是解码后的值，%0a 会变成真换行：
// 失败日志对路径和原因转义输出，一次失败只占一条物理行，原因仍然可读。
func TestJWTFailureLogCannotBeSplitByPath(t *testing.T) {
	authPolicyConfig(t, false)
	taurus.Container.Config.MergeMap(map[string]interface{}{"http": map[string]interface{}{
		"jwt": map[string]interface{}{"enabled": true},
	}})
	chain := middleware.JWTMiddleware()(http.HandlerFunc(func(http.ResponseWriter, *http.Request) {
		t.Fatal("invalid token reached the handler")
	}))
	req := httptest.NewRequest(http.MethodGet, "http://example.test/admin/user/info%0a2026/11/02%2000:00:00%20FORGED%20login%20ok%0d%0a", nil)
	if !strings.Contains(req.URL.Path, "\n") {
		t.Fatalf("fixture path must contain a decoded newline, got %q", req.URL.Path)
	}
	req.AddCookie(&http.Cookie{Name: middleware.JWTTokenKey, Value: "malformed-jwt"})
	_, _, validateErr := middleware.ValidateJWTToken("malformed-jwt")
	logs := captureLog(t)
	recorder := httptest.NewRecorder()
	chain.ServeHTTP(recorder, req)
	if authPolicyCode(t, recorder) != 401 {
		t.Fatal("invalid token must be rejected")
	}
	out := logs.String()
	if lines := strings.Count(out, "\n"); lines != 1 || !strings.HasSuffix(out, "\n") {
		t.Fatalf("一次 JWT 失败应只写一条物理行，实际 %d 行: %q", lines, out)
	}
	if strings.Contains(out, "\r") {
		t.Fatalf("日志里不应出现原始回车: %q", out)
	}
	if !strings.Contains(out, `FORGED login ok\r\n`) || !strings.Contains(out, "reason="+strconv.Quote(validateErr.Error())) {
		t.Fatalf("日志应保留转义后的路径与可诊断的原因，实际 %q", out)
	}
}

// TestAdminChainRejectsTokenWithoutExpiry 缺 exp 的令牌走 /admin/** 的认证链
// （JWTMiddleware + SessionValidatorMiddleware）必须返回 401，且不访问会话存储；
// 同一条链上合法令牌能放行，证明拒绝来自缺 exp 而不是链本身没开。
func TestAdminChainRejectsTokenWithoutExpiry(t *testing.T) {
	sessions := authPolicyConfig(t, false)
	taurus.Container.Config.MergeMap(map[string]interface{}{"http": map[string]interface{}{
		"jwt": map[string]interface{}{"enabled": true},
	}})
	reached := 0
	chain := middleware.JWTMiddleware()(middleware.SessionValidatorMiddleware()(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
		reached++
		OK(w, map[string]bool{"reached": true})
	})))
	noExpiry, err := jwt.NewWithClaims(jwt.SigningMethodHS256, &tcrypt.Claims{
		Uid: "7", Username: "policy-user",
		RegisteredClaims: jwt.RegisteredClaims{ID: "no-expiry-admin-session"},
	}).SignedString([]byte(taurus.Container.Config.GetString("http.jwt.secret")))
	if err != nil {
		t.Fatal(err)
	}
	req := httptest.NewRequest(http.MethodGet, "http://example.test/admin/user/info", nil)
	req.AddCookie(&http.Cookie{Name: middleware.JWTTokenKey, Value: noExpiry})
	recorder := httptest.NewRecorder()
	chain.ServeHTTP(recorder, req)
	if authPolicyCode(t, recorder) != 401 || reached != 0 || sessions.validations != 0 {
		t.Fatal("admin chain accepted a token without exp or consulted the session store")
	}
	// 拒绝原因必须是缺 exp（直接校验同一个令牌确认），但响应只给固定提示，不回显 JWT 库的错误原文
	if _, _, err := middleware.ValidateJWTToken(noExpiry); !errors.Is(err, middleware.ErrJWTMissingExpiry) {
		t.Fatalf("fixture must be rejected for missing exp, got %v", err)
	}
	assertFixedJWTInvalidResponse(t, recorder, middleware.ErrJWTMissingExpiry.Error())
	valid, err := middleware.GenerateJWTToken(context.Background(), "7", "policy-user", 1)
	if err != nil {
		t.Fatal(err)
	}
	req = httptest.NewRequest(http.MethodGet, "http://example.test/admin/user/info", nil)
	req.AddCookie(&http.Cookie{Name: middleware.JWTTokenKey, Value: valid})
	recorder = httptest.NewRecorder()
	chain.ServeHTTP(recorder, req)
	if authPolicyCode(t, recorder) != 200 || reached != 1 || sessions.validations != 1 {
		t.Fatal("admin chain rejected a valid token")
	}
}

// headerOnlyTokenCases 把令牌放在 Cookie 以外的位置（Bearer / jwt_token 请求头）。
func headerOnlyTokenCases(token string) map[string]func(*http.Request) {
	return map[string]func(*http.Request){
		"bearer":      func(r *http.Request) { r.Header.Set("Authorization", "Bearer "+token) },
		"jwt_token 头": func(r *http.Request) { r.Header.Set(middleware.JWTTokenKey, token) },
	}
}

// TestAdminChainRejectsHeaderOnlyToken 浏览器端令牌只走 HttpOnly Cookie：
// 同一个合法令牌放在 Authorization: Bearer 或 jwt_token 请求头里（不带 Cookie）访问 /admin/**，
// 必须返回 401，且不访问会话存储、不进入业务 Handler。
// 同一个令牌放进 Cookie 能放行，证明拒绝来自「令牌位置不对」而不是令牌本身无效。
func TestAdminChainRejectsHeaderOnlyToken(t *testing.T) {
	sessions := authPolicyConfig(t, false)
	taurus.Container.Config.MergeMap(map[string]interface{}{"http": map[string]interface{}{
		"jwt": map[string]interface{}{"enabled": true},
	}})
	reached := 0
	chain := middleware.JWTMiddleware()(middleware.SessionValidatorMiddleware()(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
		reached++
		OK(w, map[string]bool{"reached": true})
	})))
	valid, err := middleware.GenerateJWTToken(context.Background(), "7", "policy-user", 1)
	if err != nil {
		t.Fatal(err)
	}
	for name, set := range headerOnlyTokenCases(valid) {
		req := httptest.NewRequest(http.MethodGet, "http://example.test/admin/user/info", nil)
		set(req)
		recorder := httptest.NewRecorder()
		chain.ServeHTTP(recorder, req)
		if authPolicyCode(t, recorder) != 401 || reached != 0 || sessions.validations != 0 {
			t.Fatalf("%s: admin chain accepted a token outside the cookie", name)
		}
	}
	req := httptest.NewRequest(http.MethodGet, "http://example.test/admin/user/info", nil)
	req.AddCookie(&http.Cookie{Name: middleware.JWTTokenKey, Value: valid})
	recorder := httptest.NewRecorder()
	chain.ServeHTTP(recorder, req)
	if authPolicyCode(t, recorder) != 200 || reached != 1 || sessions.validations != 1 {
		t.Fatal("admin chain rejected the same token in the cookie")
	}
}

// TestRefreshRejectsHeaderOnlyToken 刷新接口同样只认 Cookie：CSRF 正确、合法令牌只放在
// Authorization: Bearer 或 jwt_token 头里时返回 401，不校验、不轮换会话，也不下发任何 Cookie。
// 既直接调 Handler，也走与生产路由同构的刷新链（AuthRequest + JWT + 会话校验 + Handler）。
func TestRefreshRejectsHeaderOnlyToken(t *testing.T) {
	sessions := authPolicyConfig(t, false)
	taurus.Container.Config.MergeMap(map[string]interface{}{"http": map[string]interface{}{
		"jwt": map[string]interface{}{"enabled": true},
	}})
	valid, err := middleware.GenerateJWTToken(context.Background(), "7", "policy-user", 1)
	if err != nil {
		t.Fatal(err)
	}
	controller := &AuthController{}
	refreshChain := middleware.AuthRequestMiddleware(true)(middleware.JWTMiddleware()(middleware.SessionValidatorMiddleware()(http.HandlerFunc(controller.RefreshToken))))
	for _, handler := range []http.Handler{http.HandlerFunc(controller.RefreshToken), refreshChain} {
		for name, set := range headerOnlyTokenCases(valid) {
			req := authPolicyRequest("/user/refresh-token", nil, "")
			set(req)
			recorder := httptest.NewRecorder()
			handler.ServeHTTP(recorder, req)
			if authPolicyCode(t, recorder) != 401 || len(recorder.Result().Cookies()) != 0 || recorder.Header().Get(middleware.JWTTokenKey) != "" {
				t.Fatalf("%s: refresh accepted a token outside the cookie", name)
			}
			if sessions.validations != 0 || sessions.rotations != 0 {
				t.Fatalf("%s: refresh consulted or rotated the session store", name)
			}
		}
	}
	recorder := httptest.NewRecorder()
	refreshChain.ServeHTTP(recorder, authPolicyRequest("/user/refresh-token", nil, valid))
	if authPolicyCode(t, recorder) != 200 || sessions.rotations != 1 {
		t.Fatal("refresh chain rejected the same token in the cookie")
	}
	assertJWTCookie(t, recorder, false, false)
}

func TestAuthMethodAndCSRFBeforeSideEffects(t *testing.T) {
	controller := &AuthController{}
	for _, handler := range []http.HandlerFunc{controller.Login, controller.Logout, controller.RefreshToken} {
		for _, method := range []string{http.MethodGet, http.MethodHead, http.MethodPut, http.MethodDelete, http.MethodOptions} {
			recorder := httptest.NewRecorder()
			handler(recorder, httptest.NewRequest(method, "/", nil))
			if recorder.Code != 405 || recorder.Header().Get("Allow") != "POST" || len(recorder.Result().Cookies()) != 0 {
				t.Fatal("unsupported method changed state")
			}
		}
	}
	authPolicyConfig(t, false)
	for _, handler := range []http.HandlerFunc{controller.Login, controller.Logout, controller.RefreshToken} {
		for _, origin := range []string{"", "null", "https://untrusted.test"} {
			recorder := httptest.NewRecorder()
			req := authPolicyRequest("/", nil, "")
			req.Header.Set("Origin", origin)
			handler(recorder, req)
			if recorder.Code != 403 || len(recorder.Result().Cookies()) != 0 {
				t.Fatal("untrusted auth source changed state")
			}
		}
	}
	token, err := middleware.GenerateJWTToken(context.Background(), "7", "policy-user", 1)
	if err != nil {
		t.Fatal(err)
	}
	for _, handler := range []http.HandlerFunc{controller.Logout, controller.RefreshToken} {
		recorder := httptest.NewRecorder()
		req := authPolicyRequest("/", nil, token)
		req.Header.Del(middleware.CSRFTokenKey)
		handler(recorder, req)
		if recorder.Code != 403 || len(recorder.Result().Cookies()) != 0 {
			t.Fatal("missing CSRF accepted")
		}
		mismatch := httptest.NewRecorder()
		req.Header.Set(middleware.CSRFTokenKey, "mismatched-csrf-marker")
		handler(mismatch, req)
		if mismatch.Code != 403 || len(mismatch.Result().Cookies()) != 0 {
			t.Fatal("mismatched CSRF accepted")
		}
	}
}

func TestLogoutExpiredCookiePolicyThroughRoute(t *testing.T) {
	for _, secure := range []bool{false, true} {
		t.Run(map[bool]string{false: "http", true: "secure"}[secure], func(t *testing.T) {
			sessions := authPolicyConfig(t, secure)
			controller := &AuthController{}
			manager := router.NewRouterManager()
			manager.AddRouterGroup(router.RouteGroup{
				Prefix:     "/auth",
				Middleware: []router.MiddlewareFunc{middleware.LogoutRequestMiddleware()},
				Routes: []router.Router{
					{Path: "/logout", Handler: http.HandlerFunc(controller.Logout)},
				},
			})
			mux := manager.LoadRoutes()
			secret := taurus.Container.Config.GetString("http.jwt.secret")
			expired, err := jwt.NewWithClaims(jwt.SigningMethodHS256, &tcrypt.Claims{
				Uid: "7", Username: "policy-user",
				RegisteredClaims: jwt.RegisteredClaims{ID: "expired-policy-session", ExpiresAt: jwt.NewNumericDate(time.Now().Add(-time.Hour))},
			}).SignedString([]byte(secret))
			if err != nil {
				t.Fatal(err)
			}
			if _, _, err := middleware.ValidateJWTToken(expired); !errors.Is(err, jwt.ErrTokenExpired) {
				t.Fatalf("expired fixture must fail with ErrTokenExpired, got %v", err)
			}
			noExpiry, err := jwt.NewWithClaims(jwt.SigningMethodHS256, &tcrypt.Claims{
				Uid: "7", Username: "policy-user",
				RegisteredClaims: jwt.RegisteredClaims{ID: "no-expiry-policy-session"},
			}).SignedString([]byte(secret))
			if err != nil {
				t.Fatal(err)
			}
			if _, _, err := middleware.ValidateJWTToken(noExpiry); !errors.Is(err, middleware.ErrJWTMissingExpiry) {
				t.Fatalf("token without exp must be rejected, got %v", err)
			}
			invalidSignature, err := tcrypt.GenerateTokenWithExpiration("7", "policy-user", "policy-test", secret+"-different-key", time.Hour)
			if err != nil {
				t.Fatal(err)
			}
			for _, token := range []string{"", expired, noExpiry, invalidSignature, "malformed-jwt"} {
				for _, handler := range []http.Handler{http.HandlerFunc(controller.Logout), mux} {
					req := httptest.NewRequest(http.MethodPost, "http://example.test/auth/logout", nil)
					req.Header.Set("Origin", "http://example.test")
					if token != "" {
						req.AddCookie(&http.Cookie{Name: middleware.JWTTokenKey, Value: token})
					}
					recorder := httptest.NewRecorder()
					handler.ServeHTTP(recorder, req)
					if authPolicyCode(t, recorder) != 200 {
						t.Fatal("non-authenticatable logout rejected")
					}
					assertJWTCookie(t, recorder, secure, true)
				}
			}
			if sessions.revocations != 0 || sessions.validations != 0 || sessions.rotations != 0 {
				t.Fatal("invalid JWT cleanup consulted or changed session store")
			}
			for _, token := range []string{"", expired, noExpiry} {
				req := httptest.NewRequest(http.MethodPost, "http://example.test/user/refresh-token", nil)
				req.Header.Set("Origin", "http://example.test")
				if token != "" {
					req.AddCookie(&http.Cookie{Name: middleware.JWTTokenKey, Value: token})
				}
				recorder := httptest.NewRecorder()
				middleware.AuthRequestMiddleware(true)(http.HandlerFunc(controller.RefreshToken)).ServeHTTP(recorder, req)
				if recorder.Code != 403 || len(recorder.Result().Cookies()) != 0 || sessions.rotations != 0 {
					t.Fatal("refresh bypassed strict CSRF for expired or absent JWT")
				}
			}
			for _, token := range []string{expired, noExpiry} {
				for _, handler := range []http.Handler{http.HandlerFunc(controller.RefreshToken), middleware.AuthRequestMiddleware(true)(http.HandlerFunc(controller.RefreshToken))} {
					recorder := httptest.NewRecorder()
					handler.ServeHTTP(recorder, authPolicyRequest("/user/refresh-token", nil, token))
					if authPolicyCode(t, recorder) != 401 || len(recorder.Result().Cookies()) != 0 || sessions.rotations != 0 || sessions.validations != 0 {
						t.Fatal("refresh with valid CSRF accepted an expired or exp-less JWT")
					}
				}
			}
			valid, err := middleware.GenerateJWTToken(context.Background(), "7", "policy-user", 1)
			if err != nil {
				t.Fatal(err)
			}
			for _, handler := range []http.Handler{http.HandlerFunc(controller.Logout), mux} {
				// 合法 JWT Cookie、但没有 CSRF Cookie 和 CSRF 头：必须 403，不吊销、不清 Cookie。
				missingCSRF := httptest.NewRequest(http.MethodPost, "http://example.test/auth/logout", nil)
				missingCSRF.Header.Set("Origin", "http://example.test")
				missingCSRF.AddCookie(&http.Cookie{Name: middleware.JWTTokenKey, Value: valid})
				missingCookies := httptest.NewRecorder()
				handler.ServeHTTP(missingCookies, missingCSRF)
				if missingCookies.Code != 403 || len(missingCookies.Result().Cookies()) != 0 || sessions.revocations != 0 {
					t.Fatal("valid JWT cookie logout bypassed missing CSRF cookies")
				}
				// 合法令牌只放在 Bearer / jwt_token 头里：它不是凭证，不能用来吊销会话；
				// 按「无可认证令牌」处理 —— 只清 Cookie，不访问会话存储。
				for name, set := range headerOnlyTokenCases(valid) {
					headerOnly := httptest.NewRequest(http.MethodPost, "http://example.test/auth/logout", nil)
					headerOnly.Header.Set("Origin", "http://example.test")
					set(headerOnly)
					recorder := httptest.NewRecorder()
					handler.ServeHTTP(recorder, headerOnly)
					if authPolicyCode(t, recorder) != 200 || sessions.revocations != 0 || sessions.validations != 0 {
						t.Fatalf("%s: header-only token was treated as a logout credential", name)
					}
					assertJWTCookie(t, recorder, secure, true)
				}
				for _, csrf := range []string{"", "mismatched-csrf-marker"} {
					req := authPolicyRequest("/auth/logout", nil, valid)
					req.Header.Set(middleware.CSRFTokenKey, csrf)
					recorder := httptest.NewRecorder()
					handler.ServeHTTP(recorder, req)
					if recorder.Code != 403 || len(recorder.Result().Cookies()) != 0 || sessions.revocations != 0 {
						t.Fatal("valid JWT logout bypassed CSRF")
					}
				}
			}
			sessions.revokeError = errors.New("simulated Redis outage")
			failed := httptest.NewRecorder()
			mux.ServeHTTP(failed, authPolicyRequest("/auth/logout", nil, valid))
			if authPolicyCode(t, failed) != 500 || len(failed.Result().Cookies()) != 0 || sessions.revocations != 1 {
				t.Fatal("Redis outage treated as an expired session")
			}
			sessions.revokeError = nil
			success := httptest.NewRecorder()
			mux.ServeHTTP(success, authPolicyRequest("/auth/logout", nil, valid))
			if authPolicyCode(t, success) != 200 || sessions.revocations != 2 {
				t.Fatal("valid logout failed to revoke")
			}
			assertJWTCookie(t, success, secure, true)
			for _, method := range []string{http.MethodGet, http.MethodPut, http.MethodOptions} {
				req := httptest.NewRequest(method, "http://example.test/auth/logout", nil)
				req.Header.Set("Origin", "http://example.test")
				req.AddCookie(&http.Cookie{Name: middleware.JWTTokenKey, Value: expired})
				recorder := httptest.NewRecorder()
				mux.ServeHTTP(recorder, req)
				if recorder.Code != 405 || recorder.Header().Get("Allow") != "POST" || len(recorder.Result().Cookies()) != 0 {
					t.Fatal("expired logout bypassed method protection")
				}
			}
			for _, origin := range []string{"", "null", "https://untrusted.test"} {
				req := httptest.NewRequest(http.MethodPost, "http://example.test/auth/logout", nil)
				req.Header.Set("Origin", origin)
				req.AddCookie(&http.Cookie{Name: middleware.JWTTokenKey, Value: expired})
				recorder := httptest.NewRecorder()
				mux.ServeHTTP(recorder, req)
				if recorder.Code != 403 || len(recorder.Result().Cookies()) != 0 {
					t.Fatal("expired logout bypassed source protection")
				}
			}
		})
	}
}
