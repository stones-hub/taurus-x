package model

import (
	"time"
)

// AdminUserRole 用户角色关联表
type AdminUserRole struct {
	ID        uint64    `json:"id" gorm:"primaryKey;autoIncrement;column:id;comment:自增ID"`
	UserID    uint64    `json:"user_id" gorm:"uniqueIndex:uk_user_role;index:idx_user_id;not null;column:user_id;comment:用户ID"`
	RoleID    uint64    `json:"role_id" gorm:"uniqueIndex:uk_user_role;index:idx_role_id;not null;column:role_id;comment:角色ID"`
	CreatedAt time.Time `json:"created_at" gorm:"not null;default:CURRENT_TIMESTAMP;column:created_at;comment:创建时间"`
	UpdatedAt time.Time `json:"updated_at" gorm:"not null;default:CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP;column:updated_at;comment:修改时间"`
}

func (AdminUserRole) TableName() string { return "admin_user_roles" }
