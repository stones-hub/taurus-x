// 输入校验工具：密码强度、手机号格式。
package helper

import (
	"fmt"
	"regexp"

	"github.com/stones-hub/taurus-pro-common/pkg/util/tvalid"
)

// ValidatePasswordStrength 验证密码强度（6-20 位，含字母和数字）
func ValidatePasswordStrength(password string) error {
	if len(password) < 6 {
		return fmt.Errorf("密码长度不能少于6位")
	}
	if len(password) > 20 {
		return fmt.Errorf("密码长度不能超过20位")
	}
	if !regexp.MustCompile(`[0-9]`).MatchString(password) ||
		!regexp.MustCompile(`[a-zA-Z]`).MatchString(password) {
		return fmt.Errorf("密码必须包含字母和数字")
	}
	return nil
}

// ValidateMobile 验证手机号格式
func ValidateMobile(mobile string) bool {
	return tvalid.IsValidPhone(mobile)
}
