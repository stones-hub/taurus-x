// 短信验证码工具（当前为伪实现：日志 + Redis）。
package helper

import (
	"context"
	"crypto/rand"
	"crypto/subtle"
	"fmt"
	"log"
	"math/big"
	"strconv"
	"strings"
	"time"

	"{{ .Module }}/internal/taurus"
)

// VerificationCodeManager 短信验证码管理器（基于 Redis）
type VerificationCodeManager struct {
	expires time.Duration
}

// NewVerificationCodeManager 创建验证码管理器
func NewVerificationCodeManager() *VerificationCodeManager {
	return &VerificationCodeManager{expires: 5 * time.Minute}
}

// GenerateCode 生成 6 位数字验证码
func (m *VerificationCodeManager) GenerateCode() (string, error) {
	code := ""
	for i := 0; i < 6; i++ {
		n, err := rand.Int(rand.Reader, big.NewInt(10))
		if err != nil {
			return "", err
		}
		code += strconv.Itoa(int(n.Int64()))
	}
	return code, nil
}

// SendSMSCode 发送短信验证码（当前伪实现：限频 + 存 Redis）
func (m *VerificationCodeManager) SendSMSCode(ctx context.Context, mobile string) (string, error) {
	if mobile == "" {
		return "", fmt.Errorf("手机号不能为空")
	}

	// 简单限频：1 分钟最多 1 次
	rateKey := fmt.Sprintf("sms:rate:1m:%s", mobile)
	if v, _ := taurus.Container.Redis.Get(ctx, rateKey); v != "" {
		return "", fmt.Errorf("发送过于频繁，请稍后再试")
	}
	_ = taurus.Container.Redis.Set(ctx, rateKey, "1", time.Minute)

	code, err := m.GenerateCode()
	if err != nil {
		return "", fmt.Errorf("生成验证码失败: %v", err)
	}

	// TODO: 接入第三方短信服务。
	// 绝不要把验证码写进日志：日志会落盘、会进日志平台，等于验证码公开。
	// 这里只记录「发给了谁」，手机号也做掩码。
	log.Printf("发送短信验证码到 %s\n", MaskMobile(mobile))

	key := fmt.Sprintf("verification_code:mobile:%s", mobile)
	if err := taurus.Container.Redis.Set(ctx, key, code, m.expires); err != nil {
		return "", fmt.Errorf("存储验证码失败: %v", err)
	}
	return code, nil
}

// VerifyCode 验证验证码（一次性）
func (m *VerificationCodeManager) VerifyCode(ctx context.Context, loginType, loginValue, inputCode string) (bool, error) {
	key := fmt.Sprintf("verification_code:%s:%s", loginType, loginValue)
	cached, err := taurus.Container.Redis.Get(ctx, key)
	if err != nil {
		return false, fmt.Errorf("获取验证码失败: %v", err)
	}
	if cached == "" {
		return false, fmt.Errorf("验证码不存在或已过期")
	}
	// 定长比较，避免按字节短路泄露「前几位猜对了」的时序信息
	if subtle.ConstantTimeCompare([]byte(cached), []byte(inputCode)) != 1 {
		return false, fmt.Errorf("验证码错误")
	}
	_ = taurus.Container.Redis.Del(ctx, key)
	return true, nil
}

// MaskMobile 手机号掩码（138****8000），用于日志输出。
// 非 11 位的输入按「保留首尾各 1 位」处理，短到无法掩码时整体打掉。
func MaskMobile(mobile string) string {
	n := len(mobile)
	switch {
	case n == 0:
		return ""
	case n >= 11:
		return mobile[:3] + strings.Repeat("*", n-7) + mobile[n-4:]
	case n > 2:
		return mobile[:1] + strings.Repeat("*", n-2) + mobile[n-1:]
	default:
		return strings.Repeat("*", n)
	}
}
