package helper

import (
	"strings"
	"testing"
)

// TestValidateJWTSigningKey_Rejects 不合格的密钥必须拒绝启动。
// 这里用的全是合成值，不是任何真实密钥。
func TestValidateJWTSigningKey_Rejects(t *testing.T) {
	cases := []struct {
		name   string
		secret string
	}{
		{"空串", ""},
		{"只有空白", "   \t\n"},
		{"配置占位符未替换", "${JWT_SECRET:JWT_SECRET_NOT_CONFIGURED}"},
		{"配置默认占位值", "JWT_SECRET_NOT_CONFIGURED"},
		{"配置默认占位值小写", "jwt_secret_not_configured"},
		{"历史弱默认值", "your-secret-key"},
		{"大小写变体弱默认值", "Your-Secret-Key"},
		{"常见口令", "password"},
		{"短密钥", "abc123"},
		{"刚好差一位", strings.Repeat("ab", 15) + "c"}, // 31 字符
		{"单字符重复", strings.Repeat("a", 64)},
	}

	for _, tc := range cases {
		tc := tc
		t.Run(tc.name, func(t *testing.T) {
			if err := ValidateJWTSigningKey(tc.secret); err == nil {
				t.Fatalf("密钥 %q 应被拒绝", tc.name)
			}
		})
	}
}

// TestValidateJWTSigningKey_Accepts 足够长且有熵的随机密钥应放行。
func TestValidateJWTSigningKey_Accepts(t *testing.T) {
	cases := []string{
		// 合成的 64 位 hex（与 openssl rand -hex 32 同形），不是真实密钥
		"0a1b2c3d4e5f60718293a4b5c6d7e8f90a1b2c3d4e5f60718293a4b5c6d7e8f9",
		strings.Repeat("ab", 16),                 // 刚好 32 字符
		"synthetic-test-key-for-unit-tests-0001", // 38 字符
	}
	for _, secret := range cases {
		if err := ValidateJWTSigningKey(secret); err != nil {
			t.Fatalf("长度 %d 的密钥应被接受，实际: %v", len(secret), err)
		}
	}
}

// TestValidateJWTSigningKey_MinLengthBoundary 边界：31 拒绝、32 接受。
func TestValidateJWTSigningKey_MinLengthBoundary(t *testing.T) {
	base := "0123456789abcdef0123456789abcdef" // 32 字符
	if len(base) != minJWTSecretLength {
		t.Fatalf("测试前提错误: base 长度 %d", len(base))
	}
	if err := ValidateJWTSigningKey(base[:minJWTSecretLength-1]); err == nil {
		t.Fatal("31 字符应被拒绝")
	}
	if err := ValidateJWTSigningKey(base); err != nil {
		t.Fatalf("32 字符应被接受，实际: %v", err)
	}
}

// 合成的 64 位 hex（与 openssl rand -hex 32 同形），不是真实密钥
const syntheticStrongSecret = "0a1b2c3d4e5f60718293a4b5c6d7e8f90a1b2c3d4e5f60718293a4b5c6d7e8f9"

// recordingConfig 记录自检到底读了哪些配置键。
type recordingConfig struct {
	values map[string]string
	reads  []string
}

func (c *recordingConfig) getString(key string) string {
	c.reads = append(c.reads, key)
	return c.values[key]
}

func (c *recordingConfig) read(key string) bool {
	for _, k := range c.reads {
		if k == key {
			return true
		}
	}
	return false
}

// TestValidateStartupSecurity_NeverConsultsJWTEnabled 自检不得读 http.jwt.enabled。
//
// 这是调用契约，不是风格问题：登录签发 / 刷新 / 解析 Token 都直接用
// http.jwt.secret，不经过 JWTMiddleware 的开关。按 enabled=false 跳过自检
// 就等于允许密钥没配好仍然提供签名功能。
func TestValidateStartupSecurity_NeverConsultsJWTEnabled(t *testing.T) {
	cfg := &recordingConfig{values: map[string]string{
		JWTSecretConfigKey: "jwt_secret_not_configured",
		// 即使配置里明确关掉 JWT 中间件，自检也必须照常拒绝弱密钥
		"http.jwt.enabled": "false",
	}}

	if err := ValidateStartupSecurity(cfg.getString); err == nil {
		t.Fatal("弱密钥必须拒绝启动，不能因为 http.jwt.enabled=false 就跳过")
	}
	if !cfg.read(JWTSecretConfigKey) {
		t.Fatalf("自检必须读取 %s，实际读了 %v", JWTSecretConfigKey, cfg.reads)
	}
	if cfg.read("http.jwt.enabled") {
		t.Fatalf("自检不得读取 http.jwt.enabled，实际读了 %v", cfg.reads)
	}
}

// TestValidateStartupSecurity_AcceptsStrongSecret 密钥合格时放行，且只读密钥这一个键。
func TestValidateStartupSecurity_AcceptsStrongSecret(t *testing.T) {
	cfg := &recordingConfig{values: map[string]string{JWTSecretConfigKey: syntheticStrongSecret}}
	if err := ValidateStartupSecurity(cfg.getString); err != nil {
		t.Fatalf("合格密钥应放行，实际: %v", err)
	}
	if len(cfg.reads) != 1 || cfg.reads[0] != JWTSecretConfigKey {
		t.Fatalf("自检只应读取 %s，实际读了 %v", JWTSecretConfigKey, cfg.reads)
	}
}

// TestValidateStartupSecurity_NilGetterFailsClosed 拿不到配置读取器时拒绝启动，
// 不能当成「没配置就算通过」。
func TestValidateStartupSecurity_NilGetterFailsClosed(t *testing.T) {
	if err := ValidateStartupSecurity(nil); err == nil {
		t.Fatal("配置读取器为空时必须拒绝启动")
	}
}

// TestValidateStartupSecurity_MissingKeyFailsClosed 配置里压根没有这个键时，
// 读到空串，必须拒绝。
func TestValidateStartupSecurity_MissingKeyFailsClosed(t *testing.T) {
	cfg := &recordingConfig{values: map[string]string{}}
	if err := ValidateStartupSecurity(cfg.getString); err == nil {
		t.Fatal("密钥未配置时必须拒绝启动")
	}
}
