package lifecycle

import (
	"context"
	"errors"
	"sync"
	"testing"
	"time"
)

// recorder 记录阶段顺序与每个阶段拿到的剩余预算。
type recorder struct {
	mu     sync.Mutex
	events []string
}

func (r *recorder) add(e string) {
	r.mu.Lock()
	defer r.mu.Unlock()
	r.events = append(r.events, e)
}

func (r *recorder) list() []string {
	r.mu.Lock()
	defer r.mu.Unlock()
	return append([]string(nil), r.events...)
}

// TestPlan_SlowHTTPDoesNotConsumeLaterBudgets HTTP 阶段把自己的预算用光（模拟慢请求），
// 日志排空阶段仍拿到完整预算，资源关闭照常执行，顺序是 HTTP → 强制关闭 → 排空 → 资源关闭。
func TestPlan_SlowHTTPDoesNotConsumeLaterBudgets(t *testing.T) {
	rec := &recorder{}
	var drainRemaining, httpTook time.Duration
	start := time.Now()
	err := Plan{
		Budget: Budget{HTTP: 150 * time.Millisecond, DrainLogs: 400 * time.Millisecond, Cleanup: 400 * time.Millisecond},
		StopHTTP: func(ctx context.Context) error {
			rec.add("http")
			<-ctx.Done() // 慢请求一直不结束
			return ctx.Err()
		},
		ForceCloseHTTP: func() error { httpTook = time.Since(start); rec.add("force-close"); return nil },
		DrainLogs: func(ctx context.Context) error {
			deadline, _ := ctx.Deadline()
			drainRemaining = time.Until(deadline)
			rec.add("drain")
			return nil
		},
		Cleanups: []func(){func() { rec.add("cleanup-1") }, func() { rec.add("cleanup-db") }},
		Logf:     func(string, ...any) {},
	}.Run()
	if err == nil || !errors.Is(err, context.DeadlineExceeded) {
		t.Fatalf("HTTP 超时应体现在返回的错误里，实际 %v", err)
	}
	want := []string{"http", "force-close", "drain", "cleanup-1", "cleanup-db"}
	if got := rec.list(); len(got) != len(want) {
		t.Fatalf("阶段顺序 %v，期望 %v", got, want)
	} else {
		for i := range want {
			if got[i] != want[i] {
				t.Fatalf("阶段顺序 %v，期望 %v", got, want)
			}
		}
	}
	if httpTook < 140*time.Millisecond || httpTook > 300*time.Millisecond {
		t.Fatalf("HTTP 阶段应恰好用掉自己的 150ms 预算，实际 %v", httpTook)
	}
	if drainRemaining < 350*time.Millisecond {
		t.Fatalf("日志排空阶段只拿到 %v，被 HTTP 阶段占用了预算", drainRemaining)
	}
	if elapsed := time.Since(start); elapsed > 150*time.Millisecond+400*time.Millisecond+400*time.Millisecond {
		t.Fatalf("退出耗时 %v 超过三段预算之和", elapsed)
	}
}

// TestPlan_DrainTimeoutStillRunsCleanup 排空超时（返回错误）后资源关闭照常执行。
func TestPlan_DrainTimeoutStillRunsCleanup(t *testing.T) {
	rec := &recorder{}
	err := Plan{
		Budget:   Budget{HTTP: time.Second, DrainLogs: 50 * time.Millisecond, Cleanup: time.Second},
		StopHTTP: func(context.Context) error { rec.add("http"); return nil },
		DrainLogs: func(ctx context.Context) error {
			<-ctx.Done()
			rec.add("drain-timeout")
			return errors.New("drain timeout")
		},
		Cleanups: []func(){func() { rec.add("cleanup") }},
		Logf:     func(string, ...any) {},
	}.Run()
	if err == nil {
		t.Fatal("排空超时应返回错误")
	}
	got := rec.list()
	if len(got) != 3 || got[0] != "http" || got[1] != "drain-timeout" || got[2] != "cleanup" {
		t.Fatalf("阶段顺序 %v", got)
	}
}

// TestPlan_CleanupTimeoutIsBounded cleanup 卡住时不无限等待：在 Cleanup 预算到期时返回错误；
// HTTP 正常结束时不调用强制关闭。
func TestPlan_CleanupTimeoutIsBounded(t *testing.T) {
	release := make(chan struct{})
	defer close(release)
	forced := false
	start := time.Now()
	err := Plan{
		Budget:         Budget{HTTP: time.Second, DrainLogs: time.Second, Cleanup: 80 * time.Millisecond},
		StopHTTP:       func(context.Context) error { return nil },
		ForceCloseHTTP: func() error { forced = true; return nil },
		Cleanups:       []func(){func() { <-release }},
		Logf:           func(string, ...any) {},
	}.Run()
	if err == nil {
		t.Fatal("cleanup 超时应返回错误")
	}
	if elapsed := time.Since(start); elapsed > 500*time.Millisecond {
		t.Fatalf("cleanup 超时后仍等待了 %v", elapsed)
	}
	if forced {
		t.Fatal("HTTP 正常关闭时不应强制关闭连接")
	}
}

func TestResolveHTTPShutdown(t *testing.T) {
	get := func(v string) func(string) string { return func(string) string { return v } }
	if d, err := ResolveHTTPShutdown(get("")); err != nil || d != DefaultHTTPShutdownSeconds*time.Second {
		t.Fatalf("未配置应取默认值，实际 %v %v", d, err)
	}
	if d, err := ResolveHTTPShutdown(get("3")); err != nil || d != 3*time.Second {
		t.Fatalf("应按配置生效，实际 %v %v", d, err)
	}
	for _, bad := range []string{"0", "-1", "abc", "11"} {
		if _, err := ResolveHTTPShutdown(get(bad)); err == nil {
			t.Fatalf("%q 应拒绝", bad)
		}
	}
}
