package permission

import (
	"context"

	"{{ .Module }}/app/model"
)

// RoleServiceIface 角色服务接口（用于打破 permission ↔ service 循环依赖）
type RoleServiceIface interface {
	IsUserSuperAdmin(ctx context.Context, userID uint64) (bool, error)
	GetUserAllPermissions(ctx context.Context, userID uint64) ([]model.AdminPermissions, error)
}
