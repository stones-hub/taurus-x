package store

import (
	"context"
	"fmt"
	"time"

	"{{ .Module }}/internal/taurus"
)

// AuthRedisStore 认证安全相关 Redis 存取（改密时间戳等）
type AuthRedisStore struct{}

// NewAuthRedisStore 构造实例
func NewAuthRedisStore() *AuthRedisStore {
	return &AuthRedisStore{}
}

// InvalidateUserSessions 更新最近一次改密时间戳（使旧 token 失效）
func (s *AuthRedisStore) InvalidateUserSessions(userID uint64) error {
	if taurus.Container == nil || taurus.Container.Redis == nil {
		return nil
	}
	key := fmt.Sprintf("user:last_pw_change:%d", userID)
	return taurus.Container.Redis.Set(context.Background(), key, fmt.Sprintf("%d", time.Now().Unix()), 0)
}

// GetLastPasswordChangeAt 读取最近一次改密时间戳（未设置返回 0）
func (s *AuthRedisStore) GetLastPasswordChangeAt(userID uint64) (int64, error) {
	if taurus.Container == nil || taurus.Container.Redis == nil {
		return 0, nil
	}
	key := fmt.Sprintf("user:last_pw_change:%d", userID)
	v, err := taurus.Container.Redis.Get(context.Background(), key)
	if err != nil || v == "" {
		return 0, err
	}
	var ts int64
	_, scanErr := fmt.Sscan(v, &ts)
	return ts, scanErr
}
