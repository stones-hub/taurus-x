// TestSession_RedisFailureFailsClosed Redis 故障期间一律拒绝，恢复后恢复正常。
func TestSession_RedisFailureFailsClosed(t *testing.T) {
	s, kv, versions := newTestStore(t, 7)
	mustRegister(t, s, 7, "jti-a", versions.current(t, 7))

	kv.failing = true
	if _, err := s.ValidateSession(7, "jti-a"); !errors.Is(err, ErrSessionStoreUnavailable) {
		t.Fatalf("Redis 故障时应返回存储不可用，实际: %v", err)
	}
	if _, err := s.ValidateSession(7, "jti-a"); errors.Is(err, ErrSessionRevoked) {
		t.Fatal("存储故障不能被当成「已吊销」之外的放行信号")
	}
	if err := s.RegisterSession(7, "jti-c", time.Hour, versions.current(t, 7)); !errors.Is(err, ErrSessionStoreUnavailable) {
		t.Fatalf("Redis 故障时登记应失败，实际: %v", err)
	}

	kv.failing = false
	if _, err := s.ValidateSession(7, "jti-a"); err != nil {
		t.Fatalf("Redis 恢复后原有会话应重新可用，实际: %v", err)
	}
}

