	kv := newFakeKV()
	kv.data[sessionJTIKeyPrefix+"jti-a"] = "7:1"
	s := NewAuthRedisStoreWith(kv, newFakeAuthVersions()) // 版本表里没有 7
	if _, err := s.ValidateSession(7, "jti-a"); !errors.Is(err, ErrSessionRevoked) {
