// TestSetAuthVersionResolver 包级注入入口可用（main 靠它打破依赖方向）。
func TestSetAuthVersionResolver(t *testing.T) {
	prev := globalAuthVersionResolver()
	t.Cleanup(func() { SetAuthVersionResolver(prev) })

	versions := newFakeAuthVersions(7)
	SetAuthVersionResolver(versions)

	kv := newFakeKV()
	kv.data[sessionJTIKeyPrefix+"jti-a"] = "7:1"
	s := NewAuthRedisStoreWith(kv, nil) // 实例未指定来源，走包级注入
	if _, err := s.ValidateSession(7, "jti-a"); err != nil {
		t.Fatalf("注入后应能正常校验，实际: %v", err)
	}
	versions.bump(7)
	if _, err := s.ValidateSession(7, "jti-a"); !errors.Is(err, ErrSessionRevoked) {
		t.Fatalf("注入的来源变更后应生效，实际: %v", err)
	}
}

