// TestSession_RegisterRejectsBadInput 缺少 jti 或无效有效期不能静默成功，
// 否则会出现「登记失败但请求照常放行」的空洞。
func TestSession_RegisterRejectsBadInput(t *testing.T) {
	s, _, _ := newTestStore(t, 7)
	if err := s.RegisterSession(7, "", time.Hour, 1); err == nil {
		t.Fatal("空 jti 应登记失败")
	}
	if err := s.RegisterSession(7, "jti-a", 0, 1); err == nil {
		t.Fatal("无效有效期应登记失败")
	}
}

// TestSession_CorruptedValue 存储里的值被写坏时按已吊销处理，不放行。
func TestSession_CorruptedValue(t *testing.T) {
	kv := newFakeKV()
	kv.data[sessionJTIKeyPrefix+"jti-x"] = "not-a-session"
	s := NewAuthRedisStoreWith(kv, newFakeAuthVersions(7))
	if _, err := s.ValidateSession(7, "jti-x"); !errors.Is(err, ErrSessionRevoked) {
		t.Fatalf("非法会话值应被拒绝，实际: %v", err)
	}
}

func mustRegister(t *testing.T, s *AuthRedisStore, uid uint64, jti string, version int64) {
	t.Helper()
	if err := s.RegisterSession(uid, jti, time.Hour, version); err != nil {
		t.Fatalf("登记会话 %s 失败: %v", jti, err)
	}
}
