# ------------------------- 用法 -------------------------
# 复制为 .env.local 后填真实值；.env.local 已被 .gitignore 忽略，不要提交。
#
# 重要：这里的值会被「原样」代入 config/ 下的配置文件（文本替换，再做
# YAML/TOML 解析），所以一律不要加引号，也不要在值里写 `}` 和换行。
#   对的：JWT_SECRET=aVeryLongRandomSecret
#   错的：JWT_SECRET="aVeryLongRandomSecret"   # 引号会变成密钥的一部分

# ------------------------- 应用级配置 -------------------------
VERSION=v0.0.1
APP_NAME={{ .ProjectName }}
APP_CONFIG=./config

# ------------------------- HTTP 服务 -------------------------
SERVER_ADDRESS=0.0.0.0
SERVER_PORT=9080
# 内部接口授权码。**这是示例值，上生产必须改**。
AUTHORIZATION=654321

# ------------------------- 数据库 -------------------------
DB_NAME={{ .DBName }}
DB_DSN=root:root@tcp(127.0.0.1:3306)/{{ .DBName }}?charset=utf8mb4&parseTime=True&loc=Local&timeout=10s&readTimeout=30s&writeTimeout=30s

# ------------------------- 日志表保留期 -------------------------
# 访问日志、操作日志、登录日志、前端错误上报这四张表的保留天数。
# 后端启动后有后台任务按此保留期分批删除过期记录（启动 5～15 分钟后跑第一次，随机错开以免多实例同时清理；之后每 24 小时一次）。
#   180  默认值，保留半年
#   0    永久保留，不清理
# 负数或非整数会让服务拒绝启动：这个值控制不可逆的删除，配错了要立刻知道，
# 而不是按一个猜出来的保留期把数据删掉。
LOG_RETENTION_DAYS=180

# ------------------------- 后台接口限流 -------------------------
# 后台接口（/admin/** 与 /user/refresh-token）按**来源 IP** 限流的参数。
# 语义：单 IP 突发上限 BURST 次，之后每秒回补 PER_SECOND 次。
# 同一个 IP 对所有后台接口共享这一份额度，不是每个路由组各一份。
#
# 刻意没有「全站总额度」：后台是已登录用户的操作面，全站单桶意味着一个人
# 刷接口就能把所有人挡在外面。要卡全站总量请在入口层（Nginx / WAF）做。
#   300 / 10  默认值。10 次/秒远高于人工点击速率，300 的突发够一个复杂表单页
#             并发拉十几个下拉选项；脚本化的批量拉取会被压住。
#   0 / 0     关闭后台限流（比如网关上已经限过了）
# **两项必须同时为 0**。只写一个 0、负数、非整数都会让服务拒绝启动：
# 读不出是想关限流还是手误，而「悄悄没限流」正是最不该出现的那种失败。
# PER_SECOND 另有上限 10000：后台接口是人在点，这个量级只可能是手误
# （多打了 0，或把「每分钟」当成了「每秒」），同样拒绝启动。
ADMIN_RATE_LIMIT_BURST=300
ADMIN_RATE_LIMIT_PER_SECOND=10

# ------------------------- Redis -------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# 无密码时整行留空值（不要写 ""）
REDIS_PASSWORD=

# ------------------------- JWT -------------------------
# 必填，本文件刻意留空：本文件会进版本库，带现成密钥等于把签名密钥一起提交，
# 任何拿到仓库的人都能自己签发合法 Token。
#
# 在**不进库**的 .env.local 里自己生成一个（至少 32 字符）：
#     openssl rand -hex 32
#
# 留空或仍是占位值时服务会拒绝启动（见 app/helper/startup_check.go），这是有意的。
JWT_SECRET=
