# ------------------------- 用法 -------------------------
# 复制为 .env.local 后填真实值；.env.local 已被 .gitignore 忽略，不要提交。
#
# 重要：这里的值会被「原样」代入 config/ 下的配置文件（文本替换，再做
# YAML/TOML 解析），所以一律不要加引号，也不要在值里写 `}` 和换行。
#   对的：JWT_SECRET=aVeryLongRandomSecret
#   错的：JWT_SECRET="aVeryLongRandomSecret"   # 引号会变成密钥的一部分

# ------------------------- 应用级配置 -------------------------
VERSION=v0.0.1
APP_NAME={{ .ProjectName }}
APP_CONFIG=./config

# ------------------------- HTTP 服务 -------------------------
SERVER_ADDRESS=0.0.0.0
SERVER_PORT=9080
# 内部接口授权码。**这是示例值，上生产必须改**。
AUTHORIZATION=654321

# ------------------------- 数据库 -------------------------
DB_NAME={{ .DBName }}
DB_DSN=root:root@tcp(127.0.0.1:3306)/{{ .DBName }}?charset=utf8mb4&parseTime=True&loc=Local&timeout=10s&readTimeout=30s&writeTimeout=30s

# ------------------------- Redis -------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# 无密码时整行留空值（不要写 ""）
REDIS_PASSWORD=

# ------------------------- JWT -------------------------
# 必填。留空会退回 config/autoload/http/http.yaml 里的弱默认值，
# 等于任何人都能自己签发合法 token。
#
# 下面这个值是 taurus-x 生成本项目时随机产生的（每个项目都不同），可以直接用于本地开发。
# ⚠️ 但本文件会进版本库，所以**上生产前必须重新生成一个、且只写进不进库的 .env.local**：
#     openssl rand -hex 32
JWT_SECRET={{ .JWTSecret }}
