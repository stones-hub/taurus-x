// TestComponentsCleanupTimeoutIsPositive 组件关闭的总上限至少覆盖必选组件（DB / Redis / 日志 / cron）。
func TestComponentsCleanupTimeoutIsPositive(t *testing.T) {
	if min := dbCleanupTimeout + redisCleanupTimeout + logCleanupTimeout + cronCleanupTimeout; ComponentsCleanupTimeout < min {
		t.Fatalf("ComponentsCleanupTimeout=%v 小于必选组件上限之和 %v", ComponentsCleanupTimeout, min)
