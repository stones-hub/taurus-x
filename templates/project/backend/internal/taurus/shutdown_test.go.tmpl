// TestRunBounded_StuckStopReturnsAtTimeout 忽略 ctx 的关闭动作只等到上限，返回带超时的错误。
func TestRunBounded_StuckStopReturnsAtTimeout(t *testing.T) {
	release := make(chan struct{})
	defer close(release)
	start := time.Now()
	err := runBounded(80*time.Millisecond, func(context.Context) error { <-release; return nil })
	if elapsed := time.Since(start); elapsed > 500*time.Millisecond {
		t.Fatalf("卡住的关闭让调用方等了 %v", elapsed)
	}
	if !errors.Is(err, context.DeadlineExceeded) {
		t.Fatalf("应返回超时错误，实际 %v", err)
	}
}

// TestRunBounded_ResultAndPanic 正常返回透传错误；panic 转成错误，不让进程崩溃。
func TestRunBounded_ResultAndPanic(t *testing.T) {
	want := errors.New("close failed")
	if err := runBounded(time.Second, func(context.Context) error { return want }); !errors.Is(err, want) {
		t.Fatalf("应透传关闭错误，实际 %v", err)
	}
	if err := runBounded(time.Second, func(context.Context) error { panic("boom") }); err == nil || !strings.Contains(err.Error(), "boom") {
		t.Fatalf("panic 应转成错误，实际 %v", err)
	}
	if err := runBounded(time.Second, func(context.Context) error { return nil }); err != nil {
		t.Fatalf("正常关闭应返回 nil，实际 %v", err)
	}
}

// TestBoundedCleanup_StuckComponentDoesNotBlockNext 模拟 wire 生成的逆序回滚：
// 一个组件的关闭卡住，后面的组件照样被关闭，总耗时只多出卡住那一步的上限。
func TestBoundedCleanup_StuckComponentDoesNotBlockNext(t *testing.T) {
	release := make(chan struct{})
	defer close(release)
	var closed []string
	cleanups := []func(){
		boundedCleanup("database", time.Second, func(context.Context) error { closed = append(closed, "database"); return nil }),
		boundedCleanup("redis", time.Second, func(context.Context) error { closed = append(closed, "redis"); return nil }),
		boundedCleanup("stuck", 80*time.Millisecond, func(context.Context) error { <-release; return nil }),
	}
	start := time.Now()
	for i := len(cleanups) - 1; i >= 0; i-- {
		cleanups[i]()
	}
	if elapsed := time.Since(start); elapsed > 500*time.Millisecond {
		t.Fatalf("卡住的组件让回滚等了 %v", elapsed)
	}
	if len(closed) != 2 || closed[0] != "redis" || closed[1] != "database" {
		t.Fatalf("卡住的组件之后的组件都应按逆序关闭，实际 %v", closed)
	}
}

