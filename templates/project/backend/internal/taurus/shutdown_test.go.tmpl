// TestShutdownGRPC_LongStreamIsForceClosed 一条不结束的流（组件默认注册的 Health/Watch）
// 不会让 gRPC 关闭无限等待：优雅关闭在期限到时返回，强制关闭断开流；关闭一开始就不再接新连接。
func TestShutdownGRPC_LongStreamIsForceClosed(t *testing.T) {
	srv, _, err := grpcserver.NewServer()
	if err != nil {
		t.Fatal(err)
	}
	lis, err := net.Listen("tcp", "127.0.0.1:0")
	if err != nil {
		t.Fatal(err)
	}
	served := make(chan error, 1)
	go func() { served <- srv.Server().Serve(lis) }()

	conn, err := grpc.NewClient("passthrough:///"+lis.Addr().String(), grpc.WithTransportCredentials(insecure.NewCredentials()))
	if err != nil {
		t.Fatal(err)
	}
	defer conn.Close()
	stream, err := healthpb.NewHealthClient(conn).Watch(context.Background(), &healthpb.HealthCheckRequest{})
	if err != nil {
		t.Fatal(err)
	}
	if resp, err := stream.Recv(); err != nil || resp.GetStatus() != healthpb.HealthCheckResponse_SERVING {
		t.Fatalf("Watch 首条应为 SERVING: %v %v", resp, err)
	}

	ctx, cancel := context.WithTimeout(context.Background(), 200*time.Millisecond)
	defer cancel()
	start := time.Now()
	err = ShutdownGRPC(ctx, srv)
	if elapsed := time.Since(start); !errors.Is(err, context.DeadlineExceeded) || elapsed > time.Second {
		t.Fatalf("长流存在时优雅关闭应在期限到时返回超时: err=%v elapsed=%v", err, elapsed)
	}
	// 优雅关闭已经关掉监听：新连接被拒
	if c, err := net.DialTimeout("tcp", lis.Addr().String(), 200*time.Millisecond); err == nil {
		_ = c.Close()
		t.Fatal("开始关闭后不应再接受新连接")
	}

	if err := ForceStopGRPC(srv); err != nil {
		t.Fatal(err)
	}
	recvErr := make(chan error, 1)
	go func() {
		_, err := stream.Recv()
		recvErr <- err
	}()
	select {
	case err := <-recvErr:
		if err == nil {
			t.Fatal("强制关闭后长流应收到错误")
		}
	case <-time.After(2 * time.Second):
		t.Fatal("强制关闭后长流仍未结束")
	}
	select {
	case err := <-served:
		if err != nil {
			t.Fatalf("关闭后 Serve 应返回 nil，实际 %v", err)
		}
	case <-time.After(2 * time.Second):
		t.Fatal("强制关闭后 Serve 没有返回")
	}
}

