// blockingCloseHandler OnClose 一直阻塞到 release 关闭（模拟卡住的用户回调）。
type blockingCloseHandler struct {
	connected chan struct{}
	release   chan struct{}
}

func (h *blockingCloseHandler) OnConnect(*tcpserver.Connection) {
	select {
	case h.connected <- struct{}{}:
	default:
	}
}
func (h *blockingCloseHandler) OnMessage(*tcpserver.Connection, interface{}) {}
func (h *blockingCloseHandler) OnClose(*tcpserver.Connection) {
	if h.release != nil {
		<-h.release
	}
}
func (h *blockingCloseHandler) OnError(*tcpserver.Connection, error) {}

// startTestTCP 在随机空闲端口上启动一个 TCP 服务并建立一个客户端连接。
func startTestTCP(t *testing.T, h *blockingCloseHandler) (*tcpserver.Server, string, <-chan struct{}, net.Conn) {
	t.Helper()
	probe, err := net.Listen("tcp", "127.0.0.1:0")
	if err != nil {
		t.Fatal(err)
	}
	addr := probe.Addr().String()
	_ = probe.Close()

	proto, err := protocol.NewProtocol(protocol.WithType(protocol.JSON))
	if err != nil {
		t.Fatal(err)
	}
	srv, _, err := tcpserver.NewServer(addr, proto, h)
	if err != nil {
		t.Fatal(err)
	}
	served := make(chan struct{})
	go func() {
		defer close(served)
		_ = srv.Start()
	}()
	var conn net.Conn
	deadline := time.Now().Add(2 * time.Second)
	for {
		conn, err = net.DialTimeout("tcp", addr, 200*time.Millisecond)
		if err == nil || time.Now().After(deadline) {
			break
		}
		time.Sleep(10 * time.Millisecond)
	}
	if err != nil {
		t.Fatalf("连不上测试 TCP 服务: %v", err)
	}
	select {
	case <-h.connected:
	case <-time.After(2 * time.Second):
		t.Fatal("服务端没有收到连接")
	}
	return srv, addr, served, conn
}

// TestShutdownTCP_StuckCallbackIsBounded 用户的 OnClose 卡住时，关闭在期限到时返回错误；
// 关闭一开始就不再接新连接。
//
// 客户端连接何时断开取决于组件版本：新版（v0.2.0 起有 StopContext）的 Stop 先关 socket、不调用回调，
// 客户端立即看到断开；旧版 v0.1.0 的 Stop 先同步调用 OnClose 再关 socket，回调卡住期间
// 这个连接不会断开（v0.1.0 的已知限制，v0.2.0 已解决），回调返回后才断开。
func TestShutdownTCP_StuckCallbackIsBounded(t *testing.T) {
	h := &blockingCloseHandler{connected: make(chan struct{}, 1), release: make(chan struct{})}
	released := false
	defer func() {
		if !released {
			close(h.release)
		}
	}()
	srv, addr, served, conn := startTestTCP(t, h)
	defer conn.Close()

	ctx, cancel := context.WithTimeout(context.Background(), 200*time.Millisecond)
	defer cancel()
	start := time.Now()
	err := ShutdownTCP(ctx, srv, served)
	if elapsed := time.Since(start); !errors.Is(err, context.DeadlineExceeded) || elapsed > time.Second {
		t.Fatalf("回调卡住时应在期限到时返回超时: err=%v elapsed=%v", err, elapsed)
	}
	if c, err := net.DialTimeout("tcp", addr, 200*time.Millisecond); err == nil {
		_ = c.Close()
		t.Fatal("开始关闭后不应再接受新连接")
	}
	if _, ok := any(srv).(tcpContextStopper); !ok {
		close(h.release)
		released = true
	}
	_ = conn.SetReadDeadline(time.Now().Add(2 * time.Second))
	if _, err := conn.Read(make([]byte, 1)); err == nil {
		t.Fatal("关闭后客户端连接应被断开")
	}
}

// TestShutdownTCP_CompletesWhenCallbacksReturn 回调正常返回时关闭在期限内完成。
func TestShutdownTCP_CompletesWhenCallbacksReturn(t *testing.T) {
	h := &blockingCloseHandler{connected: make(chan struct{}, 1)}
	srv, _, served, conn := startTestTCP(t, h)
	defer conn.Close()
	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
	defer cancel()
	if err := ShutdownTCP(ctx, srv, served); err != nil {
		t.Fatalf("回调正常时关闭应成功，实际 %v", err)
	}
	// 重复关闭无害（组件 cleanup 兜底会再调一次）
	ctx2, cancel2 := context.WithTimeout(context.Background(), time.Second)
	defer cancel2()
	if err := ShutdownTCP(ctx2, srv, served); err != nil {
		t.Fatalf("重复关闭应成功，实际 %v", err)
	}
}

// TestShutdownTCP_FallbackCleanupNeverReportsFalseSuccess 组件 cleanup 兜底（拿不到 Start 的结束信号，served=nil）
// 不能把「没确认」说成成功：
//   - 旧版 v0.1.0：入口阶段的第一次 Stop 还卡在 OnClose 里，第二次 Stop 因 CAS 立刻返回，
//     必须返回 errStopUnconfirmed，而且不能等（快速返回本身没问题，问题是不能报成功）；
//   - 新版：StopContext 等的是真实的结束信号，回调卡住就到期返回超时。
func TestShutdownTCP_FallbackCleanupNeverReportsFalseSuccess(t *testing.T) {
	h := &blockingCloseHandler{connected: make(chan struct{}, 1), release: make(chan struct{})}
	defer close(h.release)
	srv, _, served, conn := startTestTCP(t, h)
	defer conn.Close()

	ingress, cancel := context.WithTimeout(context.Background(), 100*time.Millisecond)
	defer cancel()
	if err := ShutdownTCP(ingress, srv, served); err == nil {
		t.Fatal("回调卡住时入口阶段的关闭不应成功")
	}

	ctx, cancel2 := context.WithTimeout(context.Background(), 300*time.Millisecond)
	defer cancel2()
	err := ShutdownTCP(ctx, srv, nil)
	if _, ok := any(srv).(tcpContextStopper); ok {
		if !errors.Is(err, context.DeadlineExceeded) {
			t.Fatalf("新版组件回调仍卡住时兜底关闭应超时，实际 %v", err)
		}
	} else if !errors.Is(err, errStopUnconfirmed) {
		t.Fatalf("旧版组件的第二次 Stop 立刻返回，兜底关闭必须报告无法确认，实际 %v", err)
	}
}

// TestShutdownTCP_FallbackAfterCleanStop 回调都已正常结束后的兜底关闭：新版能确认完成（nil），
// 旧版仍然只能报告无法确认（它没有任何完成信号可查）。
func TestShutdownTCP_FallbackAfterCleanStop(t *testing.T) {
	h := &blockingCloseHandler{connected: make(chan struct{}, 1)}
	srv, _, served, conn := startTestTCP(t, h)
	defer conn.Close()
	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
	defer cancel()
	if err := ShutdownTCP(ctx, srv, served); err != nil {
		t.Fatalf("回调正常时关闭应成功，实际 %v", err)
	}
	err := ShutdownTCP(ctx, srv, nil)
	if _, ok := any(srv).(tcpContextStopper); ok {
		if err != nil {
			t.Fatalf("新版组件已真实完成，兜底关闭应返回 nil，实际 %v", err)
		}
	} else if !errors.Is(err, errStopUnconfirmed) {
		t.Fatalf("旧版组件兜底关闭应报告无法确认，实际 %v", err)
	}
}
