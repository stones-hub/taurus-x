// fakeLegacyConsul 只有不接收 ctx 的 DeregisterService（旧版 taurus-pro-consul v0.2.0 及以前）。
type fakeLegacyConsul struct {
	calls   atomic.Int32
	release chan struct{}
}

func (f *fakeLegacyConsul) DeregisterService(string) error {
	f.calls.Add(1)
	if f.release != nil {
		<-f.release
	}
	return nil
}

// fakeContextConsul 新版本的可取消注销。
type fakeContextConsul struct {
	fakeLegacyConsul
	ctxCalls atomic.Int32
}

func (f *fakeContextConsul) DeregisterServiceContext(ctx context.Context, _ string) error {
	f.ctxCalls.Add(1)
	<-ctx.Done()
	return ctx.Err()
}

// TestDeregisterService_PrefersCancellableAPI 组件支持 DeregisterServiceContext 时用它，期限到即中止。
func TestDeregisterService_PrefersCancellableAPI(t *testing.T) {
	f := &fakeContextConsul{}
	ctx, cancel := context.WithTimeout(context.Background(), 50*time.Millisecond)
	defer cancel()
	if err := deregisterService(ctx, f, "svc-1"); !errors.Is(err, context.DeadlineExceeded) {
		t.Fatalf("应返回 ctx 的超时，实际 %v", err)
	}
	if f.ctxCalls.Load() != 1 || f.calls.Load() != 0 {
		t.Fatalf("应只走可取消的注销: ctx=%d legacy=%d", f.ctxCalls.Load(), f.calls.Load())
	}
}

// TestDeregisterService_LegacyIsBoundedButHonest 旧版本只能限时等待：到期返回错误，
// 并在错误里说明请求取消不了；预先取消的 ctx 不再发出请求。
func TestDeregisterService_LegacyIsBoundedButHonest(t *testing.T) {
	f := &fakeLegacyConsul{release: make(chan struct{})}
	defer close(f.release)
	ctx, cancel := context.WithTimeout(context.Background(), 50*time.Millisecond)
	defer cancel()
	start := time.Now()
	err := deregisterService(ctx, f, "svc-1")
	if elapsed := time.Since(start); elapsed > 500*time.Millisecond {
		t.Fatalf("卡住的注销让退出等了 %v", elapsed)
	}
	if !errors.Is(err, context.DeadlineExceeded) || !strings.Contains(err.Error(), "不支持取消") {
		t.Fatalf("应返回超时并说明请求无法取消，实际 %v", err)
	}

	pre, cancelPre := context.WithCancel(context.Background())
	cancelPre()
	g := &fakeLegacyConsul{}
	if err := deregisterService(pre, g, "svc-1"); !errors.Is(err, context.Canceled) || g.calls.Load() != 0 {
		t.Fatalf("预先取消时不应发出请求: err=%v calls=%d", err, g.calls.Load())
	}
}

// TestConsulRegistration_DeregistersOnce 退出开始时注销过，组件 cleanup 不再重复注销；
// 第一次还卡着时，第二次调用也不会跟着卡住。
func TestConsulRegistration_DeregistersOnce(t *testing.T) {
	f := &fakeLegacyConsul{release: make(chan struct{})}
	r := &consulRegistration{client: f, id: "svc-1"}
	ctx, cancel := context.WithTimeout(context.Background(), 50*time.Millisecond)
	defer cancel()
	if err := r.deregister(ctx); err == nil {
		t.Fatal("卡住的注销应超时")
	}
	start := time.Now()
	if err := r.deregister(context.Background()); err != nil {
		t.Fatalf("重复注销应直接跳过，实际 %v", err)
	}
	if time.Since(start) > 100*time.Millisecond {
		t.Fatal("重复注销不应等第一次的结果")
	}
	close(f.release)
	if f.calls.Load() != 1 {
		t.Fatalf("只应注销一次，实际 %d 次", f.calls.Load())
	}
}

// TestDeregisterConsulService_NotRegistered 没有启用 Consul 时直接返回 nil。
func TestDeregisterConsulService_NotRegistered(t *testing.T) {
	prev := consulRegistered
