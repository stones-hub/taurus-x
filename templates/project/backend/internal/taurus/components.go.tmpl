{{- end }}
{{- if .Has.grpc }}
	GRPC *grpcserver.Server
{{- end }}
{{- if .Has.milvus }}
	Milvus milvus.Pool
{{- end }}
}

// envFileHint 环境变量文件不可用时统一追加的处理指引。
// 刻意只给路径和动作，不读取、不回显文件内容或任何配置值。
const envFileHint = "；请在 backend/ 目录下执行 `cp .env.example .env.local` 生成该文件并填好配置，" +
	"或检查当前运行用户对该文件及其各级目录是否有读权限（必要时 chown 运行用户 + chmod 640）"

// ensureEnvFileReadable 校验 -env 指定的环境变量文件存在、是普通文件且当前进程能读。
//
// 为什么要自己查：配置库 taurus-pro-config 的 Initialize 在加载 env 文件失败时
// 只打印 `Error loading .env file` 就继续走，进程会带着默认配置启动 ——
// 端口不监听、数据库反复 Access denied，而 supervisor / launchd 只看到「运行中」。
// 这里提前把它变成启动失败，由 bootstrap 的 log.Fatal 以非 0 码退出。
//
// env 为空串时（Docker 的 CMD 用 -env ""，变量直接来自容器环境）跳过检查，行为不变。
func ensureEnvFileReadable(env string) error {
	if env == "" {
		return nil
	}

	info, err := os.Stat(env)
	if err != nil {
		if os.IsNotExist(err) {
			return fmt.Errorf("环境变量文件 %s 不存在%s", env, envFileHint)
		}
		return fmt.Errorf("环境变量文件 %s 无法访问: %v%s", env, err, envFileHint)
	}
	if info.IsDir() {
		return fmt.Errorf("环境变量文件 %s 是一个目录（-env 必须指向文件，例如 -env .env.local）%s", env, envFileHint)
	}
	if !info.Mode().IsRegular() {
		return fmt.Errorf("环境变量文件 %s 不是普通文件（-env 必须指向文件，例如 -env .env.local）%s", env, envFileHint)
	}

	// Stat 通过不代表能读：目录权限、属组、ACL 都可能让 open 失败，所以实际打开一次。
	f, err := os.Open(env)
	if err != nil {
		return fmt.Errorf("环境变量文件 %s 打不开: %v%s", env, err, envFileHint)
	}
	return f.Close()
}

// ProvideConfigComponent 注入配置模块
func ProvideConfigComponent(opts *ConfigOptions) (*config.Config, error) {
	// 必须在 Initialize 之前：配置库读不到 env 文件时只打日志不报错，见 ensureEnvFileReadable
	if err := ensureEnvFileReadable(opts.Env); err != nil {
		return nil, err
	}

	configComponent := config.New(config.WithPrintEnable(opts.PrintEnable))
	if err := configComponent.Initialize(opts.ConfigPath, opts.Env); err != nil {
		return nil, fmt.Errorf("failed to initialize config: %v", err)
	}
	return configComponent, nil
}

// ProvideDbComponent 注入数据库模块
func ProvideDbComponent(cfg *config.Config) (map[string]*gorm.DB, func(), error) {
	if !cfg.GetBool("databases.enable") {
		return nil, func() {}, nil
	}

	rawList, ok := cfg.Get("databases.list").([]interface{})
	if !ok {
		return nil, func() {}, fmt.Errorf("databases.list is missing or malformed")
	}

	for _, raw := range rawList {
		dbOpts, ok := raw.(map[string]interface{})
		if !ok {
			return nil, func() {}, fmt.Errorf("databases.list item is malformed")
		}

		level := logger.Info
		switch asString(dbOpts["log_level"]) {
		case "info":
			level = logger.Info
		case "warn":
			level = logger.Warn
		case "error":
			level = logger.Error
		case "silent":
			level = logger.Silent
		}

		// 按天切分的 GORM 日志：logs/db_{{ .ProjectName }}-YYYY-MM-DD.log
		gormLogger := NewDailyGormLogger("logs", "db_{{ .ProjectName }}", level)

		if err := db.InitDB(
			db.WithMaxOpenConns(asInt(dbOpts["max_open_conns"])),
			db.WithMaxIdleConns(asInt(dbOpts["max_idle_conns"])),
			db.WithConnMaxLifetime(time.Duration(asInt(dbOpts["conn_max_lifetime"]))*time.Second),
			db.WithMaxRetries(asInt(dbOpts["max_retries"])),
			db.WithRetryDelay(asInt(dbOpts["retry_delay"])),
			db.WithDBName(asString(dbOpts["dbname"])),
			db.WithDBType(asString(dbOpts["dbtype"])),
			db.WithDSN(asString(dbOpts["dsn"])),
			db.WithLogger(gormLogger),
		); err != nil {
			return nil, func() {}, err
		}
	}

	log.Printf("%s🔗 -> Database all initialized successfully. %s\n", colorGreen, colorReset)
	return db.DbList(), func() {
		db.CloseDB()
		log.Printf("%s🔗 -> Clean up database components successfully. %s\n", colorGreen, colorReset)
	}, nil
}

// ProvideRedisComponent 注入 Redis 模块
func ProvideRedisComponent(cfg *config.Config) (*redisx.RedisClient, func(), error) {
	if !cfg.GetBool("redis.enable") {
		return nil, func() {}, nil
	}

	level := redisx.LogLevelInfo
	switch cfg.GetString("redis.logger_level") {
	case "debug":
		level = redisx.LogLevelDebug
	case "info":
		level = redisx.LogLevelInfo
	case "warn":
		level = redisx.LogLevelWarn
	case "error":
		level = redisx.LogLevelError
	}

	formatter := redisx.DefaultLogFormatter
	if cfg.GetString("redis.logger_fomatter") == "json" {
		formatter = redisx.JSONLogFormatter
	}

	redisLogger, err := redisx.NewRedisLogger(
		redisx.WithLogFilePath(cfg.GetString("redis.logger_path")),
		redisx.WithLogLevel(level),
		redisx.WithLogFormatter(formatter),
		redisx.WithLogMaxSize(cfg.GetInt("redis.logger_max_size")),
		redisx.WithLogMaxBackups(cfg.GetInt("redis.logger_max_backups")),
		redisx.WithLogMaxAge(cfg.GetInt("redis.logger_max_age")),
	)
	if err != nil {
		return nil, func() {}, err
	}

	if err := redisx.InitRedis(
		redisx.WithAddrs(cfg.GetStringSlice("redis.address")...),
		// 占位符默认值用了一个空格（配置库不允许空默认值），这里统一 TrimSpace
		redisx.WithPassword(strings.TrimSpace(cfg.GetString("redis.password"))),
		redisx.WithDB(cfg.GetInt("redis.db")),
		redisx.WithPoolSize(cfg.GetInt("redis.pool_size")),
		redisx.WithMinIdleConns(cfg.GetInt("redis.min_idle_conns")),
		redisx.WithTimeout(
			time.Duration(cfg.GetInt("redis.dial_timeout"))*time.Second,
			time.Duration(cfg.GetInt("redis.read_timeout"))*time.Second,
			time.Duration(cfg.GetInt("redis.write_timeout"))*time.Second),
		redisx.WithMaxRetries(cfg.GetInt("redis.max_retries")),
		redisx.WithLogging(redisLogger),
	); err != nil {
		return nil, func() {}, err
	}

	log.Printf("%s🔗 -> Redis all initialized successfully. %s\n", colorGreen, colorReset)
	return redisx.Redis, func() {
		redisx.Redis.Close()
		log.Printf("%s🔗 -> Clean up redis components successfully. %s\n", colorGreen, colorReset)
	}, nil
}

// ProvideHttpComponent 注入 HTTP 服务模块
func ProvideHttpComponent(cfg *config.Config) (*server.Server, error) {
	httpServer := server.NewServer(
		server.WithAddr(cfg.GetString("http.address")+":"+cfg.GetString("http.port")),
		server.WithReadTimeout(time.Duration(cfg.GetInt("http.read_timeout"))*time.Second),
		server.WithWriteTimeout(time.Duration(cfg.GetInt("http.write_timeout"))*time.Second),
		server.WithIdleTimeout(time.Duration(cfg.GetInt("http.idle_timeout"))*time.Second),
		server.WithMaxHeaderBytes(1<<20),
	)

	log.Printf("%s🔗 -> Http all initialized successfully. %s\n", colorGreen, colorReset)
	return httpServer, nil
}

// ProvideCronComponent 注入定时任务模块
func ProvideCronComponent(cfg *config.Config) (*cron.CronManager, func(), error) {
	if !cfg.GetBool("cron.enable") {
		return nil, func() {}, nil
	}

	location, err := time.LoadLocation(cfg.GetString("cron.location"))
	if err != nil {
		location, err = time.LoadLocation("Asia/Shanghai")
		if err != nil {
			return nil, func() {}, err
		}
	}

	cronOptions := []cron.Option{cron.WithLocation(location)}
	if cfg.GetBool("cron.enable_seconds") {
		cronOptions = append(cronOptions, cron.WithSeconds())
	}
	cronOptions = append(cronOptions, cron.WithConcurrencyMode(cron.ConcurrencyMode(cfg.GetInt("cron.concurrency_mode"))))

	cm := cron.New(cronOptions...)
	log.Printf("%s🔗 -> Cron all initialized successfully. %s\n", colorGreen, colorReset)

	return cm, func() {
		cm.GracefulStop(time.Second * 3)
		log.Printf("%s🔗 -> Clean up cron components successfully. %s\n", colorGreen, colorReset)
	}, nil
}

// ProvideLoggerComponent 注入日志模块
func ProvideLoggerComponent(cfg *config.Config) (*logx.Manager, func(), error) {
	rawList, ok := cfg.Get("loggers").([]interface{})
	if !ok {
		return nil, func() {}, fmt.Errorf("loggers is missing or malformed")
	}

	options := make([]logx.LoggerOptions, 0, len(rawList))
	for _, raw := range rawList {
		opts, ok := raw.(map[string]interface{})
		if !ok {
			return nil, func() {}, fmt.Errorf("loggers item is malformed")
		}
		options = append(options, logx.LoggerOptions{
			Name:       asString(opts["name"]),
			Prefix:     asString(opts["prefix"]),
			FilePath:   asString(opts["log_file_path"]),
			MaxSize:    asInt(opts["max_size"]),
			MaxBackups: asInt(opts["max_backups"]),
			MaxAge:     asInt(opts["max_age"]),
			Compress:   asBool(opts["compress"]),
			Formatter:  asString(opts["formatter"]),
			Level:      logx.Level(asInt(opts["log_level"])),
			Output:     logx.OutputType(asString(opts["output_type"])),
		})
	}

	manager, cleanup, err := logx.BuildManager(options...)
	if err != nil {
		log.Printf("%s🔗 -> Log all initialized failed. %s\n", colorRed, colorReset)
	} else {
		log.Printf("%s🔗 -> Log all initialized successfully. %s\n", colorGreen, colorReset)
	}

	return manager, func() {
		cleanup()
		log.Printf("%s🔗 -> Clean up log components successfully. %s\n", colorGreen, colorReset)
	}, err
}
