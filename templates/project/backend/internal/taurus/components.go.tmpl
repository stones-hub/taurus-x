// ProvideConsulComponent 注入 Consul 模块：建客户端并注册服务；
// cleanup 时注销服务再关闭客户端。consul.enable=false 时返回 nil，不影响启动。
func ProvideConsulComponent(cfg *config.Config) (*consul.Client, func(), error) {
	if !cfg.GetBool("consul.enable") {
		return nil, func() {}, nil
	}

	options := []consul.Option{
		consul.WithAddress(cfg.GetString("consul.client.address")),
		consul.WithTimeout(time.Duration(cfg.GetInt("consul.client.timeout")) * time.Second),
		consul.WithScheme(cfg.GetString("consul.client.scheme")),
		consul.WithDatacenter(cfg.GetString("consul.client.datacenter")),
		consul.WithWaitTime(time.Duration(cfg.GetInt("consul.client.wait_time")) * time.Second),
		consul.WithRetryTime(time.Duration(cfg.GetInt("consul.client.retry_time")) * time.Second),
		consul.WithMaxRetries(cfg.GetInt("consul.client.max_retrys")),
	}
	if token := cfg.GetString("consul.client.token"); token != "" {
		options = append(options, consul.WithToken(token))
	}
	if user, pass := cfg.GetString("consul.client.http_basic_auth.username"), cfg.GetString("consul.client.http_basic_auth.password"); user != "" && pass != "" {
		options = append(options, consul.WithBasicAuth(user, pass))
	}

	client, err := consul.NewClient(options...)
	if err != nil {
		return nil, func() {}, fmt.Errorf("consul.NewClient: %v", err)
	}

	meta := make(map[string]string)
	if rawMeta, ok := cfg.Get("consul.service.meta").(map[string]interface{}); ok {
		for k, v := range rawMeta {
			meta[k] = asString(v)
		}
	}

	serviceConfig := consul.ServiceConfig{
		Name:    cfg.GetString("consul.service.name"),
		ID:      cfg.GetString("consul.service.id"),
		Tags:    cfg.GetStringSlice("consul.service.tags"),
		Address: cfg.GetString("consul.service.address"),
		Port:    cfg.GetInt("consul.service.port"),
		Meta:    meta,
		Checks:  make([]*consul.CheckConfig, 0),
	}

	if healths, ok := cfg.Get("consul.service.healths").([]interface{}); ok {
		for _, raw := range healths {
			health, ok := raw.(map[string]interface{})
			if !ok {
				continue
			}

			header := make(map[string][]string)
			if rawHeader, ok := health["http_headers"].(map[string]interface{}); ok {
				for k, v := range rawHeader {
					values, ok := v.([]interface{})
					if !ok {
						continue
					}
					items := make([]string, 0, len(values))
					for _, item := range values {
						items = append(items, asString(item))
					}
					header[k] = items
				}
			}

			serviceConfig.Checks = append(serviceConfig.Checks, &consul.CheckConfig{
				HTTP:            asString(health["http"]),
				Method:          asString(health["http_method"]),
				Header:          header,
				TCP:             asString(health["tcp"]),
				Interval:        time.Duration(asInt(health["interval"])) * time.Second,
				Timeout:         time.Duration(asInt(health["timeout"])) * time.Second,
				DeregisterAfter: time.Duration(asInt(health["deregister_after"])) * time.Second,
				TLSSkipVerify:   asBool(health["tls_skip_verify"]),
			})
		}
	}

	if err := client.RegisterService(&serviceConfig); err != nil {
		client.Close()
		return nil, func() {}, fmt.Errorf("consul.RegisterService: %v", err)
	}

	log.Printf("%s🔗 -> Consul all initialized successfully. %s\n", colorGreen, colorReset)
	return client, func() {
		if err := client.DeregisterService(serviceConfig.ID); err != nil {
			log.Printf("%s🔗 -> Consul deregister service failed: %v. %s\n", colorRed, err, colorReset)
		}
		client.Close()
		log.Printf("%s🔗 -> Clean up consul components successfully. %s\n", colorGreen, colorReset)
	}, nil
}
