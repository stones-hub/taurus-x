// ProvideTCPComponent 注入 TCP 服务模块。
//
// 这里只创建实例、不开始监听：TCP 占用独立端口，由 app/bootstrap.go 与
// HTTP 一起启动，退出时在入口阶段与 HTTP 同时关闭（ShutdownTCP）。tcp.enable=false 时返回 nil，
// bootstrap 会跳过启动。cleanup 是兜底（重复关闭无害），同样有上限。
func ProvideTCPComponent(cfg *config.Config) (*tcpserver.Server, func(), error) {
	if !cfg.GetBool("tcp.enable") {
		return nil, func() {}, nil
	}

	proto, err := protocol.NewProtocol(protocol.WithType(protocol.ProtocolType(cfg.GetString("tcp.protocol"))))
	if err != nil {
		return nil, func() {}, fmt.Errorf("tcp protocol: %v", err)
	}

	// handler 在这里（app 包 init 里的 BuildComponents）就解析好了，所以自定义处理器必须在
	// 被 app 直接或间接导入的包（例如 app/hooks）的 init() 里用 tcpserver.RegisterHandler(name, h)
	// 注册（Go 保证被导入的包先完成初始化），名字与 config/autoload/tcp/tcp.yaml 的 tcp.handler 对齐。
	// app 包自己的 init、只被 main 导入的包、StartHook 都太晚。名字没注册时 GetHandler 不报错，
	// 静默回退到库自带的 default 处理器（只打日志、不回复）。
	handler := tcpserver.GetHandler(cfg.GetString("tcp.handler"))

	srv, _, err := tcpserver.NewServer(
		cfg.GetString("tcp.address"),
		proto,
		handler,
		tcpserver.WithMaxConnections(int32(cfg.GetInt("tcp.max_connections"))),
		tcpserver.WithConnectionMaxMessageSize(uint32(cfg.GetInt("tcp.max_message_size"))),
		tcpserver.WithConnectionBufferSize(cfg.GetInt("tcp.buffer_size")),
		tcpserver.WithConnectionIdleTimeout(time.Duration(cfg.GetInt("tcp.idle_timeout"))*time.Second),
		tcpserver.WithConnectionRateLimiter(cfg.GetInt("tcp.rate_limiter")),
	)
	if err != nil {
		return nil, func() {}, err
	}

	log.Printf("%s🔗 -> Tcp all initialized successfully. %s\n", colorGreen, colorReset)
	return srv, boundedCleanup("tcp", tcpCleanupTimeout, func(ctx context.Context) error {
		return ShutdownTCP(ctx, srv, nil)
	}), nil
}
{{- end }}
