// ProvideMilvusComponent 注入 Milvus 客户端池。
// milvus.enable=false 或 milvus.list 为空时返回 nil，不影响启动。
func ProvideMilvusComponent(cfg *config.Config) (milvus.Pool, func(), error) {
	if !cfg.GetBool("milvus.enable") {
		return nil, func() {}, nil
	}

	rawList, ok := cfg.Get("milvus.list").([]interface{})
	if !ok || len(rawList) == 0 {
		return nil, func() {}, nil
	}

	pool := milvus.NewPool()
	for _, raw := range rawList {
		item, ok := raw.(map[string]interface{})
		if !ok {
			continue
		}

		name := asString(item["name"])
		if name == "" {
			log.Printf("%s🔗 -> Milvus client name is empty, skipped. %s\n", colorRed, colorReset)
			continue
		}

		opts := make([]mclient.Option, 0, 8)
		if address := asString(item["address"]); address != "" {
			opts = append(opts, mclient.WithAddress(address))
		}
		if apiKey := asString(item["api_key"]); apiKey != "" {
			opts = append(opts, mclient.WithAPIKey(apiKey))
		} else if username, password := asString(item["username"]), asString(item["password"]); username != "" || password != "" {
			opts = append(opts, mclient.WithAuth(username, password))
		}
		if dbName := asString(item["db_name"]); dbName != "" {
			opts = append(opts, mclient.WithDatabase(dbName))
		}
		if asBool(item["enable_tls_auth"]) {
			opts = append(opts, mclient.WithTLS())
		}

		maxRetry := uint(3)
		if retry := asInt(item["max_retry"]); retry > 0 {
			maxRetry = uint(retry)
		}
		opts = append(opts, mclient.WithRetry(maxRetry, asDuration(item["max_retry_backoff"], 30*time.Second)))

		maxRecvMsgSize := math.MaxInt32
		if size := asInt(item["max_recv_msg_size"]); size > 0 {
			maxRecvMsgSize = size
		}

		permitWithoutStream := true
		if v, ok := item["permit_without_stream"].(bool); ok {
			permitWithoutStream = v
		}

		opts = append(opts, mclient.WithGrpcOpts(
			asDuration(item["keepalive_time"], 30*time.Second),
			asDuration(item["keepalive_timeout"], 10*time.Second),
			permitWithoutStream,
			asDuration(item["base_delay"], time.Second),
			asFloat(item["multiplier"], 1.6),
			asFloat(item["jitter"], 0.2),
			asDuration(item["max_delay"], 120*time.Second),
			asDuration(item["min_connect_timeout"], 20*time.Second),
			maxRecvMsgSize,
		))

		if asBool(item["disable_conn"]) {
			opts = append(opts, mclient.WithDisableConn(true))
		}

		if err := pool.Add(name, opts...); err != nil {
			log.Printf("%s🔗 -> Milvus add client %q failed: %v. %s\n", colorRed, name, err, colorReset)
		}
	}

	log.Printf("%s🔗 -> Milvus all initialized successfully. %s\n", colorGreen, colorReset)
	return pool, func() {
		pool.Close()
		log.Printf("%s🔗 -> Clean up milvus components successfully. %s\n", colorGreen, colorReset)
	}, nil
}
