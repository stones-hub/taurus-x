// ProvideTCPComponent 注入 TCP 服务模块。
//
// 这里只创建实例、不开始监听：TCP 占用独立端口，由 app/bootstrap.go 与
// HTTP 一起启动、一起优雅关闭。tcp.enable=false 时返回 nil，bootstrap 会跳过启动。
func ProvideTCPComponent(cfg *config.Config) (*tcpserver.Server, func(), error) {
	if !cfg.GetBool("tcp.enable") {
		return nil, func() {}, nil
	}

	proto, err := protocol.NewProtocol(protocol.WithType(protocol.ProtocolType(cfg.GetString("tcp.protocol"))))
	if err != nil {
		return nil, func() {}, fmt.Errorf("tcp protocol: %v", err)
	}

	// GetHandler 在注册表里找不到名字时会回退到库自带的 defaultHandler（只打日志），
	// 不会返回 nil。自定义处理器用 tcpserver.RegisterHandler(name, h) 在 init 里注册，
	// 名字与 config/autoload/tcp/tcp.yaml 的 tcp.handler 对齐。
	handler := tcpserver.GetHandler(cfg.GetString("tcp.handler"))

	srv, cleanup, err := tcpserver.NewServer(
		cfg.GetString("tcp.address"),
		proto,
		handler,
		tcpserver.WithMaxConnections(int32(cfg.GetInt("tcp.max_connections"))),
		tcpserver.WithConnectionMaxMessageSize(uint32(cfg.GetInt("tcp.max_message_size"))),
		tcpserver.WithConnectionBufferSize(cfg.GetInt("tcp.buffer_size")),
		tcpserver.WithConnectionIdleTimeout(time.Duration(cfg.GetInt("tcp.idle_timeout"))*time.Second),
		tcpserver.WithConnectionRateLimiter(cfg.GetInt("tcp.rate_limiter")),
	)
	if err != nil {
		return nil, func() {}, err
	}

	log.Printf("%s🔗 -> Tcp all initialized successfully. %s\n", colorGreen, colorReset)
	return srv, func() {
		cleanup()
		log.Printf("%s🔗 -> Clean up tcp components successfully. %s\n", colorGreen, colorReset)
	}, nil
}
{{- end }}
{{- if .Has.grpc }}

// ProvideGRPCComponent 注入 gRPC 服务模块。
//
// 这里只创建实例、不开始监听：gRPC 占用独立端口，由 app/bootstrap.go 与
// HTTP 一起启动、一起优雅关闭。grpc.enable=false 时返回 nil，bootstrap 会跳过启动。
func ProvideGRPCComponent(cfg *config.Config) (*grpcserver.Server, func(), error) {
	if !cfg.GetBool("grpc.enable") {
		return nil, func() {}, nil
	}

	options := []grpcserver.ServerOption{
		grpcserver.WithAddress(cfg.GetString("grpc.address")),
		grpcserver.WithMaxConns(cfg.GetInt("grpc.max_conns")),
	}

	if cfg.GetBool("grpc.keepalive.enabled") {
		options = append(options, grpcserver.WithKeepAlive(&keepalive.ServerParameters{
			MaxConnectionIdle:     time.Duration(cfg.GetInt("grpc.keepalive.max_connection_idle")) * time.Minute,
			MaxConnectionAge:      time.Duration(cfg.GetInt("grpc.keepalive.max_connection_age")) * time.Minute,
			MaxConnectionAgeGrace: time.Duration(cfg.GetInt("grpc.keepalive.max_connection_age_grace")) * time.Second,
			Time:                  time.Duration(cfg.GetInt("grpc.keepalive.time")) * time.Hour,
			Timeout:               time.Duration(cfg.GetInt("grpc.keepalive.timeout")) * time.Second,
		}))
	}

	if cfg.GetBool("grpc.tls.enabled") {
		// 双向 TLS：服务端证书 + CA 校验客户端证书
		cert, err := tls.LoadX509KeyPair(cfg.GetString("grpc.tls.crt"), cfg.GetString("grpc.tls.key"))
		if err != nil {
			return nil, func() {}, fmt.Errorf("grpc tls: failed to load key pair: %v", err)
		}

		caCert, err := os.ReadFile(cfg.GetString("grpc.tls.ca"))
		if err != nil {
			return nil, func() {}, fmt.Errorf("grpc tls: failed to read CA certificate: %v", err)
		}

		certPool := x509.NewCertPool()
		if !certPool.AppendCertsFromPEM(caCert) {
			return nil, func() {}, fmt.Errorf("grpc tls: failed to append CA certificate")
		}

		options = append(options, grpcserver.WithTLS(&tls.Config{
			Certificates: []tls.Certificate{cert},
			ClientAuth:   tls.RequireAndVerifyClientCert,
			ClientCAs:    certPool,
			MinVersion:   tls.VersionTLS12,
		}))
	}

	srv, cleanup, err := grpcserver.NewServer(options...)
	if err != nil {
		return nil, func() {}, err
	}

	log.Printf("%s🔗 -> Grpc all initialized successfully. %s\n", colorGreen, colorReset)
	return srv, func() {
		cleanup()
		log.Printf("%s🔗 -> Clean up grpc components successfully. %s\n", colorGreen, colorReset)
	}, nil
}
{{- end }}
