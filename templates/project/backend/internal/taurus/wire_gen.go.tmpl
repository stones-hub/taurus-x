package taurus

// buildComponents 按 Components 的字段顺序初始化框架组件；任一环节失败都会回滚已初始化的组件。
// 返回的 cleanup 按初始化的逆序关闭（每个组件的关闭都有上限，见 shutdown.go）。
func buildComponents(opts *ConfigOptions) (*Components, func(), error) {
	var cleanups []func()

	// 回滚/清理：按初始化的逆序执行
	unwind := func() {
		for i := len(cleanups) - 1; i >= 0; i-- {
			cleanups[i]()
		}
	}

	cfg, err := ProvideConfigComponent(opts)
	if err != nil {
		return nil, nil, err
	}

	logManager, logCleanup, err := ProvideLoggerComponent(cfg)
	if err != nil {
		unwind()
		return nil, nil, err
	}
	cleanups = append(cleanups, logCleanup)

	dbList, dbCleanup, err := ProvideDbComponent(cfg)
	if err != nil {
		unwind()
		return nil, nil, err
	}
	cleanups = append(cleanups, dbCleanup)

	redisClient, redisCleanup, err := ProvideRedisComponent(cfg)
	if err != nil {
		unwind()
		return nil, nil, err
	}
	cleanups = append(cleanups, redisCleanup)

	httpServer, err := ProvideHttpComponent(cfg)
	if err != nil {
		unwind()
		return nil, nil, err
	}
{{- if .Has.consul }}

	consulClient, consulCleanup, err := ProvideConsulComponent(cfg)
	if err != nil {
		unwind()
		return nil, nil, err
	}
	cleanups = append(cleanups, consulCleanup)
{{- end }}
{{- if .Has.opentelemetry }}

	otelProvider, otelCleanup, err := ProvideOtelComponent(cfg)
	if err != nil {
		unwind()
		return nil, nil, err
	}
	cleanups = append(cleanups, otelCleanup)
{{- end }}
{{- if .Has.tcp }}

	tcpServer, tcpCleanup, err := ProvideTCPComponent(cfg)
	if err != nil {
		unwind()
		return nil, nil, err
	}
	cleanups = append(cleanups, tcpCleanup)
{{- end }}
{{- if .Has.grpc }}

	grpcServer, grpcCleanup, err := ProvideGRPCComponent(cfg)
	if err != nil {
		unwind()
		return nil, nil, err
	}
	cleanups = append(cleanups, grpcCleanup)
{{- end }}
{{- if .Has.milvus }}

	milvusPool, milvusCleanup, err := ProvideMilvusComponent(cfg, logManager)
	if err != nil {
		unwind()
		return nil, nil, err
	}
	cleanups = append(cleanups, milvusCleanup)
{{- end }}

	cronManager, cronCleanup, err := ProvideCronComponent(cfg)
	if err != nil {
		unwind()
		return nil, nil, err
	}
	cleanups = append(cleanups, cronCleanup)

	components := &Components{
		Config: cfg,
		Logger: logManager,
		DbList: dbList,
		Redis:  redisClient,
		Http:   httpServer,
{{- if .Has.consul }}
		Consul: consulClient,
{{- end }}
{{- if .Has.opentelemetry }}
		Otel: otelProvider,
{{- end }}
{{- if .Has.tcp }}
		TCP: tcpServer,
{{- end }}
{{- if .Has.grpc }}
		GRPC: grpcServer,
{{- end }}
{{- if .Has.milvus }}
		Milvus: milvusPool,
{{- end }}
		Cron:   cronManager,
	}

	return components, unwind, nil
}
