//go:build wireinject
// +build wireinject

package taurus

import (
	"github.com/google/wire"
)

// buildComponents 框架组件依赖图。
//
// 各组件的 Provide* 函数统一放在 components.go（不带构建标签），这里只声明依赖图，
// 这样 wire 生成的 wire_gen.go 不会再拷贝一份 Provide*，改组件只改一处。
// 初始化顺序由 Components 的字段顺序决定（cleanup 按逆序执行），不是这里的书写顺序。
func buildComponents(opts *ConfigOptions) (*Components, func(), error) {
	wire.Build(
		ProvideConfigComponent,
		ProvideLoggerComponent,
		ProvideDbComponent,
		ProvideRedisComponent,
		ProvideHttpComponent,
{{- if .Has.consul }}
		ProvideConsulComponent,
{{- end }}
{{- if .Has.opentelemetry }}
		ProvideOtelComponent,
{{- end }}
{{- if .Has.tcp }}
		ProvideTCPComponent,
{{- end }}
{{- if .Has.grpc }}
		ProvideGRPCComponent,
{{- end }}
{{- if .Has.milvus }}
		ProvideMilvusComponent,
{{- end }}
		ProvideCronComponent,
		wire.Struct(new(Components), "*"),
	)
	return new(Components), nil, nil
}
