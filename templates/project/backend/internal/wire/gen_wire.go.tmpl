package main

import (
	"flag"
	"log"
	"os"
	"os/exec"
	"path/filepath"

	"{{ .Module }}/internal/wire/project"
)

// 生成 wire.go 文件
// 编译：go build -o build/wire/gen_wire ./internal/wire/gen_wire.go
// 使用：./gen_wire -project-root <项目根目录>
func main() {
	projectRoot := flag.String("project-root", "", "项目根目录")
	flag.Parse()

	if *projectRoot == "" {
		log.Fatal("项目根目录不能为空")
	}

	appPath := filepath.Join(*projectRoot, "app")

	// 先删除 app 目录下的 wire.go 文件
	_ = os.RemoveAll(filepath.Join(appPath, "wire.go"))

	// 确保 app 目录存在
	if err := os.MkdirAll(appPath, 0755); err != nil {
		log.Fatalf("创建 app 目录失败: %v", err)
	}

	// 扫描并生成 wire.go
	if err := project.GenerateProjectWire(appPath); err != nil {
		log.Fatalf("生成 wire.go 失败: %v", err)
	}

	// 执行 go mod tidy
	tidyCmd := exec.Command("go", "mod", "tidy")
	tidyCmd.Dir = *projectRoot
	if output, err := tidyCmd.CombinedOutput(); err != nil {
		log.Fatalf("执行 go mod tidy 失败: %v\n输出: %s", err, output)
	}

	// 对 wire.go 执行 go fmt
	fmtCmd := exec.Command("go", "fmt", filepath.Join(appPath, "wire.go"))
	if output, err := fmtCmd.CombinedOutput(); err != nil {
		log.Fatalf("执行 go fmt 失败: %v\n输出: %s", err, output)
	}

	// 执行 wire 命令生成实现
	//
	// 用 `go run -mod=mod` 调用，而不是依赖全局安装的 wire 二进制：
	// wire 的版本由本项目 go.mod 锁定，换机器、换 CI 都不用先 go install。
	cmd := exec.Command("go", "run", "-mod=mod", "github.com/google/wire/cmd/wire")
	cmd.Dir = appPath
	if output, err := cmd.CombinedOutput(); err != nil {
		log.Fatalf("执行 wire 命令失败: %v\n输出: %s", err, output)
	}
}
