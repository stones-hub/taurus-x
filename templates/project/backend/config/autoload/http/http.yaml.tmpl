http:
  address: "${SERVER_ADDRESS:0.0.0.0}"
  port: ${SERVER_PORT:9080}
  shutdown_timeout: 5
  read_timeout: 30
  write_timeout: 30
  idle_timeout: 120
  # 内部接口授权码。占位符**不加引号**：.env 的值是先做文本替换、再做 YAML 解析的，
  # 外面再套一层引号的话，用户在 .env 里写 AUTHORIZATION="x" 就会变成 ""x""。
  authorization: Bearer ${AUTHORIZATION:123456}

  # 主机 IP 白名单（留空 = 不启用 host 中间件拦截；配 CIDR 或精确 IP）
  host_white_list: []

  # 限流配置
  rate_limit:
    composite:
      enabled: true
      ip_capacity: 5        # 每个 IP 令牌桶容量
      global_capacity: 50   # 全局令牌桶容量
      fill_interval: 1      # 填充令牌间隔（秒）
    basic:
      enabled: true
      capacity: 10          # 令牌桶容量
      fill_interval: 1      # 填充令牌间隔（秒）

  # JWT配置
  jwt:
    enabled: true
    # 同上，占位符不加引号。
    # ⚠️ 下面的 your-secret-key 是弱默认值：.env 里没设 JWT_SECRET 时会用它，
    #    等于任何人都能自己签发合法 token。部署前必须设 JWT_SECRET（openssl rand -hex 32）。
    secret: ${JWT_SECRET:your-secret-key}
    issuer: "{{ .ProjectName }}"              # JWT签发者
    expire_hours: 24                          # JWT过期时间（小时）
    secure: false                             # JWT是否启用HTTPS
