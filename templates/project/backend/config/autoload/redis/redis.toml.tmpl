# Redis 数据
[redis]
enable = true
# Redis 服务器地址列表（单机一个地址；主从/集群多个地址）
address = ["${REDIS_HOST:127.0.0.1}:${REDIS_PORT:6379}"]

# Redis 服务器密码。
# 占位符默认值不能为空串（配置库的正则要求至少一个字符），这里用一个空格占位，
# 组件里会 TrimSpace，所以不配 REDIS_PASSWORD 时等于无密码。
password = "${REDIS_PASSWORD: }"

# 使用的数据库索引
db = 0

# 连接池大小
pool_size = 500

# 最小空闲连接数
min_idle_conns = 50

# 连接超时时间（秒）
dial_timeout = 5

# 读操作超时时间（秒）
read_timeout = 3

# 写操作超时时间（秒）
write_timeout = 3

# 最大重试次数
max_retries = 3

# 日志格式 [default/json]
logger_fomatter = "default"

# 日志地址
logger_path = "./logs/redis.log"

# 日志等级 [debug/warn/info/error]
logger_level = "info"

# 单个日志的大小 单位 mb
logger_max_size = 100

# 旧文件保存的数量
logger_max_backups = 10

# 文件最大保留的天数
logger_max_age = 7
