# Redis 数据
[redis]
enable = true
# Redis 服务器地址列表（单机一个地址；主从/集群多个地址）
address = ["${REDIS_HOST:127.0.0.1}:${REDIS_PORT:6379}"]

# Redis 服务器密码。
# 占位符默认值不能为空串（配置库的正则要求至少一个字符），这里用一个空格占位，
# 只有空白的值按「没配」处理，所以不配 REDIS_PASSWORD 时等于无密码；非空白的值不会被代码去掉首尾空格。
# 限制：占位符在 TOML 解析之前做文本替换，值里含引号、反斜线、右花括号或换行时会被改写或导致解析失败，
# 不保证任意字符都能原样传递；首尾空格保留只验证过由进程环境变量直接提供的普通值，经 .env 类文件提供时未验证。
password = "${REDIS_PASSWORD: }"

# 使用的数据库索引
db = 0

# 连接池大小
pool_size = 500

# 最小空闲连接数
min_idle_conns = 50

# 连接超时时间（秒）
dial_timeout = 5

# 读操作超时时间（秒）
read_timeout = 3

# 写操作超时时间（秒）
write_timeout = 3

# 最大重试次数
max_retries = 3

# 日志格式 [default/json]
logger_fomatter = "default"

# 日志地址
logger_path = "./logs/redis.log"

# 日志等级 [debug/info/warn/error]，没配或写错时按 warn。
# 默认 warn：info 会把每条成功命令连同参数（会话键 auth:jti:*、用户认证版本号等）写进日志。
# warn 下成功命令不再记录，但失败命令仍按 error 记录且带参数；排查问题时再临时调成 info / debug。
logger_level = "warn"

# 单个日志的大小 单位 mb
logger_max_size = 100

# 旧文件保存的数量
logger_max_backups = 10

# 文件最大保留的天数
logger_max_age = 7
