tcp:
  # 默认关闭：选了 tcp 组件只代表代码和依赖就绪。
  # 开启前先注册自己的 handler：handler 在 app 包的 init（BuildComponents）里就解析了，所以
  # tcp.RegisterHandler(name, handler) 必须在被 app 直接或间接导入的包（例如 app/hooks）的
  # init() 或包级变量初始化里调用 —— Go 保证这些包先于 app 完成初始化。写在 app 包自己的 init 里
  # （和 bootstrap.go 的先后取决于文件名）、只被 main 导入的包里、或 StartHook 里，都已经晚了。
  # 名字没注册（包括注册晚了）时不会报错、启动照常成功，而是静默回退到组件自带的 default 处理器
  # （只打日志、不回复）。
  enable: ${TCP_ENABLE:false}

  address: "${TCP_ADDRESS::8081}"       # 独立监听端口，与 HTTP 一起启动、一起优雅关闭
  protocol: "${TCP_PROTOCOL:json}"      # json / binary
  handler: "${TCP_HANDLER:default}"     # 见上：RegisterHandler 注册的名字；未注册静默回退 default
  max_connections: 1000
  max_message_size: 1048576             # 单条消息上限（字节），默认 1MB
  buffer_size: 1024
  idle_timeout: 300                     # 空闲断开（秒）
  rate_limiter: 100                     # 每连接每秒消息数上限
