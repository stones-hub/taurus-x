services:
  mysql:
    image: mysql:8.0
    container_name: {{ .ProjectName }}-mysql
    restart: unless-stopped
    environment:
      MYSQL_ROOT_PASSWORD: ${MYSQL_ROOT_PASSWORD:-root123456}
      MYSQL_DATABASE: {{ .DBName }}
      MYSQL_USER: {{ .DBName }}
      MYSQL_PASSWORD: ${MYSQL_PASSWORD:-change-me-123456}
      TZ: Asia/Shanghai
    command:
      - --character-set-server=utf8mb4
      - --collation-server=utf8mb4_general_ci
      - --default-time-zone=+08:00
    volumes:
      - mysql-data:/var/lib/mysql
      # 首次初始化自动导入建表 + 底座菜单权限 + 初始管理员
      - ./scripts/sql/init.sql:/docker-entrypoint-initdb.d/01-init.sql:ro
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "127.0.0.1", "-u{{ .DBName }}", "-p${MYSQL_PASSWORD:-change-me-123456}"]
      interval: 10s
      timeout: 5s
      retries: 10
    networks:
      - {{ .ProjectName }}-net

  redis:
    image: redis:7-alpine
    container_name: {{ .ProjectName }}-redis
    restart: unless-stopped
    command: ["redis-server", "--appendonly", "yes"]
    volumes:
      - redis-data:/data
    networks:
      - {{ .ProjectName }}-net
{{- if .Has.consul }}

  consul:
    image: hashicorp/consul:1.19
    container_name: {{ .ProjectName }}-consul
    restart: unless-stopped
    command: ["agent", "-dev", "-client=0.0.0.0", "-ui"]
    ports:
      # 8500 = HTTP API + Web UI。dev 模式没有 ACL，只绑本机回环；app 在容器网络里用 consul:8500 访问
      - "127.0.0.1:8500:8500"
    healthcheck:
      # 镜像自带的 consul CLI 经本机 HTTP API 查询成员，agent 能应答才算就绪
      test: ["CMD", "consul", "members"]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 10s
    networks:
      - {{ .ProjectName }}-net
{{- end }}
{{- if .Has.milvus }}

  # ---- Milvus standalone 需要 etcd（元数据）+ 外置 S3 对象存储两个独立依赖 ----
  # 镜像版本对齐 Milvus 官方 v2.6.5 的 milvus-standalone-docker-compose.yml（etcd v3.5.18、milvus v2.6.5）。
  # 对象存储不再内置 MinIO：必须接你们自己有人维护的外置 S3（公共 CA 签发证书的 HTTPS 端点），见部署文档。
  etcd:
    image: quay.io/coreos/etcd:v3.5.18
    container_name: {{ .ProjectName }}-etcd
    restart: unless-stopped
    environment:
      ETCD_AUTO_COMPACTION_MODE: revision
      ETCD_AUTO_COMPACTION_RETENTION: "1000"
      ETCD_QUOTA_BACKEND_BYTES: "4294967296"
      ETCD_SNAPSHOT_COUNT: "50000"
    command:
      - etcd
      - --advertise-client-urls=http://127.0.0.1:2379
      - --listen-client-urls=http://0.0.0.0:2379
      - --data-dir=/etcd
    volumes:
      - etcd-data:/etcd
    healthcheck:
      test: ["CMD", "etcdctl", "endpoint", "health"]
      interval: 30s
      timeout: 20s
      retries: 3
    networks:
      - {{ .ProjectName }}-net

  milvus:
    image: milvusdb/milvus:v2.6.5
    container_name: {{ .ProjectName }}-milvus
    restart: unless-stopped
    command: ["milvus", "run", "standalone"]
    # 与官方 v2.6.5 编排一致
    security_opt:
      - seccomp:unconfined
    environment:
      ETCD_ENDPOINTS: etcd:2379
      MQ_TYPE: woodpecker
      # 外置 S3（Milvus v2.6.5 用 MINIO_* 这组环境变量接任何 S3 兼容服务，不要求对端是 MinIO）。
      # 下面 6 项必须在 .env 里显式设置，缺任何一项 compose 直接拒绝启动；不提供默认值，避免静默用上
      # 镜像自带配置里的默认凭据、默认桶或默认前缀。
      # 地址只写 host 或 host:port，不带 http(s)://；不写端口时按下面固定的 443。
      MINIO_ADDRESS: ${MILVUS_S3_ADDRESS:?MILVUS_S3_ADDRESS 必须在 .env 里显式设置（外置 S3 的 host 或 host:port）}
      MINIO_PORT: "443"
      MINIO_ACCESS_KEY_ID: ${MILVUS_S3_ACCESS_KEY_ID:?MILVUS_S3_ACCESS_KEY_ID 必须在 .env 里显式设置}
      MINIO_SECRET_ACCESS_KEY: ${MILVUS_S3_SECRET_ACCESS_KEY:?MILVUS_S3_SECRET_ACCESS_KEY 必须在 .env 里显式设置}
      MINIO_BUCKET_NAME: ${MILVUS_S3_BUCKET:?MILVUS_S3_BUCKET 必须在 .env 里显式设置}
      # 对象键前缀，不要以 / 开头；Milvus 有数据后不能再改（改了读不到旧数据）
      MINIO_ROOT_PATH: ${MILVUS_S3_ROOT_PATH:?MILVUS_S3_ROOT_PATH 必须在 .env 里显式设置（例如 {{ .ProjectName }}/milvus）}
      # 必须与桶所在区域一致：C++ 侧只在非空时才设置签名区域，留空会落到 SDK 默认值，签名对不上
      MINIO_REGION: ${MILVUS_S3_REGION:?MILVUS_S3_REGION 必须在 .env 里显式设置（桶所在区域）}
      # false 时 Go 侧按端点自动选择寻址方式、C++ 侧固定 path-style；服务商只支持 virtual-host 时改 true
      MINIO_USE_VIRTUAL_HOST: ${MILVUS_S3_USE_VIRTUAL_HOST:-false}
      # 只作用于 C++ 侧（存储 V2 再按整秒取整）：写 1000 的整数倍，不要低于 1000
      MINIO_REQUEST_TIMEOUT_MS: ${MILVUS_S3_REQUEST_TIMEOUT_MS:-10000}
      # 以下为固定的安全设置，不要改成从 .env 读取：
      # - 只走 HTTPS，并且 CA 必须显式置空。v2.6.5 的 C++ 对象存储客户端在 CA 非空时会关闭证书与主机名校验，
      #   镜像自带配置里的 CA 占位值又是非空的，所以只开 HTTPS 不置空 CA 并不安全；置空后走系统信任库校验，
      #   因此只支持公共 CA 签发的证书，不支持私有 CA / 自签证书。
      # - 固定 aws（SigV4）+ 静态密钥，不用 IAM；存储类型固定 remote（Milvus 存储 V2 只认 remote）。
      MINIO_USE_SSL: "true"
      MINIO_SSL_TLSCACERT: ""
      MINIO_CLOUD_PROVIDER: aws
      MINIO_USE_IAM: "false"
      COMMON_STORAGETYPE: remote
    volumes:
      - milvus-data:/var/lib/milvus
    depends_on:
      etcd:
        condition: service_healthy
    healthcheck:
      # 与官方 v2.6.5 编排一致：9091/healthz 返回 200 才算就绪（首次启动较慢，给 90 秒启动期）
      test: ["CMD", "curl", "-f", "http://localhost:9091/healthz"]
      interval: 30s
      timeout: 20s
      retries: 3
      start_period: 90s
    ports:
      # 19530 = gRPC（SDK 连这个），9091 = metrics / health。compose 里的 Milvus 不开认证，只绑本机回环；
      # app 在容器网络里用 milvus:19530 访问。生产请接外部 Milvus 并开启认证 / TLS。
      - "127.0.0.1:19530:19530"
      - "127.0.0.1:9091:9091"
    networks:
      - {{ .ProjectName }}-net
{{- end }}

  app:
    build:
      context: .
      dockerfile: Dockerfile
    image: {{ .ProjectName }}-app:latest
    container_name: {{ .ProjectName }}-app
    restart: unless-stopped
    # 优雅退出的最坏总耗时：全选组件且退出预算取最大值约 37.7 秒（见 config/autoload/http/http.yaml 的
    # shutdown_timeout 注释）。Docker 默认只等 10 秒就 SIGKILL，这里放宽到 45 秒（= lifecycle.DeployStopWait）
    stop_grace_period: 45s
    depends_on:
      mysql:
        condition: service_healthy
      redis:
        condition: service_started
{{- if .Has.consul }}
      consul:
        condition: service_healthy
{{- end }}
{{- if .Has.milvus }}
      milvus:
        condition: service_healthy
{{- end }}
    # 非 root 运行，uid/gid 与镜像内一致（1000）；bind mount 目录需 chown 1000:1000
    user: "1000:1000"
    # 注意：下面的值会被「原样」代入 config/ 下的配置文件（先文本替换再解析 YAML/TOML），
    # 一律不要加引号，也不要在值里写 `}` 和换行。
    environment:
      # http
      SERVER_ADDRESS: 0.0.0.0
      SERVER_PORT: 9080
      AUTHORIZATION: ${AUTHORIZATION:-change-me-654321}
      # db
      DB_NAME: {{ .DBName }}
      DB_DSN: ${DB_DSN:-{{ .DBName }}:change-me-123456@tcp(mysql:3306)/{{ .DBName }}?charset=utf8mb4&parseTime=True&loc=Local}
      # redis
      REDIS_HOST: redis
      REDIS_PORT: 6379
      # jwt（生产务必改成随机长串：openssl rand -hex 32）
      JWT_SECRET: ${JWT_SECRET:?JWT_SECRET 必须在 .env 里显式设置}
      JWT_COOKIE_SECURE: ${JWT_COOKIE_SECURE:-false}
      AUTH_TRUSTED_ORIGINS: ${AUTH_TRUSTED_ORIGINS:-none}
{{- if .Has.consul }}
      # consul（服务注册发现）
      CONSUL_ENABLE: "true"
      CONSUL_ADDRESS: consul:8500
{{- end }}
{{- if .Has.opentelemetry }}
      # opentelemetry（默认关闭，填好 collector 地址后再打开）
      OTEL_ENABLE: "false"
{{- end }}
{{- if .Has.tcp }}
      # tcp 服务（默认关闭，注册好 handler 后再打开）
      TCP_ENABLE: "false"
      TCP_ADDRESS: ":8081"
{{- end }}
{{- if .Has.grpc }}
      # grpc 服务（默认关闭，注册好 service 后再打开）
      GRPC_ENABLE: "false"
      GRPC_ADDRESS: ":50051"
{{- end }}
{{- if .Has.milvus }}
      # milvus 向量库
      MILVUS_ENABLE: "true"
      MILVUS_ADDRESS: milvus:19530
{{- end }}
      TZ: Asia/Shanghai
    ports:
      - "9080:9080"
{{- if .Has.tcp }}
      # 打开 TCP_ENABLE 后生效
      - "8081:8081"
{{- end }}
{{- if .Has.grpc }}
      # 打开 GRPC_ENABLE 后生效
      - "50051:50051"
{{- end }}
    volumes:
      # 日志 bind mount 到宿主机目录，方便直接在宿主机查看
      # 宿主机相对路径（相对 docker-compose.yml 所在目录）
      - ./docker-data/logs:/app/backend/logs
    networks:
      - {{ .ProjectName }}-net

networks:
  {{ .ProjectName }}-net:
    driver: bridge

volumes:
  mysql-data:
  redis-data:
{{- if .Has.milvus }}
  etcd-data:
  milvus-data:
{{- end }}
