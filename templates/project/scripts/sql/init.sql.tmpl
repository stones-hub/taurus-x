-- ============================ 七、初始管理员 ============================

-- 密码散列：login_credential = bcrypt(明文密码)，cost 10，形如 `$2a$10$...`（60 字符）。
-- bcrypt 自带随机盐并编码在散列串里，所以每个项目的散列都不同，salt 列写空串。
-- 算法与 app/helper/crypto.go 的 HashPassword 一致（生成侧见 taurus-x
-- internal/generator/password.go，两边必须用同一个 cost 常量）。
--
--   初始账号：{{ .AdminUsername }}
--   初始密码：**不写在本文件里**。生成项目时由 taurus-x 随机产生并只在终端打印一次
--             （见生成项目 README「初始管理员」一节）。没记下来就换掉下面的散列：
--             `cd backend && go run ./bin/hashpw`，从标准输入读新密码并输出 bcrypt
--             散列，再 UPDATE admin_user_logins 的 login_credential（salt 置空串）。
--
-- ⚠️ 首次登录后请立刻通过「个人信息 → 修改密码」改掉初始密码。
INSERT INTO `admin_users`
  (`user_id`, `username`, `realname`, `nickname`, `status`, `user_source`, `auth_version`)
VALUES
  (1, '{{ .AdminUsername }}', '超级管理员', '超级管理员', 1, 3, 1);

