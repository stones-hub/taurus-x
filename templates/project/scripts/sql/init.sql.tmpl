-- ============================================================================
-- {{ .ProjectName }} 初始化 SQL（建表 + 底座菜单/按钮/接口权限 + super_admin 角色 + 初始管理员）
--
-- 用法：
--   mysql -u <用户> -p {{ .DBName }} < scripts/sql/init.sql
--   Docker 方式由 compose 挂到 /docker-entrypoint-initdb.d/ 首次启动自动执行。
--
-- 约定（见 docs/项目规范.md）：
--   * 建表与权限数据**只走本脚本及 scripts/sql/ 下的增量脚本**，不开 GORM AutoMigrate；
--   * 本脚本只建底座自身的 12 张表，不含任何业务表；
--   * 后续表结构 / 权限变更一律写成增量 SQL 落盘 scripts/sql/，**不要重复执行本脚本**；
--   * 新增模块的三级权限（菜单 type=1 / 按钮 type=2 / 接口 type=3）按本脚本末尾的
--     形式追加，接口权限的 path 必须与 app/routes/routes.go 的实际路由**精确一致**。
-- ============================================================================

SET NAMES utf8mb4;
SET FOREIGN_KEY_CHECKS = 0;

-- ============================ 一、用户与登录 ============================

CREATE TABLE IF NOT EXISTS `admin_users` (
  `user_id`         BIGINT UNSIGNED NOT NULL AUTO_INCREMENT COMMENT '用户ID',
  `username`        VARCHAR(60)     NOT NULL                COMMENT '用户名',
  `realname`        VARCHAR(60)     NOT NULL DEFAULT ''     COMMENT '真实姓名',
  `nickname`        VARCHAR(60)     NOT NULL DEFAULT ''     COMMENT '昵称',
  `avatar`          VARCHAR(255)    NOT NULL DEFAULT ''     COMMENT '头像URL',
  `mobile`          VARCHAR(20)              DEFAULT NULL   COMMENT '手机号码',
  `email`           VARCHAR(100)             DEFAULT NULL   COMMENT '邮箱地址',
  `gender`          TINYINT         NOT NULL DEFAULT 0      COMMENT '性别：0未知，1男，2女',
  `birthday`        DATE                     DEFAULT NULL   COMMENT '生日',
  `position`        VARCHAR(100)    NOT NULL DEFAULT ''     COMMENT '职位',
  `status`          TINYINT         NOT NULL DEFAULT 1      COMMENT '状态：1启用，0禁用，-1删除',
  `user_source`     TINYINT         NOT NULL DEFAULT 1      COMMENT '用户来源：1自主注册，2企业微信同步，3其他SSO',
  -- 认证版本：改密/重置密码/禁用/删除时与业务变更同事务自增，使该用户已签发的
  -- Token 立即失效（见 app/helper/store/auth_redis_store.go）。权威值必须在数据库里：
  -- 放 Redis 会被淘汰或随实例重启丢失，计数一回退，已吊销的会话就复活了。
  `auth_version`    BIGINT UNSIGNED NOT NULL DEFAULT 1      COMMENT '认证版本：改密/禁用等变更时自增，使已签发Token立即失效',
  `last_login_time` DATETIME                 DEFAULT NULL   COMMENT '最后登录时间',
  `last_login_ip`   VARCHAR(45)     NOT NULL DEFAULT ''     COMMENT '最后登录IP',
  `created_at`      DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
  `updated_at`      DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '修改时间',
  PRIMARY KEY (`user_id`),
  UNIQUE KEY `uk_username` (`username`),
  UNIQUE KEY `uk_mobile` (`mobile`),
  UNIQUE KEY `uk_email` (`email`),
  KEY `idx_status` (`status`),
  KEY `idx_user_source` (`user_source`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci COMMENT='用户基础信息表';

-- 密码 hash 存在本表（bcrypt，见 app/helper/crypto.go）。bcrypt 的盐已经编码在
-- 散列串里，所以 salt 列在新算法下不再使用（一律空串）；列保留只是为了兼容
-- 历史数据：老项目里存的是 SHA-256(password + salt)，登录时会被自动升级成 bcrypt。
-- 一个用户可有多种登录方式（username / mobile / 各 SSO），按 login_type 区分。
CREATE TABLE IF NOT EXISTS `admin_user_logins` (
  `login_id`         BIGINT UNSIGNED NOT NULL AUTO_INCREMENT COMMENT '登录方式ID',
  `user_id`          BIGINT UNSIGNED NOT NULL                COMMENT '用户ID',
  `login_type`       VARCHAR(64)     NOT NULL                COMMENT '登录类型（username/mobile/wechat_work/dingtalk/feishu）',
  `login_value`      VARCHAR(100)    NOT NULL                COMMENT '登录标识',
  `login_credential` VARCHAR(255)    NOT NULL DEFAULT ''     COMMENT '登录凭证（bcrypt 散列，60 字符）',
  `salt`             VARCHAR(32)     NOT NULL DEFAULT ''     COMMENT '历史遗留盐值；bcrypt 下不使用，恒为空串',
  `status`           TINYINT         NOT NULL DEFAULT 1      COMMENT '状态：1启用，0禁用',
  `created_at`       DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
  `updated_at`       DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '修改时间',
  PRIMARY KEY (`login_id`),
  UNIQUE KEY `uk_login_type_value` (`login_type`, `login_value`),
  UNIQUE KEY `uk_user_login_type` (`user_id`, `login_type`),
  KEY `idx_user_id` (`user_id`),
  KEY `idx_login_type` (`login_type`),
  KEY `idx_status` (`status`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci COMMENT='用户登录方式表';

CREATE TABLE IF NOT EXISTS `admin_user_login_logs` (
  `log_id`         BIGINT UNSIGNED NOT NULL AUTO_INCREMENT COMMENT '日志ID',
  `user_id`        BIGINT UNSIGNED NOT NULL                COMMENT '用户ID',
  `login_type`     VARCHAR(20)     NOT NULL                COMMENT '登录方式',
  `login_ip`       VARCHAR(45)     NOT NULL DEFAULT ''     COMMENT '登录IP',
  `user_agent`     VARCHAR(500)    NOT NULL DEFAULT ''     COMMENT '用户代理',
  -- 默认值取 0（失败）：应用层每次写日志都显式带上本列（model 的 gorm tag 刻意不写
  -- default，见 app/model/admin_user_login_log.go），所以这个默认值正常不会被用到；
  -- 真要被用到说明有人漏写了列，此时记成「失败」比记成「成功」更安全。
  `login_status`   TINYINT         NOT NULL DEFAULT 0      COMMENT '登录状态：1成功，0失败',
  `failure_reason` VARCHAR(255)    NOT NULL DEFAULT ''     COMMENT '失败原因',
  `login_time`     DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '登录时间',
  PRIMARY KEY (`log_id`),
  KEY `idx_user_id` (`user_id`),
  KEY `idx_login_type` (`login_type`),
  KEY `idx_login_status` (`login_status`),
  KEY `idx_login_time` (`login_time`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci COMMENT='用户登录日志表';

-- ============================ 二、RBAC（角色 / 权限） ============================

CREATE TABLE IF NOT EXISTS `admin_roles` (
  `role_id`     BIGINT UNSIGNED NOT NULL AUTO_INCREMENT COMMENT '角色ID',
  `role_name`   VARCHAR(100)    NOT NULL                COMMENT '角色名称',
  `role_code`   VARCHAR(50)     NOT NULL                COMMENT '角色编码',
  `description` VARCHAR(255)    NOT NULL DEFAULT ''     COMMENT '角色描述',
  `sort_order`  INT             NOT NULL DEFAULT 0      COMMENT '排序',
  `status`      TINYINT         NOT NULL DEFAULT 1      COMMENT '状态：1启用，0禁用',
  `is_system`   TINYINT         NOT NULL DEFAULT 0      COMMENT '是否系统角色：1是，0否',
  `created_at`  DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
  `updated_at`  DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '修改时间',
  PRIMARY KEY (`role_id`),
  UNIQUE KEY `uk_role_code` (`role_code`),
  KEY `idx_status` (`status`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci COMMENT='角色表';

-- permission_type：1 菜单（path 填前端路由，无前导 /），2 按钮（path 留空，前端按
-- permission_code 做 v-permission），3 接口（path 填后端真实路由，精确匹配）。
CREATE TABLE IF NOT EXISTS `admin_permissions` (
  `permission_id`   BIGINT UNSIGNED NOT NULL AUTO_INCREMENT COMMENT '权限ID',
  `parent_id`       BIGINT UNSIGNED NOT NULL DEFAULT 0      COMMENT '父权限ID',
  `permission_name` VARCHAR(100)    NOT NULL                COMMENT '权限名称',
  `permission_code` VARCHAR(100)    NOT NULL                COMMENT '权限编码',
  `permission_type` TINYINT         NOT NULL DEFAULT 1      COMMENT '权限类型：1菜单，2按钮，3接口',
  `path`            VARCHAR(255)    NOT NULL DEFAULT ''     COMMENT '路径',
  `icon`            VARCHAR(100)    NOT NULL DEFAULT ''     COMMENT '图标',
  `sort_order`      INT             NOT NULL DEFAULT 0      COMMENT '排序',
  `status`          TINYINT         NOT NULL DEFAULT 1      COMMENT '状态：1启用，0禁用',
  `is_system`       TINYINT         NOT NULL DEFAULT 0      COMMENT '是否系统权限：1是，0否',
  `created_at`      DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
  `updated_at`      DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '修改时间',
  PRIMARY KEY (`permission_id`),
  UNIQUE KEY `uk_permission_code` (`permission_code`),
  KEY `idx_parent_id` (`parent_id`),
  KEY `idx_permission_type` (`permission_type`),
  KEY `idx_status` (`status`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci COMMENT='权限表';

CREATE TABLE IF NOT EXISTS `admin_user_roles` (
  `id`         BIGINT UNSIGNED NOT NULL AUTO_INCREMENT COMMENT '自增ID',
  `user_id`    BIGINT UNSIGNED NOT NULL                COMMENT '用户ID',
  `role_id`    BIGINT UNSIGNED NOT NULL                COMMENT '角色ID',
  `created_at` DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
  `updated_at` DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '修改时间',
  PRIMARY KEY (`id`),
  UNIQUE KEY `uk_user_role` (`user_id`, `role_id`),
  KEY `idx_user_id` (`user_id`),
  KEY `idx_role_id` (`role_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci COMMENT='用户角色关联表';

CREATE TABLE IF NOT EXISTS `admin_role_permissions` (
  `id`            BIGINT UNSIGNED NOT NULL AUTO_INCREMENT COMMENT '自增ID',
  `role_id`       BIGINT UNSIGNED NOT NULL                COMMENT '角色ID',
  `permission_id` BIGINT UNSIGNED NOT NULL                COMMENT '权限ID',
  `created_at`    DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
  `updated_at`    DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '修改时间',
  PRIMARY KEY (`id`),
  UNIQUE KEY `uk_role_permission` (`role_id`, `permission_id`),
  KEY `idx_role_id` (`role_id`),
  KEY `idx_permission_id` (`permission_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci COMMENT='角色权限关联表';

-- ============================ 三、部门 ============================

CREATE TABLE IF NOT EXISTS `admin_depts` (
  `dept_id`     BIGINT UNSIGNED NOT NULL AUTO_INCREMENT COMMENT '部门ID',
  `dept_name`   VARCHAR(100)    NOT NULL                COMMENT '部门名称',
  `parent_id`   BIGINT UNSIGNED NOT NULL DEFAULT 0      COMMENT '父部门ID',
  `dept_code`   VARCHAR(50)         NULL DEFAULT NULL   COMMENT '部门编码，可空；NULL 不受 uk_dept_code 约束（MySQL 唯一索引允许多个 NULL）',
  `description` VARCHAR(255)    NOT NULL DEFAULT ''     COMMENT '部门描述',
  `sort_order`  INT             NOT NULL DEFAULT 0      COMMENT '排序',
  `dept_source` TINYINT         NOT NULL DEFAULT 1      COMMENT '部门来源：1自主创建，2企业微信同步，3其他SSO',
  `external_id` VARCHAR(100)    NOT NULL DEFAULT ''     COMMENT '外部系统ID',
  `status`      TINYINT         NOT NULL DEFAULT 1      COMMENT '状态：1启用，0禁用',
  `created_at`  DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
  `updated_at`  DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '修改时间',
  PRIMARY KEY (`dept_id`),
  UNIQUE KEY `uk_dept_code` (`dept_code`),
  KEY `idx_parent_id` (`parent_id`),
  KEY `idx_dept_source` (`dept_source`),
  KEY `idx_external_id` (`external_id`),
  KEY `idx_status` (`status`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci COMMENT='部门表';

CREATE TABLE IF NOT EXISTS `admin_user_depts` (
  `id`         BIGINT UNSIGNED NOT NULL AUTO_INCREMENT COMMENT '自增ID',
  `user_id`    BIGINT UNSIGNED NOT NULL                COMMENT '用户ID',
  `dept_id`    BIGINT UNSIGNED NOT NULL                COMMENT '部门ID',
  `is_primary` TINYINT         NOT NULL DEFAULT 0      COMMENT '是否主要部门：1是，0否',
  `is_manager` TINYINT         NOT NULL DEFAULT 0      COMMENT '是否部门管理员：1是，0否',
  `status`     TINYINT         NOT NULL DEFAULT 1      COMMENT '状态：1启用，0禁用',
  `created_at` DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
  `updated_at` DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '修改时间',
  PRIMARY KEY (`id`),
  UNIQUE KEY `uk_user_dept` (`user_id`, `dept_id`),
  KEY `idx_user_id` (`user_id`),
  KEY `idx_dept_id` (`dept_id`),
  KEY `idx_dept_manager` (`is_manager`, `status`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci COMMENT='用户部门关联表';

-- ============================ 四、日志 ============================

CREATE TABLE IF NOT EXISTS `admin_access_logs` (
  `log_id`        BIGINT UNSIGNED NOT NULL AUTO_INCREMENT COMMENT '日志ID',
  `user_id`       BIGINT UNSIGNED NOT NULL DEFAULT 0      COMMENT '用户ID（0=未登录）',
  `method`        VARCHAR(10)     NOT NULL                COMMENT 'HTTP 方法',
  `path`          VARCHAR(200)    NOT NULL                COMMENT '请求路径',
  `status_code`   INT             NOT NULL DEFAULT 0      COMMENT '响应状态码',
  `ip`            VARCHAR(45)     NOT NULL DEFAULT ''     COMMENT '客户端 IP',
  `user_agent`    VARCHAR(500)    NOT NULL DEFAULT ''     COMMENT '用户代理',
  `duration_ms`   BIGINT          NOT NULL DEFAULT 0      COMMENT '耗时（毫秒）',
  `query`         VARCHAR(500)    NOT NULL DEFAULT ''     COMMENT '查询串',
  `request_body`  TEXT                                    COMMENT '请求体（截断）',
  `response_body` LONGTEXT                                COMMENT '响应体（截断）',
  `error_message` VARCHAR(500)    NOT NULL DEFAULT ''     COMMENT '错误信息（如有）',
  `created_at`    DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '访问时间',
  PRIMARY KEY (`log_id`),
  KEY `idx_user_id` (`user_id`),
  KEY `idx_path` (`path`),
  KEY `idx_status` (`status_code`),
  KEY `idx_created` (`created_at`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci COMMENT='API 访问日志表';

CREATE TABLE IF NOT EXISTS `admin_operation_logs` (
  `log_id`        BIGINT UNSIGNED NOT NULL AUTO_INCREMENT COMMENT '日志ID',
  `user_id`       BIGINT UNSIGNED NOT NULL DEFAULT 0      COMMENT '操作用户ID',
  `method`        VARCHAR(10)     NOT NULL                COMMENT 'HTTP 方法',
  `path`          VARCHAR(200)    NOT NULL                COMMENT '接口路径',
  `action`        VARCHAR(50)     NOT NULL DEFAULT ''     COMMENT '动作类型（add/update/delete 等）',
  `resource`      VARCHAR(50)     NOT NULL DEFAULT ''     COMMENT '资源模块（user/role/dept 等）',
  `ip`            VARCHAR(45)     NOT NULL DEFAULT ''     COMMENT '客户端 IP',
  `status_code`   INT             NOT NULL DEFAULT 0      COMMENT '响应状态码',
  `request_body`  TEXT                                    COMMENT '请求体（截断）',
  `response_body` LONGTEXT                                COMMENT '响应体（截断）',
  `result`        VARCHAR(255)    NOT NULL DEFAULT ''     COMMENT '操作结果（成功/失败）',
  `error_msg`     VARCHAR(500)    NOT NULL DEFAULT ''     COMMENT '错误信息',
  `created_at`    DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '操作时间',
  PRIMARY KEY (`log_id`),
  KEY `idx_user_id` (`user_id`),
  KEY `idx_path` (`path`),
  KEY `idx_status` (`status_code`),
  KEY `idx_created` (`created_at`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci COMMENT='操作日志表';

CREATE TABLE IF NOT EXISTS `admin_front_error_logs` (
  `log_id`     BIGINT UNSIGNED NOT NULL AUTO_INCREMENT COMMENT '日志ID',
  `user_id`    BIGINT UNSIGNED NOT NULL DEFAULT 0      COMMENT '用户ID（0=未登录）',
  `message`    VARCHAR(1000)   NOT NULL DEFAULT ''     COMMENT '错误信息',
  `source`     VARCHAR(500)    NOT NULL DEFAULT ''     COMMENT '出错位置（file:line:col）',
  `stack`      TEXT                                    COMMENT '错误堆栈',
  `url`        VARCHAR(500)    NOT NULL DEFAULT ''     COMMENT '出错页面 URL',
  `user_agent` VARCHAR(500)    NOT NULL DEFAULT ''     COMMENT '浏览器 UA',
  `ip`         VARCHAR(45)     NOT NULL DEFAULT ''     COMMENT '客户端 IP',
  `kind`       VARCHAR(20)     NOT NULL DEFAULT ''     COMMENT '错误类型（error/unhandledrejection）',
  `created_at` DATETIME        NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '上报时间',
  PRIMARY KEY (`log_id`),
  KEY `idx_user_id` (`user_id`),
  KEY `idx_created` (`created_at`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci COMMENT='前端错误日志表';

SET FOREIGN_KEY_CHECKS = 1;

