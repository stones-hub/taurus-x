	}
	if code != exitFailed || !strings.Contains(stdout.String(), "被中断") {
		t.Fatalf("中断应在报告里标明并返回 1: code=%d\n%s", code, stdout.String())
	}
}

// 登录成功但 jar 不会把 jwt_token 发出去（真实场景：JWT_COOKIE_SECURE=true 时用 http 压测非回环地址），
// 后端对「没带令牌」的登出照样回成功。工具必须把这记为登出失败（会话留在服务端），并让退出码非 0。
func TestLoginScenario_UnsentJWTLogoutFails(t *testing.T) {
	fb, srv := newFakeBackend(t, func(fb *fakeBackend) { fb.jwtPath = "/not-sent" })
	code, out, _, rep := runTool(t, "-scenario", "login", "-base-url", srv.URL, "-duration", "200ms", "-concurrency", "1")
	if code != exitFailed {
		t.Fatalf("有会话没能登出时退出码应为 1，实际 %d\n%s", code, out)
	}
	if rep.Success == 0 || rep.LogoutFailures != rep.Success {
		t.Fatalf("每次成功登录后的登出都应记为失败: success=%d logoutFailures=%d", rep.Success, rep.LogoutFailures)
	}
	if fb.liveSessions() != int(rep.Success) {
		t.Fatalf("假后端里应留下 %d 个未吊销的会话，实际 %d", rep.Success, fb.liveSessions())
	}
	if !strings.Contains(out, "有会话没能登出") {
		t.Fatalf("报告应提示有会话没能登出:\n%s", out)
	}
}

func TestLogout_RequiresJWTAndServerClearedCookie(t *testing.T) {
	fb, srv := newFakeBackend(t)
	cfg, err := parseConfig([]string{"-scenario", "login", "-base-url", srv.URL}, testEnv, &bytes.Buffer{})
	if err != nil {
		t.Fatal(err)
	}
	// jar 里没有 jwt_token：不发请求也知道吊销不了任何会话。
	if newClient(cfg, http.DefaultTransport, newJar()).logout() {
		t.Fatal("jar 里没有 jwt_token 时登出不能算成功")
	}
	// 正常登出：服务端吊销并清 Cookie。
	c := newClient(cfg, http.DefaultTransport, newJar())
	if c.login().outcome != outcomeSuccess || !c.logout() || c.cookie(jwtCookieName) != "" || fb.liveSessions() != 0 {
		t.Fatalf("正常登出应成功并清掉 jwt_token（剩余会话 %d）", fb.liveSessions())
	}
	// 服务端回了 code 200 但没清 Cookie：不能只凭 body.code 判成功。
	fb.noClear = true
	c = newClient(cfg, http.DefaultTransport, newJar())
	if c.login().outcome != outcomeSuccess || c.logout() {
		t.Fatal("登出响应没有清掉 jwt_token 时不能算成功")
	}
}

