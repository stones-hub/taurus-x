// 每个列表接口的请求体与前端列表页首次加载时一模一样（期望值独立写在这里，不复用 listEndpoints）。
func TestListEndpoints_ExactRequestBodies(t *testing.T) {
	want := map[string]string{
		"/admin/user/list":          `{"page_no":1,"page_size":20,"status":-1,"username_mobile_email":""}`,
		"/admin/role/list":          `{"page_no":1,"page_size":20,"role_name":"","status":-1}`,
		"/admin/permission/list":    `{"page_no":1,"page_size":20,"permission_name":"","permission_type":-1,"status":-1}`,
		"/admin/dept/list":          `{"dept_name":"","page_no":1,"page_size":20,"status":-1}`,
		"/admin/login-log/list":     `{"login_status":-1,"page_no":1,"page_size":20}`,
		"/admin/log/access/list":    `{"ip":"","method":"","page_no":1,"page_size":20,"path":"","status_code":0}`,
		"/admin/log/operation/list": `{"action":"","method":"","page_no":1,"page_size":20,"path":"","resource":""}`,
	}
	if len(want) != len(listEndpoints) {
		t.Fatalf("白名单有 %d 个接口，期望表有 %d 个", len(listEndpoints), len(want))
	}
	for _, ep := range listEndpoints {
		var gotPath, gotBody, gotType, gotCSRF string
		srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			data, _ := io.ReadAll(r.Body)
			gotPath, gotBody, gotType, gotCSRF = r.URL.Path, string(data), r.Header.Get("Content-Type"), r.Header.Get(csrfName)
			writeEnvelope(w, 200, nil)
		}))
		cfg, err := parseConfig([]string{"-scenario", "list", "-base-url", srv.URL, "-list-path", ep.Path, "-page-size", "20"}, testEnv, &bytes.Buffer{})
		if err != nil {
			t.Fatal(err)
		}
		jar := newJar()
		jar.SetCookies(cfg.BaseURL, []*http.Cookie{&http.Cookie{Name: csrfName, Value: "csrf-value"}})
		newClient(cfg, http.DefaultTransport, jar).list()
		srv.Close()
		if gotPath != ep.Path || gotBody != want[ep.Path] || gotType != "application/json" || gotCSRF != "csrf-value" {
			t.Errorf("%s 请求不对:\npath=%s type=%q csrf=%q\nbody=%s\nwant=%s", ep.Path, gotPath, gotType, gotCSRF, gotBody, want[ep.Path])
		}
	}
}

// -json 指向一个符号链接时，替换的是链接本身，不会顺着链接改写别的文件。
func TestJSONReport_DoesNotFollowSymlink(t *testing.T) {
	_, srv := newFakeBackend(t)
	dir := t.TempDir()
	victim := filepath.Join(dir, "victim.txt")
	link := filepath.Join(dir, "report.json")
	if err := os.WriteFile(victim, []byte("keep"), 0o644); err != nil {
		t.Fatal(err)
	}
	if err := os.Symlink(victim, link); err != nil {
		t.Fatal(err)
	}
	var stdout, stderr bytes.Buffer
	if code := run(context.Background(), []string{"-scenario", "login", "-base-url", srv.URL, "-duration", "100ms", "-concurrency", "1", "-json", link}, testEnv, &stdout, &stderr); code != exitOK {
		t.Fatalf("退出码 %d\n%s", code, stderr.String())
	}
	if data, _ := os.ReadFile(victim); string(data) != "keep" {
		t.Fatalf("符号链接指向的文件被改写了: %q", data)
	}
	info, err := os.Lstat(link)
	if err != nil || !info.Mode().IsRegular() || info.Mode().Perm() != 0o600 {
		t.Fatalf("报告应是权限 0600 的普通文件: %v %v", info.Mode(), err)
	}
	var rep report
	if data, _ := os.ReadFile(link); json.Unmarshal(data, &rep) != nil || rep.Total == 0 {
		t.Fatalf("报告内容不对: %s", data)
	}
	if entries, _ := os.ReadDir(dir); len(entries) != 2 {
		t.Fatalf("不应留下临时文件: %v", entries)
	}
}

